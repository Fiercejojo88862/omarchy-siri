[Unit]
Description=Ruby proactive watcher (calendar, docker, canvas, unlock briefs)
After=default.target network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/ruby_watcher.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
