# Cloud brain — copy to ~/.config/voice-assistant/cloud.conf (chmod 600)
#
# Optional. When enabled, open-ended questions (ones no local skill handles)
# are answered by a fast cloud model via any OpenAI-compatible API. On quota,
# rate-limit, or error she falls back to the local Ollama model.
#
# CLOUD_ENABLED: 0 = off (default), 1 = on
CLOUD_ENABLED=0

# BRAIN_BACKEND: cloud = OpenAI-compatible API below; opencode = local OpenCode agent
BRAIN_BACKEND=cloud

# CLOUD_PROVIDER: hint only (groq, cerebras, openrouter, openai, custom)
CLOUD_PROVIDER=groq

# CLOUD_API_KEY: your provider key. Keep this file chmod 600.
CLOUD_API_KEY=

# CLOUD_BASE_URL: OpenAI-compatible chat completions base URL.
# Groq:      https://api.groq.com/openai/v1
# Cerebras:  https://api.cerebras.ai/v1
# OpenRouter:https://openrouter.ai/api/v1
CLOUD_BASE_URL=https://api.groq.com/openai/v1

# CLOUD_MODEL: fast model name on your provider (e.g. llama-3.1-8b-instant)
CLOUD_MODEL=llama-3.1-8b-instant

# CLOUD_DAILY_CAP: max cloud requests per day (0 = unlimited). Default 50.
CLOUD_DAILY_CAP=50

# CLOUD_LIMIT_COOLDOWN: seconds before repeating the "reached your generation
# limit" message when over cap/rate-limited. Default 3600 (1 hour).
CLOUD_LIMIT_COOLDOWN=3600

# --- OpenCode local agent brain (BRAIN_BACKEND=opencode) ---------------------
# Runs `opencode run` non-interactively with the bundled `ruby` agent and its
# desktop-control, vision and memory skills. Falls back to local Ollama on error.
# Install OpenCode, then pick "OpenCode local agent" in Ruby Engine.
OPENCODE_BIN=opencode
# Agent to run: ruby (desktop assistant) or ruby-dev (edits files in OPENCODE_CWD)
OPENCODE_AGENT=ruby
# Optional model override (provider/model). Empty = OpenCode's default model.
OPENCODE_MODEL=
# Working directory for the agent (project discovery, relative paths).
OPENCODE_CWD=~/.local/share/voice-assistant/agent
# Seconds before the agent is cancelled. Keep under the router's 70s budget.
OPENCODE_TIMEOUT=60
# Auto-approve anything the agent's permission allowlist permits.
OPENCODE_AUTO=1
# Agent used when Ruby delegates coding work (ruby-dev edits in OPENCODE_CWD).
OPENCODE_DELEGATE_AGENT=ruby-dev
# Allow the SAFE agent's native shell tool. Off by default; denylisted, not
# sandboxed. ruby-shell has shell access without this switch.
ALLOW_SHELL=0
# Pass each CLI's "bypass all permissions/sandbox" flag to a delegated agent.
# Only for a throwaway workspace you already trust. Off by default.
DELEGATE_UNSAFE=0
