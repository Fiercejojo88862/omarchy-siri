# Ruby voice & timing — copy to ~/.config/voice-assistant/voice.conf (chmod 600)
# Applied on next speech/command. Env vars (VOICE_RATE etc.) override these.

# Piper voice model (.onnx). Default: southern English female.
VOICE_MODEL=~/.local/share/piper/en_GB-southern_english_female-low.onnx

# Piper length-scale: lower = faster, higher = slower (1.0 = model default).
RATE=1.0

# Piper noise-scale: higher = more expressive (default ~0.667).
ENERGY=0.8

# Rubberband pitch lift: higher = brighter, tempo untouched.
LIFT=1.05

# Seconds to keep recording after you press Insert to stop (avoid cut-off).
STOP_GRACE=0.3

# Seconds to wait before playing speech (avoid overlap/clipping).
SPEAK_DELAY=0.15

# Show "Heard: ..." notification after transcription (1 = yes, 0 = no).
SHOW_HEARD=1

# Optional custom phrase for "Test voice" / sample playback.
SAMPLE_TEXT=

# --- Speech recognition (whisper-cli) ---
# WHISPER_MODEL: path to ggml model. Empty = auto-detect best available
# (prefers large-v3-turbo > small.en > base.en for better accuracy).
WHISPER_MODEL=

# WHISPER_LANG: spoken language code (default: en).
WHISPER_LANG=en

# WHISPER_THREADS: CPU threads for transcription (default: 8 for PTT).
WHISPER_THREADS=8

# WHISPER_PROMPT: optional bias prompt (helps recognize names/commands).
WHISPER_PROMPT=

# WHISPER_EXTRA_ARGS: extra whisper-cli flags (advanced).
WHISPER_EXTRA_ARGS=
