#!/usr/bin/env bash
# local-voice — speedy push-to-talk toggle for INS (Hyprland 0.56+)
# Usage: local-voice toggle — press once to record, press again to send
#        local-voice start  — begins pw-record in background
#        local-voice stop   — stops, transcribes, dispatches
# Design: start is instant, stop forks transcribe+LLM+dispatch so Hyprland never blocks.
set -euo pipefail

# Runtime files live in the per-user tmpfs ($XDG_RUNTIME_DIR), not /tmp: the
# recording is private audio and must never be world-readable, and the whole
# directory is cleared at logout so nothing is left behind. umask 077 makes
# pw-record's WAV 0600 on creation; the chmod is belt-and-braces for the dir.
umask 077
RUN="${XDG_RUNTIME_DIR:-/tmp}/voice-assistant"
mkdir -p "$RUN"
chmod 700 "$RUN"

PIDFILE="$RUN/record.pid"
AUDIOFILE="$RUN/command.wav"
LOCK="$RUN/record.lock"
LOG="$RUN/voice.log"
VOICE_CONF="$HOME/.config/voice-assistant/voice.conf"

# Pick STT model: voice.conf WHISPER_MODEL, else best available.
MODEL=""
WHISPER_LANG="en"
WHISPER_THREADS="8"
WHISPER_PROMPT="Ruby, Hey Ruby. open close launch search weather calendar timer reminder volume brightness screenshot scroll click type workspace window Firefox Dolphin Kitty terminal browser."
WHISPER_EXTRA=""
if [[ -f "$VOICE_CONF" ]]; then
    _vcfg() { grep -E "^[[:space:]]*($1)[[:space:]]*=" "$VOICE_CONF" 2>/dev/null | tail -1 | cut -d= -f2- | sed 's/#.*//;s/^[[:space:]]*//;s/[[:space:]]*$//' || true; }
    cfg_model="$(_vcfg 'WHISPER_MODEL|STT_MODEL|VOICE_WHISPER_MODEL')"
    cfg_lang="$(_vcfg 'WHISPER_LANG|STT_LANG')"
    cfg_threads="$(_vcfg 'WHISPER_THREADS|STT_THREADS')"
    cfg_prompt="$(_vcfg 'WHISPER_PROMPT|STT_PROMPT')"
    cfg_extra="$(_vcfg 'WHISPER_EXTRA_ARGS|STT_EXTRA_ARGS')"
    [[ -n "${cfg_model:-}" ]] && MODEL="${cfg_model/#\~/$HOME}"
    [[ -n "${cfg_lang:-}" ]] && WHISPER_LANG="$cfg_lang"
    [[ -n "${cfg_threads:-}" ]] && WHISPER_THREADS="$cfg_threads"
    [[ -n "${cfg_prompt:-}" ]] && WHISPER_PROMPT="$cfg_prompt"
    [[ -n "${cfg_extra:-}" ]] && WHISPER_EXTRA="$cfg_extra"
fi
if [[ -z "$MODEL" || ! -f "$MODEL" ]]; then
    for cand in \
        "$HOME/.local/share/voxtype/models/ggml-large-v3-turbo.bin" \
        "$HOME/.local/share/whisper-models/ggml-large-v3-turbo.bin" \
        "$HOME/.local/share/whisper-models/ggml-small.en.bin" \
        "$HOME/.local/share/whisper-models/ggml-base.en.bin" \
        "$HOME/.local/share/voxtype/models/ggml-base.en.bin"; do
        [[ -f "$cand" ]] && MODEL="$cand" && break
    done
fi
[[ -z "$MODEL" ]] && MODEL="$HOME/.local/share/whisper-models/ggml-base.en.bin"
# NOTE: every backgrounded process below redirects stdin from /dev/null and
# stdout/stderr to $LOG. Hyprland's exec_cmd waits for the dispatched child's
# pipes; a background child inheriting them keeps the dispatch "running" and
# serialises later keybindings behind it — which presented as "release does
# nothing until I press again". Detached fds let each dispatch return at once.

cmd="${1:-}"

# Ensure deps
need() { command -v "$1" >/dev/null 2>&1 || { notify-send -t 2500 "Voice" "$1 not installed"; exit 1; }; }

start_recording() {
    need pw-record
    # if already recording, ignore repeat press
    if [[ -f "$PIDFILE" ]]; then
        pid=$(cat "$PIDFILE" 2>/dev/null || true)
        if [[ "$pid" == "pending" ]] || { [[ -n "${pid:-}" ]] && kill -0 "$pid" 2>/dev/null; }; then
            exit 0
        else
            rm -f "$PIDFILE"
        fi
    fi
    # exclusive lock to avoid race with stop
    exec 9>"$LOCK" 2>/dev/null || true
    flock -n 9 || exit 0

    # Claim mic early so wake-word listener yields immediately.
    echo "pending" > "$PIDFILE"
    rm -f "$AUDIOFILE"
    # Signal listening state for top bar indicator (state machine: listening).
    printf '%s' "listening" > "$RUN/ruby_state" 2>/dev/null || true
    RUBY_IMG=""
    for p in \
        "$HOME/omarchy-siri/assets/ruby-assistant.png" \
        "$HOME/omarchy-siri/assets/ruby-assistant.jpg" \
        "$HOME/Documents/omarchy-siri-archive/Ruby Photos/Ruby AI Assistant.png" \
        "$HOME/Documents/omarchy-siri-archive/Ruby Photos/Ruby AI Assistant.jpg"; do
        [[ -f "$p" ]] && RUBY_IMG="$p" && break
    done
    if command -v omarchy-notification-send >/dev/null 2>&1 && [[ -n "$RUBY_IMG" ]]; then
        omarchy-notification-send -u low -t 1200 --image "$RUBY_IMG" "Ruby" "Listening..." 2>/dev/null || true
    elif [[ -n "$RUBY_IMG" ]]; then
        notify-send -t 1200 -i "$RUBY_IMG" "Ruby" "Listening..." 2>/dev/null || true
    else
        notify-send -t 1200 "Ruby" "Listening..." 2>/dev/null || true
    fi
    # 16k mono is what base.en expects; wav file. Detached fds ($LOG, /dev/null)
    # so the press dispatch returns at once — see NOTE above. Plain & keeps
    # $! accurate for PIDFILE (no setsid wrapper in between).
    pw-record --rate=16000 --channels=1 "$AUDIOFILE" </dev/null >>"$LOG" 2>&1 &
    recpid=$!
    echo "$recpid" > "$PIDFILE"
    disown 2>/dev/null || true
    # Give the audio pipeline a moment to start so the first word isn't missed.
    sleep 0.12 2>/dev/null || true
}

stop_recording() {
    need whisper-cli
    if [[ ! -f "$PIDFILE" ]]; then
        exit 0
    fi
    pid=$(cat "$PIDFILE" 2>/dev/null || true)
    rm -f "$PIDFILE"
    # Listening ended; processing now (state machine: thinking).
    printf '%s' "thinking" > "$RUN/ruby_state" 2>/dev/null || true
    # Grace period: let pw-record capture the tail end of speech so the last
    # word/syllable isn't cut off when you press Insert while finishing a sentence.
    # Configurable via voice.conf or VOICE_STOP_GRACE env; default 0.3s.
    grace="0.3"
    VOICE_CONF="$HOME/.config/voice-assistant/voice.conf"
    if [[ -f "$VOICE_CONF" ]]; then
        cfg_grace=$(grep -E '^[[:space:]]*(STOP_GRACE|VOICE_STOP_GRACE)[[:space:]]*=' "$VOICE_CONF" 2>/dev/null | tail -1 | cut -d= -f2- | sed 's/#.*//;s/^[[:space:]]*//;s/[[:space:]]*$//')
        [[ -n "${cfg_grace:-}" ]] && grace="$cfg_grace"
    fi
    grace="${VOICE_STOP_GRACE:-$grace}"
    if [[ -n "${pid:-}" ]] && kill -0 "$pid" 2>/dev/null; then
        sleep "$grace" 2>/dev/null || sleep 0.4
    fi
    if [[ -n "${pid:-}" ]]; then
        kill "$pid" 2>/dev/null || true
        # give pw-record time to flush wav header
        for _ in 1 2 3 4 5; do kill -0 "$pid" 2>/dev/null || break; sleep 0.05; done
        # ensure file exists and has data (> 1KB)
        if [[ ! -f "$AUDIOFILE" ]] || [[ $(stat -c%s "$AUDIOFILE" 2>/dev/null || echo 0) -lt 1500 ]]; then
            printf '%s' "idle" > "$RUN/ruby_state" 2>/dev/null || true
            notify-send -t 1200 "Ruby" "Too short" 2>/dev/null || true
            rm -f "$AUDIOFILE"
            exit 0
        fi
    fi
    # Fork the heavy work so key release is instant. Fully detached fds (NOTE
    # above) so the release dispatch returns at once instead of being held
    # open by whisper/ollama inheriting Hyprland's pipes.
    (
        # whisper hygiene: collapse newlines, trim, drop trailing punctuation
        # and common hallucination tokens so routing sees clean commands.
        wargs=(-m "$MODEL" -f "$AUDIOFILE" -t "$WHISPER_THREADS" -l "$WHISPER_LANG" --no-timestamps -nt -sns)
        [[ -n "${WHISPER_PROMPT:-}" ]] && wargs+=(--prompt "$WHISPER_PROMPT")
        if [[ -n "${WHISPER_EXTRA:-}" ]]; then
            # shellcheck disable=SC2206
            extra_arr=($WHISPER_EXTRA)
            wargs+=("${extra_arr[@]}")
        fi
        TEXT=$(whisper-cli "${wargs[@]}" 2>/dev/null \
            | tr '\n' ' ' \
            | sed -E 's/\[[^]]*\]//g; s/\([^)]*\)//g; s/^[[:space:]]*//; s/[[:space:]]*$//; s/[.?!,;:]+$//' \
            | tr -s ' ')
        rm -f "$AUDIOFILE"
        TEXT=$(printf '%s' "$TEXT" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')
        lc_text="$(printf '%s' "$TEXT" | tr '[:upper:]' '[:lower:]')"
        case "$lc_text" in
            ""|"thanks for watching"*|"subtitles by"*|"thank you for watching"*|"please subscribe"*|"[music]"|"[silence]"|"[blank_audio]"|"(music)"|"(silence)")
                # Common whisper hallucinations on near-silence/noise.
                TEXT=""
                ;;
        esac
        # Strip residual bracketed/parenthesized tokens that may remain.
        TEXT=$(printf '%s' "$TEXT" | sed -E 's/\[[^]]*\]//g; s/\([^)]*\)//g; s/^[[:space:]]+//; s/[[:space:]]+$//; s/[.?!,;:]+$//' | tr -s ' ')
        if [[ -z "$TEXT" ]]; then
            # No speech heard — music may be playing instead. Fall through to
            # Shazam automatically (records its own fresh sample in exec).
            printf '%s' "idle" > "$RUN/ruby_state" 2>/dev/null || true
            notify-send -t 1500 "Ruby" "No speech — listening for music..." 2>/dev/null || true
            exec ~/.local/bin/local-voice-exec "shazam this"
        fi
        # Show what was heard for quick feedback/debugging, then dispatch.
        SHOW_HEARD="1"
        if [[ -f "$VOICE_CONF" ]]; then
            cfg_show=$(grep -E '^[[:space:]]*SHOW_HEARD[[:space:]]*=' "$VOICE_CONF" 2>/dev/null | tail -1 | cut -d= -f2- | sed 's/#.*//;s/^[[:space:]]*//;s/[[:space:]]*$//') || true
            [[ -n "${cfg_show:-}" ]] && SHOW_HEARD="$cfg_show"
        fi
        if [[ "$SHOW_HEARD" != "0" && "$SHOW_HEARD" != "false" && "$SHOW_HEARD" != "no" && "$SHOW_HEARD" != "off" ]]; then
            notify-send -t 1200 "Ruby" "Heard: $TEXT" 2>/dev/null || true
        fi
        exec ~/.local/bin/local-voice-exec "$TEXT"
    ) </dev/null >>"$LOG" 2>&1 &
    disown 2>/dev/null || true
}

case "$cmd" in
    start) start_recording ;;
    stop)  stop_recording ;;
    toggle)
        # Press to talk, press again to send. PIDFILE presence = recording.
        if [[ -f "$PIDFILE" ]]; then
            pid=$(cat "$PIDFILE" 2>/dev/null || true)
            if [[ -n "${pid:-}" ]] && kill -0 "$pid" 2>/dev/null; then
                stop_recording
            else
                rm -f "$PIDFILE"
                start_recording
            fi
        else
            start_recording
        fi
        ;;
    *) echo "usage: $0 {start|stop|toggle}" >&2; exit 1 ;;
esac
