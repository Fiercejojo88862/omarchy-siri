#!/usr/bin/env python3
"""Generate one utterance in YOUR Siri voice (XTTS-v2, recipe D).
Usage: local-voice-clone "<text>" <reference.wav> <output.wav>
Recipe D: temperature 0.5 (stable, no rasp/warble), native speed 1.0
(speed-ups thin the voice and age it), transparent 48k master.
Reference must be the DENOISED siri_ref_25s.wav (orig kept as .orig.wav).
"""
import os
import subprocess
import sys

os.environ["COQUI_TOS_AGREED"] = "1"

text, ref, out = sys.argv[1], sys.argv[2], sys.argv[3]

import numpy as np
import soundfile as sf
import torch

from TTS.api import TTS

tts = TTS("tts_models/multilingual/multi-dataset/xtts_v2", gpu=False)
model = tts.synthesizer.tts_model
gpt_latent, spk_emb = model.get_conditioning_latents(audio_path=[ref])
with torch.no_grad():
    result = model.inference(text, "en", gpt_latent, spk_emb,
                             temperature=0.5, speed=1.0,
                             top_k=50, top_p=0.85)
wav = result["wav"]
if isinstance(wav, np.ndarray):
    wav = torch.from_numpy(wav)
else:
    wav = wav.cpu()
if wav.dim() == 1:
    wav = wav.unsqueeze(0)

raw = out + ".raw.wav"
sf.write(raw, wav.numpy().T, 24000, subtype="PCM_16")
subprocess.run(
    ["ffmpeg", "-v", "error", "-y", "-i", raw, "-af",
     "volume=0.89,aresample=48000:resampler=soxr:precision=28:cheby=1,"
     "highpass=f=70,equalizer=f=150:width_type=o:width=1:gain=1.5,"
     "loudnorm=I=-16:TP=-1.5:LRA=7",
     "-ar", "48000", "-ac", "2", "-c:a", "pcm_s24le", out],
    check=True)
os.remove(raw)
