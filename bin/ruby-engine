#!/usr/bin/env python3
"""Ruby Engine — native settings and control app for Ruby on Omarchy.

Customize Ruby's voice, persona, wake word ("Hey Ruby"), cloud brain, and more.
Reads/writes the same config files as the voice assistant.
"""

import glob
import json
import os
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk, Pango  # noqa: E402

APP_ID = "com.omarchy.ruby-engine"
CONF_DIR = Path.home() / ".config/voice-assistant"
STATE_DIR = Path.home() / ".local/state/voice-assistant"
BIN_DIR = Path.home() / ".local/bin"
PIPER_DIR = Path.home() / ".local/share/piper"
AUTOSTART_DIR = Path.home() / ".config/autostart"
WAKE_AUTOSTART = AUTOSTART_DIR / "ruby-wake.desktop"


def ensure_conf_dir():
    CONF_DIR.mkdir(parents=True, exist_ok=True)


def read_kv(path: Path) -> dict:
    data = {}
    try:
        for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, _, v = line.partition("=")
            data[k.strip()] = v.strip()
    except OSError:
        pass
    return data


def read_conf(name: str) -> dict:
    return read_kv(CONF_DIR / name)


def write_conf(name: str, updates: dict, template: Path | None = None):
    ensure_conf_dir()
    path = CONF_DIR / name
    lines = []
    if path.exists():
        try:
            lines = path.read_text(encoding="utf-8", errors="replace").splitlines(keepends=True)
        except OSError:
            lines = []
    elif template and template.exists():
        try:
            lines = template.read_text(encoding="utf-8", errors="replace").splitlines(keepends=True)
        except OSError:
            lines = []

    seen = set()
    new_lines = []
    for line in lines:
        stripped = line.strip()
        if stripped and not stripped.startswith("#") and "=" in stripped:
            k = stripped.split("=", 1)[0].strip()
            if k in updates:
                new_lines.append(f"{k}={updates[k]}\n")
                seen.add(k)
                continue
        new_lines.append(line if line.endswith("\n") else line + "\n")

    for k, v in updates.items():
        if k not in seen:
            if new_lines and not new_lines[-1].endswith("\n"):
                new_lines[-1] += "\n"
            new_lines.append(f"{k}={v}\n")

    try:
        path.write_text("".join(new_lines), encoding="utf-8")
        os.chmod(path, 0o600)
    except OSError:
        pass


def list_piper_voices():
    voices = []
    if PIPER_DIR.is_dir():
        for onnx in sorted(PIPER_DIR.glob("*.onnx")):
            voices.append(str(onnx))
    for pat in ["/usr/share/piper/voices/*.onnx", "/usr/local/share/piper/*.onnx"]:
        for onnx in sorted(glob.glob(pat)):
            if onnx not in voices:
                voices.append(onnx)
    return voices


def voice_display_name(path: str) -> str:
    name = Path(path).stem
    return name.replace("_", " ").replace("-", " ")


def run_cmd(argv, **kw):
    try:
        return subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL, **kw)
    except Exception:
        return None


def run_capture(argv):
    try:
        r = subprocess.run(argv, capture_output=True, text=True, timeout=8)
        return (r.stdout or "").strip()
    except Exception:
        return ""


def ruby_image_path():
    here = Path(__file__).resolve().parent.parent
    candidates = [
        here / "assets" / "ruby-assistant.png",
        here / "assets" / "ruby-assistant.jpg",
        Path.home() / "Documents/omarchy-siri-archive/Ruby Photos/Ruby AI Assistant.png",
        Path.home() / "Documents/omarchy-siri-archive/Ruby Photos/Ruby AI Assistant.jpg",
        here / "assets" / "ruby-icon.jpg",
    ]
    for p in candidates:
        if p.exists():
            return str(p)
    return ""


class RubyEngineWindow(Adw.ApplicationWindow):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.set_title("Ruby Engine")
        self.set_default_size(980, 760)

        self.toast_overlay = Adw.ToastOverlay()
        self.set_content(self.toast_overlay)

        toolbar_view = Adw.ToolbarView()
        self.toast_overlay.set_child(toolbar_view)

        header = Adw.HeaderBar()
        self.title_widget = Adw.WindowTitle(title="Ruby Engine", subtitle="Ruby on Omarchy")
        header.set_title_widget(self.title_widget)

        test_btn = Gtk.Button(icon_name="audio-volume-high-symbolic", tooltip_text="Test voice")
        test_btn.add_css_class("flat")
        test_btn.connect("clicked", self.on_test_voice)
        header.pack_end(test_btn)

        toolbar_view.add_top_bar(header)

        self.stack = Adw.ViewStack()
        toolbar_view.set_content(self.stack)

        view_switcher = Adw.ViewSwitcher()
        view_switcher.set_stack(self.stack)
        view_switcher.set_policy(Adw.ViewSwitcherPolicy.WIDE)
        header.set_title_widget(view_switcher)

        self._voice_paths = []
        self.build_overview_page()
        self.build_voice_page()
        self.build_persona_page()
        self.build_wake_page()
        self.build_cloud_page()

        self.load_all()

    def toast(self, msg):
        self.toast_overlay.add_toast(Adw.Toast(title=msg, timeout=3))

    def page_scroller(self, child):
        sc = Gtk.ScrolledWindow(vexpand=True)
        sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        clamp = Adw.Clamp(maximum_size=820, tightening_threshold=640)
        clamp.set_margin_top(24)
        clamp.set_margin_bottom(24)
        clamp.set_margin_start(16)
        clamp.set_margin_end(16)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=20)
        box.append(child)
        clamp.set_child(box)
        sc.set_child(clamp)
        return sc

    def make_avatar(self, size=140):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, halign=Gtk.Align.CENTER)
        img_path = ruby_image_path()
        if img_path:
            try:
                texture = Gdk.Texture.new_from_filename(img_path)
                pic = Gtk.Picture.new_for_paintable(texture)
                pic.set_size_request(size, size)
                pic.set_content_fit(Gtk.ContentFit.COVER)
                pic.set_can_shrink(True)
                pic.add_css_class("card")
                frame = Gtk.Frame()
                frame.set_child(pic)
                frame.set_halign(Gtk.Align.CENTER)
                box.append(frame)
                return box
            except Exception:
                pass
        icon = Gtk.Image.new_from_icon_name("audio-input-microphone-symbolic")
        icon.set_pixel_size(size)
        box.append(icon)
        return box

