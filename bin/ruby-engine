    # ---------- load/save ----------
    def load_all(self):
        # voices
        self._voice_paths = list_piper_voices()
        while self.voice_model_store.get_n_items() > 0:
            self.voice_model_store.remove(0)
        for p in self._voice_paths:
            self.voice_model_store.append(voice_display_name(p))

        v = read_conf("voice.conf")
        model = os.path.expanduser(v.get("VOICE_MODEL", v.get("MODEL", "")) or "")
        if not model and self._voice_paths:
            model = self._voice_paths[0]
        idx = 0
        for i, p in enumerate(self._voice_paths):
            if p == model or Path(p).name == Path(model).name:
                idx = i
                break
        if self._voice_paths:
            self.voice_model_row.set_selected(idx)
        try:
            self.rate_row.set_value(float(v.get("RATE", v.get("VOICE_RATE", "1.0"))))
        except Exception:
            self.rate_row.set_value(1.0)
        try:
            self.energy_row.set_value(float(v.get("ENERGY", v.get("VOICE_ENERGY", "0.8"))))
        except Exception:
            self.energy_row.set_value(0.8)
        try:
            self.lift_row.set_value(float(v.get("LIFT", v.get("VOICE_LIFT", "1.05"))))
        except Exception:
            self.lift_row.set_value(1.05)
        try:
            self.stop_grace_row.set_value(float(v.get("STOP_GRACE", v.get("VOICE_STOP_GRACE", "0.3"))))
        except Exception:
            self.stop_grace_row.set_value(0.3)
        try:
            self.speak_delay_row.set_value(float(v.get("SPEAK_DELAY", v.get("VOICE_SPEAK_DELAY", "0.15"))))
        except Exception:
            self.speak_delay_row.set_value(0.15)
        self.show_heard_row.set_active(v.get("SHOW_HEARD", "1").lower() not in ("0", "false", "no", "off"))
        self.sample_text_row.set_text(v.get("SAMPLE_TEXT", "") or "I'm Ruby, your voice assistant on Omarchy. How can I help?")

        p = read_conf("persona.conf")
        name = p.get("ASSISTANT_NAME", "Ruby") or "Ruby"
        self.name_entry.set_text(name)
        self.honorifics_entry.set_text(p.get("HONORIFICS", "Sir") or "Sir")
        try:
            self.idle_row.set_value(float(p.get("HONORIFIC_IDLE_SECONDS", "180")))
        except Exception:
            self.idle_row.set_value(180)
        self.errors_row.set_active(p.get("HONORIFIC_ON_ERRORS", "1").lower() not in ("0", "false", "no", "off"))
        aff = (p.get("AFFECTION", "friendly") or "friendly").lower()
        aff = "loving" if aff == "devoted" else aff
        aff_map = {"none": 0, "friendly": 1, "warm": 2, "loving": 3}
        self.affection_row.set_selected(aff_map.get(aff, 1))
        self.likes_entry.set_text(p.get("LIKES", "") or "")
        self.dislikes_entry.set_text(p.get("DISLIKES", "") or "")
        self.extra_row.set_text(p.get("PERSONALITY_NOTES", p.get("EXTRA_INSTRUCTIONS", "")) or "")
        self.hero_title.set_label(name)
        self.title_widget.set_subtitle(f"{name} on Omarchy")

        c = read_conf("cloud.conf")
        self.cloud_enabled.set_active(c.get("CLOUD_ENABLED", "0").lower() in ("1", "true", "yes", "on"))
        self.cloud_key.set_text(c.get("CLOUD_API_KEY", "") or "")
        self.cloud_url.set_text(c.get("CLOUD_BASE_URL", "https://api.groq.com/openai/v1") or "https://api.groq.com/openai/v1")
        self.cloud_model.set_text(c.get("CLOUD_MODEL", "llama-3.1-8b-instant") or "llama-3.1-8b-instant")
        try:
            self.cloud_cap.set_value(float(c.get("CLOUD_DAILY_CAP", "50")))
        except Exception:
            self.cloud_cap.set_value(50)
        try:
            self.cloud_cooldown.set_value(float(c.get("CLOUD_LIMIT_COOLDOWN", "3600")))
        except Exception:
            self.cloud_cooldown.set_value(3600)

        w = read_conf("wake.conf")
        self.wake_phrases_row.set_text(w.get("WAKE_PHRASES", "") or "")
        try:
            self.wake_cmd_row.set_value(float(w.get("WAKE_COMMAND_SECONDS", "6")))
        except Exception:
            self.wake_cmd_row.set_value(6)
        try:
            self.wake_chunk_row.set_value(float(w.get("WAKE_CHUNK_SECONDS", "2.5")))
        except Exception:
            self.wake_chunk_row.set_value(2.5)
        self.wake_sound_row.set_active(w.get("WAKE_SOUND", "1").lower() in ("1", "true", "yes", "on"))
        self.barge_in_row.set_active(w.get("BARGE_IN", "0").lower() in ("1", "true", "yes", "on"))
        self.wake_autostart_row.set_active(w.get("WAKE_AUTOSTART", "0").lower() in ("1", "true", "yes", "on") or WAKE_AUTOSTART.exists())

        self.refresh_usage()
        self.refresh_wake_status()

    def refresh_usage(self):
        usage_path = STATE_DIR / "cloud_usage.json"
        count = 0
        try:
            data = json.loads(usage_path.read_text())
            import datetime
            today = datetime.datetime.now().strftime("%Y-%m-%d")
            if data.get("date") == today:
                count = int(data.get("count", 0))
        except Exception:
            count = 0
        c = read_conf("cloud.conf")
        cap = c.get("CLOUD_DAILY_CAP", "50") or "50"
        on = c.get("CLOUD_ENABLED", "0").lower() in ("1", "true", "yes", "on") and bool(c.get("CLOUD_API_KEY"))
        self.usage_label.set_label(f"{count} / {cap}")
        self.usage_row.set_subtitle("Cloud on" if on else "Cloud off (local answers)")
        self.overview_cloud_status.set_label("On" if on else "Off")

    def wake_running(self):
        return run_capture([str(BIN_DIR / "local-voice-wake"), "status"]) == "running"

    def refresh_wake_status(self, *_):
        running = self.wake_running()
        label = "Running" if running else "Stopped"
        self.wake_status_label.set_label(label)
        self.overview_wake_status.set_label("On" if running else "Off")
        self.wake_start_btn.set_sensitive(not running)
        self.wake_stop_btn.set_sensitive(running)
        return True

    def set_wake_running(self, start: bool):
        cmd = "start" if start else "stop"
        run_capture([str(BIN_DIR / "local-voice-wake"), cmd])
        GLib.timeout_add(400, self.refresh_wake_status)

    def on_toggle_wake(self, *_):
        self.set_wake_running(not self.wake_running())

    def update_wake_autostart(self, enabled: bool):
        try:
            AUTOSTART_DIR.mkdir(parents=True, exist_ok=True)
            if enabled:
                WAKE_AUTOSTART.write_text(
                    "[Desktop Entry]\nType=Application\nName=Ruby Wake Word\n"
                    "Comment=Start Ruby wake-word listener (Hey Ruby)\n"
                    "Exec=local-voice-wake start\nX-GNOME-Autostart-enabled=true\n"
                )
            else:
                if WAKE_AUTOSTART.exists():
                    WAKE_AUTOSTART.unlink()
        except OSError:
            pass

    def on_save_voice(self, *_):
        model = ""
        if self._voice_paths:
            idx = self.voice_model_row.get_selected()
            if 0 <= idx < len(self._voice_paths):
                model = self._voice_paths[idx]
        updates = {
            "VOICE_MODEL": model or "~/.local/share/piper/en_GB-southern_english_female-low.onnx",
            "RATE": f"{self.rate_row.get_value():.2f}".rstrip('0').rstrip('.'),
            "ENERGY": f"{self.energy_row.get_value():.2f}".rstrip('0').rstrip('.'),
            "LIFT": f"{self.lift_row.get_value():.2f}".rstrip('0').rstrip('.'),
            "STOP_GRACE": f"{self.stop_grace_row.get_value():.2f}".rstrip('0').rstrip('.'),
            "SPEAK_DELAY": f"{self.speak_delay_row.get_value():.2f}".rstrip('0').rstrip('.'),
            "SHOW_HEARD": "1" if self.show_heard_row.get_active() else "0",
            "SAMPLE_TEXT": self.sample_text_row.get_text().strip(),
        }
        write_conf("voice.conf", updates)
        self.toast("Voice settings saved")

    def on_save_persona(self, *_):
        affs = ["none", "friendly", "warm", "loving"]
        aff = affs[self.affection_row.get_selected()] if self.affection_row.get_selected() < len(affs) else "friendly"
        name = self.name_entry.get_text().strip() or "Ruby"
        updates = {
            "ASSISTANT_NAME": name,
            "HONORIFICS": self.honorifics_entry.get_text().strip() or "Sir",
            "HONORIFIC_IDLE_SECONDS": str(int(self.idle_row.get_value())),
            "HONORIFIC_ON_ERRORS": "1" if self.errors_row.get_active() else "0",
            "AFFECTION": aff,
            "LIKES": self.likes_entry.get_text().strip(),
            "DISLIKES": self.dislikes_entry.get_text().strip(),
            "PERSONALITY_NOTES": self.extra_row.get_text().strip(),
        }
        write_conf("persona.conf", updates)
        self.hero_title.set_label(name)
        self.title_widget.set_subtitle(f"{name} on Omarchy")
        self.toast("Persona & personality saved")

    def on_save_wake(self, *_):
        enabled = self.wake_autostart_row.get_active()
        updates = {
            "WAKE_AUTOSTART": "1" if enabled else "0",
            "WAKE_PHRASES": self.wake_phrases_row.get_text().strip(),
            "WAKE_COMMAND_SECONDS": f"{self.wake_cmd_row.get_value():.1f}".rstrip('0').rstrip('.'),
            "WAKE_CHUNK_SECONDS": f"{self.wake_chunk_row.get_value():.1f}".rstrip('0').rstrip('.'),
            "WAKE_SOUND": "1" if self.wake_sound_row.get_active() else "0",
            "BARGE_IN": "1" if self.barge_in_row.get_active() else "0",
        }
        write_conf("wake.conf", updates)
        self.update_wake_autostart(enabled)
        self.refresh_wake_status()
        self.toast("Wake word settings saved")

    def on_setup_aec(self, *_):
        # Best-effort PipeWire echo cancellation setup for barge-in.
        script = BIN_DIR / "ruby-aec-setup"
        if not script.exists():
            script = Path.home() / "omarchy-siri" / "bin" / "ruby-aec-setup"
        try:
            subprocess.Popen([str(script), "apply"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            self.toast("AEC setup requested (see script output/config if needed)")
        except Exception:
            self.toast("Could not run AEC setup script")

    def on_save_cloud(self, *_):
        updates = {
            "CLOUD_ENABLED": "1" if self.cloud_enabled.get_active() else "0",
            "CLOUD_API_KEY": self.cloud_key.get_text().strip(),
            "CLOUD_BASE_URL": self.cloud_url.get_text().strip() or "https://api.groq.com/openai/v1",
            "CLOUD_MODEL": self.cloud_model.get_text().strip() or "llama-3.1-8b-instant",
            "CLOUD_DAILY_CAP": str(int(self.cloud_cap.get_value())),
            "CLOUD_LIMIT_COOLDOWN": str(int(self.cloud_cooldown.get_value())),
        }
        write_conf("cloud.conf", updates)
        self.refresh_usage()
        self.toast("Cloud settings saved")

    def on_test_voice(self, *_):
        self.on_save_voice()
        name = self.name_entry.get_text().strip() or "Ruby"
        affs = ["none", "friendly", "warm", "loving"]
        aff = affs[self.affection_row.get_selected()] if self.affection_row.get_selected() < len(affs) else "friendly"
        sample = self.sample_text_row.get_text().strip()
        if not sample:
            if aff == "loving":
                sample = f"I'm {name}. I love being here with you. How can I help?"
            elif aff == "warm":
                sample = f"I'm {name}. It's good to hear from you. How can I help?"
            else:
                sample = f"I'm {name}, your voice assistant on Omarchy. How can I help?"
        say = BIN_DIR / "local-voice-say"
        if say.exists():
            run_cmd([str(say), sample])
            self.toast("Playing sample…")
        else:
            self.toast("local-voice-say not found")


class RubyEngineApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)

    def do_activate(self):
        win = self.props.active_window
        if not win:
            win = RubyEngineWindow(application=self)
        win.present()


def main():
    app = RubyEngineApp()
    return app.run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
