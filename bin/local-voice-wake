#!/usr/bin/env bash
# local-voice-wake — simple wake-word listener for Ruby ("Hey Ruby").
# Opt-in background mode: listens for the assistant name, then captures and
# runs a command through local-voice-exec. Uses whisper-cli on short chunks
# (no extra wake-word engine required).
#
# Usage: local-voice-wake start|stop|toggle|status|run
set -euo pipefail

umask 077
RUN="${XDG_RUNTIME_DIR:-/tmp}/voice-assistant"
mkdir -p "$RUN"
chmod 700 "$RUN"

PIDFILE="$RUN/wake.pid"
STOPFILE="$RUN/wake.stop"
LOG="$RUN/wake.log"
CHUNK="$RUN/wake_chunk.wav"
CMDWAV="$RUN/wake_cmd.wav"
PTT_PID="$RUN/record.pid"
VOICE_CONF="$HOME/.config/voice-assistant/voice.conf"

ASSISTANT_NAME="Ruby"
WAKE_PHRASES=""
WAKE_COMMAND_SECONDS="6"
WAKE_CHUNK_SECONDS="2.5"
WAKE_WHISPER_MODEL=""
WAKE_SOUND="1"
BARGE_IN="0"
WHISPER_MODEL=""
WHISPER_LANG="en"
WHISPER_THREADS="4"
WHISPER_PROMPT="Ruby, Hey Ruby. open close launch search weather calendar timer reminder volume brightness screenshot scroll click type workspace window."
if [[ -f "$HOME/.config/voice-assistant/persona.conf" ]]; then
    cfg_name=$(grep -E '^[[:space:]]*ASSISTANT_NAME[[:space:]]*=' "$HOME/.config/voice-assistant/persona.conf" 2>/dev/null | tail -1 | cut -d= -f2- | sed 's/#.*//;s/^[[:space:]]*//;s/[[:space:]]*$//') || true
    [[ -n "${cfg_name:-}" ]] && ASSISTANT_NAME="$cfg_name"
fi
if [[ -f "$VOICE_CONF" ]]; then
    _vcfg() { grep -E "^[[:space:]]*($1)[[:space:]]*=" "$VOICE_CONF" 2>/dev/null | tail -1 | cut -d= -f2- | sed 's/#.*//;s/^[[:space:]]*//;s/[[:space:]]*$//' || true; }
    cfg_model="$(_vcfg 'WHISPER_MODEL|STT_MODEL|VOICE_WHISPER_MODEL')"
    cfg_lang="$(_vcfg 'WHISPER_LANG|STT_LANG')"
    cfg_threads="$(_vcfg 'WHISPER_THREADS|STT_THREADS')"
    cfg_prompt="$(_vcfg 'WHISPER_PROMPT|STT_PROMPT')"
    [[ -n "${cfg_model:-}" ]] && WHISPER_MODEL="${cfg_model/#\~/$HOME}"
    [[ -n "${cfg_lang:-}" ]] && WHISPER_LANG="$cfg_lang"
    [[ -n "${cfg_threads:-}" ]] && WHISPER_THREADS="$cfg_threads"
    [[ -n "${cfg_prompt:-}" ]] && WHISPER_PROMPT="$cfg_prompt"
fi
if [[ -f "$HOME/.config/voice-assistant/wake.conf" ]]; then
    cfg_phrases=$(grep -E '^[[:space:]]*WAKE_PHRASES[[:space:]]*=' "$HOME/.config/voice-assistant/wake.conf" 2>/dev/null | tail -1 | cut -d= -f2- | sed 's/#.*//;s/^[[:space:]]*//;s/[[:space:]]*$//') || true
    cfg_cmd=$(grep -E '^[[:space:]]*WAKE_COMMAND_SECONDS[[:space:]]*=' "$HOME/.config/voice-assistant/wake.conf" 2>/dev/null | tail -1 | cut -d= -f2- | sed 's/#.*//;s/^[[:space:]]*//;s/[[:space:]]*$//') || true
    cfg_chunk=$(grep -E '^[[:space:]]*WAKE_CHUNK_SECONDS[[:space:]]*=' "$HOME/.config/voice-assistant/wake.conf" 2>/dev/null | tail -1 | cut -d= -f2- | sed 's/#.*//;s/^[[:space:]]*//;s/[[:space:]]*$//') || true
    cfg_wmodel=$(grep -E '^[[:space:]]*(WAKE_WHISPER_MODEL|WHISPER_MODEL)[[:space:]]*=' "$HOME/.config/voice-assistant/wake.conf" 2>/dev/null | tail -1 | cut -d= -f2- | sed 's/#.*//;s/^[[:space:]]*//;s/[[:space:]]*$//') || true
    cfg_wsound=$(grep -E '^[[:space:]]*WAKE_SOUND[[:space:]]*=' "$HOME/.config/voice-assistant/wake.conf" 2>/dev/null | tail -1 | cut -d= -f2- | sed 's/#.*//;s/^[[:space:]]*//;s/[[:space:]]*$//') || true
    cfg_barge=$(grep -E '^[[:space:]]*BARGE_IN[[:space:]]*=' "$HOME/.config/voice-assistant/wake.conf" 2>/dev/null | tail -1 | cut -d= -f2- | sed 's/#.*//;s/^[[:space:]]*//;s/[[:space:]]*$//') || true
    [[ -n "${cfg_phrases:-}" ]] && WAKE_PHRASES="$cfg_phrases"
    [[ -n "${cfg_cmd:-}" ]] && WAKE_COMMAND_SECONDS="$cfg_cmd"
    [[ -n "${cfg_chunk:-}" ]] && WAKE_CHUNK_SECONDS="$cfg_chunk"
    [[ -n "${cfg_wmodel:-}" ]] && WAKE_WHISPER_MODEL="${cfg_wmodel/#\~/$HOME}"
    [[ -n "${cfg_wsound:-}" ]] && WAKE_SOUND="$cfg_wsound"
    [[ -n "${cfg_barge:-}" ]] && BARGE_IN="$cfg_barge"
fi

pick_fast_model() {
    for cand in \
        "$HOME/.local/share/whisper-models/ggml-small.en.bin" \
        "$HOME/.local/share/whisper-models/ggml-base.en.bin" \
        "$HOME/.local/share/voxtype/models/ggml-base.en.bin" \
        "$HOME/.local/share/voxtype/models/ggml-large-v3-turbo.bin"; do
        [[ -f "$cand" ]] && echo "$cand" && return 0
    done
    echo "$HOME/.local/share/whisper-models/ggml-base.en.bin"
}

pick_best_model() {
    for cand in \
        "$HOME/.local/share/voxtype/models/ggml-large-v3-turbo.bin" \
        "$HOME/.local/share/whisper-models/ggml-large-v3-turbo.bin" \
        "$HOME/.local/share/whisper-models/ggml-small.en.bin" \
        "$HOME/.local/share/whisper-models/ggml-base.en.bin" \
        "$HOME/.local/share/voxtype/models/ggml-base.en.bin"; do
        [[ -f "$cand" ]] && echo "$cand" && return 0
    done
    echo "$HOME/.local/share/whisper-models/ggml-base.en.bin"
}

MODEL="$WAKE_WHISPER_MODEL"
[[ -z "$MODEL" || ! -f "$MODEL" ]] && MODEL="$(pick_fast_model)"
CMD_MODEL="$WHISPER_MODEL"
[[ -z "$CMD_MODEL" || ! -f "$CMD_MODEL" ]] && CMD_MODEL="$(pick_best_model)"

name_lc=$(printf '%s' "$ASSISTANT_NAME" | tr '[:upper:]' '[:lower:]')
if [[ -z "${WAKE_PHRASES}" ]]; then
    WAKE_PHRASES="hey ${name_lc},hi ${name_lc},hello ${name_lc},ok ${name_lc},okay ${name_lc},${name_lc}"
fi
# Accept common mishearings of the name in wake detection.
_name_re="$name_lc"
if [[ "$name_lc" == "ruby" ]]; then
    _name_re='ruby|rubi|rubie|rubey|rooby'
fi

need() { command -v "$1" >/dev/null 2>&1 || { echo "$1 not installed" >&2; exit 1; }; }

set_state() {
    local s="$1"
    printf '%s' "$s" > "$RUN/ruby_state" 2>/dev/null || true
}

ruby_image() {
    local p
    for p in \
        "$HOME/omarchy-siri/assets/ruby-assistant.png" \
        "$HOME/omarchy-siri/assets/ruby-assistant.jpg" \
        "$HOME/Documents/omarchy-siri-archive/Ruby Photos/Ruby AI Assistant.png" \
        "$HOME/Documents/omarchy-siri-archive/Ruby Photos/Ruby AI Assistant.jpg"; do
        [[ -f "$p" ]] && { echo "$p"; return 0; }
    done
    echo ""
}

play_wake_sound() {
    # Brief wake acknowledgment sound (best-effort, non-blocking).
    local snd=""
    for p in \
        /usr/share/sounds/freedesktop/stereo/message-new-instant.oga \
        /usr/share/sounds/freedesktop/stereo/message.oga \
        /usr/share/sounds/freedesktop/stereo/bell.oga \
        /usr/share/sounds/freedesktop/stereo/dialog-information.oga; do
        [[ -f "$p" ]] && snd="$p" && break
    done
    if [[ -n "$snd" ]]; then
        if command -v pw-play >/dev/null 2>&1; then
            pw-play "$snd" </dev/null >/dev/null 2>&1 || true
        elif command -v paplay >/dev/null 2>&1; then
            paplay "$snd" </dev/null >/dev/null 2>&1 || true
        elif command -v canberra-gtk-play >/dev/null 2>&1; then
            canberra-gtk-play -i message </dev/null >/dev/null 2>&1 || true
        fi
    else
        command -v canberra-gtk-play >/dev/null 2>&1 && canberra-gtk-play -i message </dev/null >/dev/null 2>&1 || true
    fi
}

show_listening_notification() {
    local img
    img=$(ruby_image)
    if command -v omarchy-notification-send >/dev/null 2>&1 && [[ -n "$img" ]]; then
        omarchy-notification-send -u low -t 1200 --image "$img" "Ruby" "Listening..." 2>/dev/null || true
    elif [[ -n "$img" ]]; then
        notify-send -t 1200 -i "$img" "Ruby" "Listening..." 2>/dev/null || true
    else
        notify-send -t 1200 "Ruby" "Listening..." 2>/dev/null || true
    fi
}

record_for() {
    local secs="$1" out="$2" allow_ptt_interrupt="${3:-1}"
    rm -f "$out"
    pw-record --rate=16000 --channels=1 "$out" </dev/null >>"$LOG" 2>&1 &
    local pid=$!
    local i=0 steps
    steps=$(awk "BEGIN{printf \"%d\", ($secs/0.1)+0.5}")
    [[ "$steps" -lt 1 ]] && steps=1
    while [[ "$i" -lt "$steps" ]]; do
        # If push-to-talk starts, release mic immediately so PTT hears the user.
        if [[ "$allow_ptt_interrupt" == "1" && -f "$PTT_PID" ]]; then
            kill "$pid" 2>/dev/null || true
            for _ in 1 2 3 4 5; do kill -0 "$pid" 2>/dev/null || break; sleep 0.02; done
            rm -f "$out"
            return 2
        fi
        [[ -f "$STOPFILE" ]] && { kill "$pid" 2>/dev/null || true; break; }
        sleep 0.1
        i=$((i + 1))
    done
    kill "$pid" 2>/dev/null || true
    for _ in 1 2 3 4 5; do kill -0 "$pid" 2>/dev/null || break; sleep 0.05; done
    return 0
}

transcribe() {
    local wav="$1" model="${2:-$MODEL}" threads="${3:-$WHISPER_THREADS}"
    [[ -f "$wav" ]] || { echo ""; return 0; }
    local sz
    sz=$(stat -c%s "$wav" 2>/dev/null || echo 0)
    [[ "$sz" -lt 1200 ]] && { echo ""; return 0; }
    local wargs=(-m "$model" -f "$wav" -t "$threads" -l "$WHISPER_LANG" --no-timestamps -nt -sns)
    [[ -n "${WHISPER_PROMPT:-}" ]] && wargs+=(--prompt "$WHISPER_PROMPT")
    local text
    text=$(whisper-cli "${wargs[@]}" 2>/dev/null \
        | tr '\n' ' ' \
        | sed -E 's/\[[^]]*\]//g; s/\([^)]*\)//g; s/^[[:space:]]*//; s/[[:space:]]*$//; s/[.?!,;:]+$//' \
        | tr -s ' ')
    case "$(printf '%s' "$text" | tr '[:upper:]' '[:lower:]')" in
        ""|"thanks for watching"*|"subtitles by"*|"thank you for watching"*|"please subscribe"*)
            echo ""; return 0 ;;
    esac
    echo "$text"
}

normalize() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -s ' ' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'
}

normalize_punct() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E "s/[^a-z0-9[:space:]']//g; s/[[:space:]]+/ /g; s/^[[:space:]]*//; s/[[:space:]]*$//"
}

extract_command() {
    # args: normalized text, original text
    local norm="$1" orig="$2"
    local normp
    normp=$(normalize_punct "$orig")
    IFS=',' read -ra phrases <<< "$WAKE_PHRASES"
    for p in "${phrases[@]}"; do
        p=$(printf '%s' "$p" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | tr '[:upper:]' '[:lower:]')
        [[ -z "$p" ]] && continue
        if [[ "$norm" == "$p"* || "$normp" == "$p"* ]]; then
            local wc
            wc=$(echo "$p" | wc -w)
            local rest
            rest=$(echo "$orig" | awk -v n="$wc" '{for(i=n+1;i<=NF;i++) printf "%s%s",$i,(i<NF?" ":""); print ""}')
            rest=$(echo "$rest" | sed 's/^[,[:space:]]*//;s/[[:space:]]*$//')
            echo "$rest"
            return 0
        fi
    done
    # fallback: strip leading "hey/hi/hello/ok <name-or-variant>"
    echo "$orig" | sed -E "s/^[[:space:]]*((hey|hi|hello|ok|okay|a)[,[:space:]]+(${_name_re}))[,[:space:]]*//I; s/^[[:space:]]*(${_name_re})[,[:space:]]*//I" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'
}

wake_detected() {
    local norm="$1"
    local normp
    normp=$(normalize_punct "$norm")
    IFS=',' read -ra phrases <<< "$WAKE_PHRASES"
    for p in "${phrases[@]}"; do
        p=$(printf '%s' "$p" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | tr '[:upper:]' '[:lower:]')
        [[ -z "$p" ]] && continue
        [[ "$norm" == "$p"* || "$norm" == *" $p"* || "$norm" == *"$p"* || "$normp" == "$p"* || "$normp" == *" $p"* ]] && return 0
    done
    # fuzzy name/phrase forms: "hey ruby", "a ruby", mishearings
    if echo "$normp" | grep -Eq "(^|[[:space:]])(hey|hi|hello|ok|okay|a)[[:space:]]+(${_name_re})([[:space:]]|$)"; then
        return 0
    fi
    if echo "$normp" | grep -Eq "^(${_name_re})([[:space:]]|$)"; then
        return 0
    fi
    return 1
}

is_running() {
    [[ -f "$PIDFILE" ]] || return 1
    local pid
    pid=$(cat "$PIDFILE" 2>/dev/null || true)
    [[ -n "${pid:-}" ]] && kill -0 "$pid" 2>/dev/null
}

run_loop() {
    need pw-record
    need whisper-cli
    rm -f "$STOPFILE"
    echo $$ > "$PIDFILE"
    echo "$(date '+%F %T') wake listener started (name=$ASSISTANT_NAME)" >> "$LOG"
    while [[ ! -f "$STOPFILE" ]]; do
        # Don't fight push-to-talk recording.
        if [[ -f "$PTT_PID" ]]; then
            ppid=$(cat "$PTT_PID" 2>/dev/null || true)
            if [[ -n "${ppid:-}" ]] && kill -0 "$ppid" 2>/dev/null; then
                sleep 0.5
                continue
            fi
        fi
        rc=0
        record_for "$WAKE_CHUNK_SECONDS" "$CHUNK" || rc=$?
        if [[ "$rc" -eq 2 ]]; then
            rm -f "$CHUNK"
            sleep 0.2
            continue
        fi
        [[ -f "$STOPFILE" ]] && break
        text=$(transcribe "$CHUNK" "$MODEL")
        [[ -z "$text" ]] && { rm -f "$CHUNK"; continue; }
        norm=$(normalize "$text")
        if wake_detected "$norm"; then
            set_state "wake"
            if [[ "$WAKE_SOUND" != "0" && "$WAKE_SOUND" != "false" && "$WAKE_SOUND" != "no" && "$WAKE_SOUND" != "off" ]]; then
                play_wake_sound </dev/null >/dev/null 2>&1 &
            fi
            show_listening_notification
            cmd=$(extract_command "$norm" "$text")
            # If command included in same utterance, run it.
            if [[ -n "${cmd// }" ]]; then
                # Re-transcribe with better model for command accuracy when available.
                if [[ "$CMD_MODEL" != "$MODEL" ]]; then
                    text2=$(transcribe "$CHUNK" "$CMD_MODEL" "${WHISPER_THREADS:-4}")
                    if [[ -n "$text2" ]]; then
                        norm2=$(normalize "$text2")
                        cmd2=$(extract_command "$norm2" "$text2")
                        [[ -n "${cmd2// }" ]] && cmd="$cmd2"
                    fi
                fi
                rm -f "$CHUNK"
                set_state "thinking"
                notify-send -t 1000 "Ruby" "Heard: $cmd" 2>/dev/null || true
                ~/.local/bin/local-voice-exec "$cmd" </dev/null >>"$LOG" 2>&1 || true
                set_state "idle"
                sleep 0.3
                continue
            fi
            rm -f "$CHUNK"
            # Gate VAD/listening for ~300ms after wake sound plays, then listen.
            sleep 0.3
            set_state "listening"
            rc=0
            record_for "$WAKE_COMMAND_SECONDS" "$CMDWAV" || rc=$?
            if [[ "$rc" -eq 2 ]]; then
                rm -f "$CMDWAV"
                set_state "idle"
                sleep 0.2
                continue
            fi
            set_state "thinking"
            cmd=$(transcribe "$CMDWAV" "$CMD_MODEL" "${WHISPER_THREADS:-4}")
            rm -f "$CMDWAV"
            if [[ -n "${cmd// }" ]]; then
                notify-send -t 1200 "Ruby" "Heard: $cmd" 2>/dev/null || true
                ~/.local/bin/local-voice-exec "$cmd" </dev/null >>"$LOG" 2>&1 || true
            fi
            set_state "idle"
            sleep 0.3
        else
            rm -f "$CHUNK"
        fi
    done
    rm -f "$PIDFILE" "$STOPFILE" "$CHUNK" "$CMDWAV"
    echo "$(date '+%F %T') wake listener stopped" >> "$LOG"
}

case "${1:-}" in
    start)
        if is_running; then echo "wake listener already running"; exit 0; fi
        nohup "$0" run </dev/null >>"$LOG" 2>&1 &
        disown 2>/dev/null || true
        echo "wake listener started"
        ;;
    stop)
        if is_running; then
            : > "$STOPFILE"
            pid=$(cat "$PIDFILE" 2>/dev/null || true)
            kill "$pid" 2>/dev/null || true
            rm -f "$PIDFILE"
            echo "wake listener stopped"
        else
            rm -f "$STOPFILE" "$PIDFILE"
            echo "wake listener not running"
        fi
        ;;
    toggle)
        if is_running; then "$0" stop; else "$0" start; fi
        ;;
    status)
        if is_running; then echo "running"; else echo "stopped"; fi
        ;;
    run)
        run_loop
        ;;
    *)
        echo "usage: $0 {start|stop|toggle|status|run}" >&2
        exit 1
        ;;
esac
