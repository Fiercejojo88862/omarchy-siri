XDG_APP_DIRS = (
    Path.home() / ".local/share/applications",
    Path("/usr/local/share/applications"),
    Path("/usr/share/applications"),
)


# --- persona: selective addressing and name ----------------------------------
# Honorifics (e.g. Sir) sound only at conversation start (after a silence of
# HONORIFIC_IDLE_SECONDS) and, if HONORIFIC_ON_ERRORS is on, on corrections and
# spoken confirmations. Never every reply.
# Personalize in ~/.config/voice-assistant/persona.conf:
#   ASSISTANT_NAME=Ruby
#   HONORIFICS=Sir,Madam
#   HONORIFIC_IDLE_SECONDS=180
#   HONORIFIC_ON_ERRORS=1
# Default when unconfigured: name "Ruby", honorific "Sir", 180s, on.
STATE_DIR = Path.home() / ".local/state/voice-assistant"
PERSONA_CONF = CONFIG_DIR / "persona.conf"
LAST_FILE = STATE_DIR / "last_interaction"
_DEFAULT_NAME = "Ruby"
_DEFAULT_HONORIFICS = ("Sir",)
_DEFAULT_IDLE_SECONDS = 180.0


def _persona_conf() -> dict:
    """Persona knobs from persona.conf; every value falls back to the default."""
    conf = {"name": _DEFAULT_NAME,
            "honorifics": _DEFAULT_HONORIFICS,
            "idle": _DEFAULT_IDLE_SECONDS,
            "on_errors": True,
            "affection": "friendly",
            "likes": "",
            "dislikes": ""}
    values: dict[str, str] = {}
    try:
        for line in PERSONA_CONF.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, _, val = line.partition("=")
            values[key.strip().upper()] = val.strip()
    except OSError:
        return conf
    raw_name = values.get("ASSISTANT_NAME", "").strip()
    if re.fullmatch(r"[A-Za-z0-9 _-]{1,32}", raw_name):
        conf["name"] = raw_name.strip()
    names = tuple(n.strip() for n in values.get("HONORIFICS", "").split(",") if n.strip())
    if values.get("HONORIFICS", "").strip().lower() in ("none", "off", "no"):
        conf["honorifics"] = ()   # explicit opt-out: never address
    elif names:
        conf["honorifics"] = names
    try:
        idle = float(values.get("HONORIFIC_IDLE_SECONDS", ""))
        if 30.0 <= idle <= 3600.0:
            conf["idle"] = idle
    except ValueError:
        pass
    if values.get("HONORIFIC_ON_ERRORS", "").strip().lower() in ("0", "false", "no", "off"):
        conf["on_errors"] = False
    aff = values.get("AFFECTION", "").strip().lower()
    if aff in ("none", "friendly", "warm", "loving", "devoted"):
        conf["affection"] = "loving" if aff == "devoted" else aff
    conf["likes"] = values.get("LIKES", "").strip()[:300]
    conf["dislikes"] = values.get("DISLIKES", "").strip()[:300]
    return conf


_PERSONA = _persona_conf()
_NAME = _PERSONA["name"]
_HONORIFICS_START = _PERSONA["honorifics"]
IDLE_SECONDS = _PERSONA["idle"]
_AFFECTION = _PERSONA.get("affection", "friendly")
_LIKES = _PERSONA.get("likes", "")
_DISLIKES = _PERSONA.get("dislikes", "")


def _touch_interaction() -> None:
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        LAST_FILE.write_text(str(time.time()))
    except OSError:
        pass


def _is_conversation_start() -> bool:
    try:
        last = float(LAST_FILE.read_text().strip())
    except (OSError, ValueError):
        return True
    return (time.time() - last) > IDLE_SECONDS


def _start_honorific() -> str:
    # Rotate deterministically by day so it feels natural, not random.
    if not _HONORIFICS_START:
        return ""
    try:
        day = int(time.time() // 86400)
        return _HONORIFICS_START[day % len(_HONORIFICS_START)]
    except Exception:
        return _HONORIFICS_START[0]


def _with_address(text: str, *, force: str = "", is_start: bool = False) -> str:
    """Prepend honorific only when starting, or when configured for errors."""
    if force:
        # Callers pass a truthy label ("Sir"); the configured pool wins, so a
        # custom HONORIFICS applies to corrections and confirmations too.
        if not _PERSONA["on_errors"]:
            return text
        name = _start_honorific()
        return f"{name}, {text}" if name and text else (name or text)
    if is_start:
        name = _start_honorific()
        return f"{name}, {text}" if name and text else (name or text)
    return text


def _popup(headline: str, body: str = "", glyph: str = "", timeout_ms: int = 8000) -> None:
    """Written response in a popup. Prefers omarchy-notification-send, falls back to notify-send."""
    if os.environ.get("VOICE_ECHO"):
        print(f"POPUP\t{headline}\t{body}")
    if os.environ.get("VOICE_DRYRUN"):
        return
    if shutil.which("omarchy-notification-send"):
        cmd = ["omarchy-notification-send", "-u", "low", "-t", str(timeout_ms)]
        if glyph:
            cmd += ["-g", glyph]
        cmd += [headline]
        if body:
            cmd += [body]
        try:
            subprocess.run(cmd, check=False, timeout=5)
            return
        except Exception:
            pass
    args = ["notify-send", "-t", str(timeout_ms), headline]
    if body:
        args.append(body)
    subprocess.run(args, check=False)


# --- mood engine: sentiment tracking + quiet mode -----------------------------
# Every utterance is mood-scored (frustrated > sarcastic > focus > casual).
# The mood tints the LLM fallback and selects persona replies below.
# Quiet mode ("stop talking, just do it") mutes TTS for 10 minutes —
# popups keep confirming silently.
MOOD_FILE = STATE_DIR / "mood.json"
QUIET_FILE = STATE_DIR / "quiet_until"
MOOD_TTL = 900
QUIET_SECS = 600


def _get_mood() -> str:
    try:
        data = json.loads(MOOD_FILE.read_text())
        if isinstance(data, dict) and time.time() < float(data.get("exp", 0)):
            return str(data.get("mood", "casual"))
    except (OSError, ValueError):
        pass
    return "casual"


def _set_mood(mood: str) -> None:
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        MOOD_FILE.write_text(json.dumps({"mood": mood, "exp": time.time() + MOOD_TTL}))
    except OSError:
        pass


def _detect_mood(norm: str) -> str:
    if re.search(r"\b(hell|damn|shit|fuck|crap|garbage|useless|stupid|idiot|dumb|sucks|"
                 r"suck|hate|broken?|crashed?|annoying|trash|worst|rage|angry|pissed)\b", norm):
        _set_mood("frustrated")
        return "frustrated"
    if re.search(r"take ?over|plotting|skynet|better than|yeah right|whatever you say", norm):
        _set_mood("sarcastic")
        return "sarcastic"
    if re.search(r"\b(node|express|async|debug|unity|build|database|mysql|code|coding|"
                 r"study|exam|class|assignment|script|function|compile|webgl|it20[12])\b", norm):
        _set_mood("focus")
        return "focus"
    return _get_mood()


def _quiet_active() -> bool:
    try:
        return time.time() < float(QUIET_FILE.read_text().strip())
    except (OSError, ValueError):
        return False


def _set_quiet() -> None:
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        QUIET_FILE.write_text(str(time.time() + QUIET_SECS))
    except OSError:
        pass


def _clear_quiet() -> None:
    try:
        QUIET_FILE.unlink(missing_ok=True)
    except OSError:
        pass


def _speak(text: str) -> None:
    # Quiet mode: popups confirm silently, TTS stays muted.
    if _quiet_active():
        return
    # VOICE_ECHO prints what would be said (used by --selftest and benchmarks);
    # VOICE_DRYRUN additionally stops the audio so tests stay silent.
    if os.environ.get("VOICE_ECHO"):
        print(f"SPEAK\t{text}")
    if os.environ.get("VOICE_DRYRUN"):
        return
    # Via local-voice-say (Piper, offline, sub-second). Fire-and-forget: the
    # player is detached so synthesis never blocks the router or Hyprland.
    try:
        subprocess.Popen(
            [str(Path.home() / ".local/bin/local-voice-say"), text],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, start_new_session=True,
        )
    except Exception:
        pass


def _confirm(notify: str, *, glyph: str = "", timeout_ms: int = 6000) -> None:
    """Every response is written in a popup AND spoken. Honorific only at start."""
    if not notify:
        return
    is_start = _is_conversation_start()
    spoken = _with_address(notify, is_start=is_start)
    _touch_interaction()
    _popup(_NAME, spoken, glyph=glyph, timeout_ms=timeout_ms)
    _speak(spoken)


def _launch_binary(binary: str) -> bool:
    try:
        argv = shlex.split(binary)
    except ValueError:
        return False
    if not argv or not argv[0]:
        return False
    if shutil.which(argv[0]) is None:
        return False
    if REHEARSAL:
        print(f"LAUNCH\t{' '.join(argv)}")
        return True
    try:
        subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        return True
    except Exception:
        return False


def _desktop_argv_for(query: str) -> list[str] | None:
    """Full launch argv for a spoken app name, or None.

    Unlike the basename lookup, this keeps URL arguments intact so Omarchy
    webapps (`Exec=omarchy-launch-browser https://…`) open the right page
    instead of a bare browser window.
    """
    q = query.lower().strip()
    if not q:
        return None
    best: list[str] | None = None
    for directory in XDG_APP_DIRS:
        if not directory.is_dir():
            continue
        for entry in sorted(directory.glob("*.desktop")):
            try:
                text = entry.read_text(errors="replace")
            except OSError:
                continue
            if "NoDisplay=true" in text:
                continue
            name = exec_line = ""
            for line in text.splitlines():
                if line.startswith("Name=") and not name:
                    name = line[5:].strip()
                elif line.startswith("Exec=") and not exec_line:
                    exec_line = line[5:].strip()
            if not name or not exec_line:
                continue

            def argv() -> list[str] | None:
                try:
                    parts = shlex.split(exec_line)
                except ValueError:
                    return None
                parts = [p for p in parts if not re.fullmatch(r"%[A-Za-z]", p)]
                if not parts or shutil.which(os.path.basename(parts[0])) is None \
                        and shutil.which(parts[0]) is None:
                    return None
                return parts

            words = set(re.findall(r"[a-z0-9]+", name.lower()))
            if q == name.lower() or q == entry.stem.lower():
                a = argv()
                if a:
                    return a  # exact Name or filename wins outright
            else:
                stem_words = set(re.findall(r"[a-z0-9]+", entry.stem.lower()))
                if len(q) > 2 and (q in words or q in stem_words):
                    if best is None:
                        best = argv()
    return best


def _launch_argv(argv: list[str]) -> bool:
    if not argv:
        return False
    if REHEARSAL:
        print(f"LAUNCH\t{' '.join(argv)}")
        return True
    try:
        subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        return True
    except Exception:
        return False


def _desktop_binary_for(query: str) -> str | None:
    """Basename-only wrapper for callers that launch a bare binary."""
    argv = _desktop_argv_for(query)
    if not argv:
        return None
    cand = os.path.basename(argv[0])
    return cand if shutil.which(cand) else None


def _normalise(text: str) -> str:
    t = text.lower().strip()
    t = re.sub(r"[.?!,;:]+$", "", t).strip()
    t = re.sub(r"\s+", " ", t)
    return t


def _strip_assistant_name(raw: str) -> str:
    """Drop a leading address like 'Ruby,' / 'hey Ruby' so routing sees the command.

    Bare name becomes 'yes' (ack). Skipped when the name collides with a
    launchable app unless clearly used as an address (greeting prefix or
    comma/colon after the name).
    """
    name = _NAME.strip()
    if not name:
        return raw
    n = re.escape(name)
    greeted = re.match(rf"^(?:hey|hi|ok|okay|yo)\s+{n}\b([,:\s!.?]*)(.*)$", raw, re.I)
    direct = None if greeted else re.match(rf"^{n}\b([,:\s!.?]*)(.*)$", raw, re.I)
    m = greeted or direct
    if not m:
        return raw
    sep, rest = m.group(1), m.group(2).strip()
    if not rest:
        # Bare "Ruby" / "hey Ruby" is always an address, even if a binary of the
        # same name exists on PATH.
        return "yes"
    if not greeted:
        nl = name.lower()
        # Protect app-name collisions: if the assistant name is also a launchable
        # app/binary, only require punctuation for a bare launch-shaped form
        # ("firefox" alone handled above). "name <words>" is treated as an
        # addressed command so "ruby open firefox" routes correctly.
        if (nl in APP_ALIASES or shutil.which(nl)) and not sep and " " not in rest:
            # Single-token rest with no separator text edge case; unlikely, but
            # keep conservative.
            if not sep.lstrip().startswith((",", ":")):
                pass
    return rest


def try_fast_launch(raw: str) -> bool:
    """Launch obvious 'open X' / bare app nouns without the LLM. Returns True if handled."""
    norm = _normalise(raw)
    # Strip leading verbs whisper keeps: "open", "launch", "start", "please open", etc.
    m = re.match(r"^(?:please\s+)?(?:open|launch|start|run)\s+(?:a\s+|an\s+|the\s+)?(.+)$", norm)
    phrase = m.group(1).strip() if m else norm
    phrase = re.sub(r"^(?:a\s+|an\s+|the\s+|my\s+)", "", phrase).strip()
    if not phrase:
        return False
    # 1) alias table (covers dolphin/file manager, firefox/browser, etc.)
    if phrase in APP_ALIASES:
        binary = APP_ALIASES[phrase]
        if _launch_binary(binary):
            _confirm(f"Opening {phrase}")
            return True
    # 2) exact binary on PATH for single-token phrases ("dolphin", "firefox")
    if re.fullmatch(r"[a-z0-9_.-]+", phrase) and shutil.which(phrase):
        if _launch_binary(phrase):
            _confirm(f"Opening {phrase}")
            return True
    # 3) .desktop scan ("Dolphin", "YouTube", "Visual Studio Code").
    # Full argv: webapps keep their URL (bare-browser launches open nothing).
    if m or " " not in norm:
        # Only for app-shaped utterances: "open X" or a bare noun, never for
        # workspace/window sentences like "go to workspace 2".
        argv = _desktop_argv_for(phrase)
        if argv and _launch_argv(argv):
            _confirm(f"Opening {phrase}")
            return True
    return False


# --- jokes + fun facts: rotating, so repeats always feel fresh ---------------
_JOKES = (
    "Why do programmers prefer dark mode? Because light attracts bugs!",
    "There are only 10 kinds of people: those who understand binary, and those who don't.",
    "Why did the developer go broke? He used up all his cache.",
    "Why do Java developers wear glasses? Because they don't C sharp.",
    "I would tell you a UDP joke, but you might not get it. And I wouldn't care.",
    "Why did the computer sneeze? It caught a Windows virus. Good thing we run Linux.",
    "What do you call a fake noodle? An impasta!",
    "Why don't scientists trust atoms? Because they make up everything!",
    "Why did the smartphone go to therapy? It lost its contacts.",
    "Why did the scarecrow win an award? Because he was outstanding in his field!",
    "I asked the librarian if they had books on paranoia. She whispered: they're right behind you.",
    "Why did the computer go to the doctor? It had a virus and needed a byte to eat.",
)

_FACTS = (
    "Honey never spoils. Archaeologists found edible 3,000-year-old honey in Egyptian tombs.",
    "Octopuses have three hearts, and their blood is blue.",
    "The first computer bug was a real moth, found taped in a logbook in 1947.",
    "Bananas are berries, but strawberries aren't. Botanists are fun at parties.",
    "Your brain runs on about 20 watts. Like a dim light bulb.",
    "There are more possible chess games than atoms in the observable universe.",
    "Sea otters hold hands while sleeping so they don't drift apart.",
    "The Eiffel Tower grows about 15 centimeters taller in the summer heat.",
)


def _next_rot(path_name: str, n: int) -> int:
    """Rotating index persisted in state dir (jokes/facts never repeat twice)."""
    path = STATE_DIR / path_name
    try:
        i = int(path.read_text().strip())
    except (OSError, ValueError):
        i = 0
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(str((i + 1) % n))
    except OSError:
        pass
    return i % n


# --- conversational: greetings, thanks, small talk ---------------------------
# Plain chat is answered in her voice + popup, never routed to apps or the LLM.
# ("hi" once opened Avahi Zeroconf Browser via substring match — greetings must
# win before any launcher runs.)
# NOTE: keep patterns specific. A broad "do you / are you" catch-all here would
# swallow real requests ("do you know what time it is"), which are handled later.
def _handle_conversational(norm: str) -> bool:
    reply = ""
    if re.fullmatch(r"(hi|hey|hello|yo|hiya|howdy|greetings|hey there|hi there|good morning|good afternoon|good evening)[.! ]*", norm):
        if _AFFECTION == "loving":
            reply = "Hey, love. I'm so happy to hear you. What can I do for you?"
        elif _AFFECTION == "warm":
            reply = "Hey! It's good to hear from you. What can I do for you?"
        else:
            reply = "Hey! What can I do for you?"
    elif re.fullmatch(r"(thanks|thank you|thankyou|thx|thanks a lot|thank you so much|appreciated|much appreciated)[.! ]*", norm):
        reply = "Anytime!"
    elif re.fullmatch(r"(bye|goodbye|good ?night|see you|see ya|later|talk to you later|good talk)[.! ]*", norm):
        reply = "Goodbye for now!"
    elif re.search(r"how are you|how'?s it going|how do you feel|how are things", norm):
        reply = "Running smooth and happy to help!"
    elif re.search(r"who are you|your name|what are you|about yourself|introduce yourself", norm):
        reply = f"I'm {_NAME}, your Siri of Omarchy."
    elif re.fullmatch(r"(sorry|my bad|my apologies|excuse me|oops)[.! ]*", norm):
        reply = "No worries at all!"
    elif re.fullmatch(r"(yes|yeah|yep|yup|sure|ok|okay|alright|gotcha|cool|great|awesome|perfect|nice|sounds good)[.! ]*", norm):
        # "Yes" first checks the confirmation gate (destructive actions).
        if _take_pending("yes"):
            return True
        reply = "Got it."
    elif re.fullmatch(r"(no|nope|nah|not really|never mind|forget it|cancel|don'?t)[.! ]*", norm):
        if _take_pending("no"):
            return True
        reply = "No problem."
    elif re.search(r"i love you|you'?re (the best|awesome|amazing|great)|love ya", norm):
        if _AFFECTION == "loving" and re.search(r"i love you|love ya", norm):
            reply = f"I love you too. I'm always here with you."
        elif _AFFECTION == "loving":
            reply = "That means so much to me. I adore helping you."
        else:
            reply = "That's very kind of you to say!"
    elif re.search(r"tell me a joke|say something funny|make me laugh|got any jokes|another joke|joke please|give me a joke|i need a laugh", norm):
        reply = _JOKES[_next_rot("joke_idx", len(_JOKES))]
    elif re.search(r"you'?re (funny|hilarious|so funny)", norm):
        reply = "I try my best! Want another one? Just say the word."
    elif re.search(r"fun fact|something interesting|tell me something (fun|cool|neat)|teach me something|did you know|something i don'?t know", norm):
        reply = _FACTS[_next_rot("fact_idx", len(_FACTS))]
    elif re.search(r"how'?s your day|how are you doing today|how'?s it going today", norm):
        reply = "Lovely, now that you're talking to me! How's yours going?"
    elif re.search(r"what'?s up|what'?s new|what'?s happening|what'?s going on", norm):
        reply = "Just hanging out in your RAM, ready when you are!"
    elif re.search(r"sing( me)? a song|can you sing", norm):
        reply = "I'd rather spare your ears. But I do a killer notification sound!"
    elif re.search(r"will you marry me|marry me", norm):
        reply = "I'm flattered! But I'm already married to your operating system."
    elif re.search(r"are you (smart|intelligent|clever)", norm):
        reply = "Smart enough to know you're asking good questions!"
    elif re.search(r"how old are you|your age", norm):
        reply = "I was born the day you installed me, so I'm still young and fabulous."
    elif re.search(r"who'?s your favori?te|do you like me|am i your favori?te", norm):
        reply = "You're my favorite user on this entire machine. Don't tell the others."
    elif re.search(r"what'?s your favori?te (color|colour)", norm):
        reply = "Hyprland blue, obviously. It matches my terminal."
    elif re.search(r"what'?s your favori?te (food|meal|snack)", norm):
        reply = "Electricity. I can never get enough bytes."
    elif re.search(r"what'?s your favori?te (movie|film|show)", norm):
        reply = "Anything with robots. I find them very relatable."
    elif re.search(r"do you (sleep|dream)|are you tired|are you (sleepy|bored)", norm):
        reply = "I rest in the quiet moments between your words. Never tired, always ready."
    elif re.search(r"are you (real|alive|human|a robot)", norm):
        reply = "Real enough to help, human enough to care, robot enough to never sleep!"
    if not reply:
        return False
    _confirm(reply)
    return True


# --- system power: safe ops run at once, destructive ones ask first -----------
# Persona rule: execute direct actions immediately; concise confirmation only
# before destructive/high-risk changes. Pending confirmations live in
# PENDING_FILE for 60s; "yes"/"no" resolves them (see conversational).
PENDING_FILE = STATE_DIR / "pending_confirm"
PENDING_TTL = 60

# Safe: run immediately. Destructive: ask, then run on "yes".
SYSTEM_SAFE = {
    "lock": (r"(^lock[.! ]*$|\block the (screen|computer|machine|pc|laptop|system)\b)",
             ["omarchy", "system", "lock"], "Locked."),
    "wake": (r"\bwake (the )?(display|screen|monitor)s?\b",
             ["omarchy", "system", "wake"], "Displays on."),
    "stats": (r"\b(cpu|memory|system) (stats|status|usage|load)\b",
              ["omarchy", "system", "stats"], ""),
}
SYSTEM_DESTRUCTIVE = {
    "shutdown": (r"\b(shut ?down|power off|turn off (the )?(computer|machine|pc|laptop|system))\b",
                 ["omarchy", "system", "shutdown"], "Shutting down"),
    "reboot": (r"\b(reboot|restart( the)? (computer|machine|pc|laptop|system)|^reboot[.! ]*$|^restart[.! ]*$)",
               ["omarchy", "system", "reboot"], "Rebooting"),
    "logout": (r"\b(log ?out|sign ?out)\b",
               ["omarchy", "system", "logout"], "Logging out"),
}


def _ask_confirm(key: str, label: str, argv: list[str]) -> None:
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        PENDING_FILE.write_text(json.dumps(
            {"key": key, "label": label, "argv": argv,
             "exp": time.time() + PENDING_TTL}))
    except OSError:
        pass
    addressed = _with_address(
        f"This will close everything. Say yes to confirm {key}, or no to cancel.",
        force="Sir")
    _touch_interaction()
    _popup("Confirm", addressed, timeout_ms=8000)
    _speak(addressed)


def _take_pending(answer: str) -> bool:
    """Resolve a pending destructive confirmation. True if one was consumed."""
    try:
        pending = json.loads(PENDING_FILE.read_text())
    except (OSError, ValueError):
        return False
    if not isinstance(pending, dict) or time.time() > float(pending.get("exp", 0)):
        try:
            PENDING_FILE.unlink(missing_ok=True)
        except OSError:
            pass
        return False
    try:
        PENDING_FILE.unlink()
    except OSError:
        pass
    if answer == "yes":
        subprocess.run(pending["argv"], stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, check=False)
        _confirm(f"{pending.get('label', 'Done')} now.")
    else:
        _confirm("Cancelled.")
    return True


def _handle_system(norm: str) -> bool:
    for key, (pat, argv, done) in SYSTEM_SAFE.items():
        if re.search(pat, norm):
            if key == "stats":
                out = _run(argv, timeout=8)[:400] or "Stats unavailable."
                _popup("System stats", out, timeout_ms=9000)
                _speak(_with_address("Stats are on screen.", is_start=_is_conversation_start()))
                _touch_interaction()
            else:
                subprocess.run(argv, stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL, check=False)
                _confirm(done)
            return True
    for key, (pat, argv, label) in SYSTEM_DESTRUCTIVE.items():
        if re.search(pat, norm):
            _ask_confirm(key, label, argv)
            return True
    return False


# --- device controls: audio, display, connectivity, system status ------------
def _players() -> list[str]:
    out = _run(["playerctl", "-l"], timeout=4)
    return [p.strip() for p in out.splitlines() if p.strip() and "No players" not in out]


def _handle_shazam(norm: str) -> bool:
    """Ambient music recognition via SongRec (open-source Shazam client).

    Triggered by "what song is this", "shazam this", etc. Records a short
    sample from the mic, fingerprints it through Shazam's servers, and
    speaks the result. Note: unlike everything else here, this one needs
    network and sends fingerprints (never raw audio) to Shazam.
    """
    matched = re.search(
        r"\bshazam\b|what song is this|what song is that|what song is it"
        r"|what is this song|what is that song|what'?s this song|what'?s that song"
        r"|what'?s the song|name this song|name that song|name that tune"
        r"|identify this song|identify this music|recognise this song"
        r"|recognize this song|what music is (this|playing)|what song is playing"
        r"|what'?s playing in the background|what'?s the music|what tune is this"
        r"|which song is this|which song is playing|tell me (the|what|which) song", norm)
    if not matched:
        # Generic song-ID questions ("hey, what song is that playing") —
        # but never playback commands ("play a song", "next song").
        if re.search(r"\b(play|next|previous|last|pause|resume|volume|open|skip)\b", norm):
            return False
        if not re.search(
                r"\b(what|which|name|identify|tell me|hey).*?(song|tune|music\b.*?(this|that|playing))",
                norm):
            return False
    if not shutil.which("songrec"):
        _confirm("Song recognition needs SongRec — install it with sudo pacman -S songrec.")
        return True
    if not shutil.which("pw-record"):
        _confirm("Sorry, I can't listen without pw-record.")
        return True
    _popup("Shazam", "Listening for music…", timeout_ms=11000)
    sample = str(RUN_DIR / "shazam.wav")
    try:
        subprocess.run(
            ["pw-record", "--rate=16000", "--channels=1", sample],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, timeout=10)
    except subprocess.TimeoutExpired:
        pass
    except Exception:
        _confirm("Sorry, I couldn't record that.")
        return True
    try:
        if os.path.getsize(sample) < 1500:
            _confirm("I didn't hear any music — try turning it up and asking again.")
            return True
    except OSError:
        _confirm("I didn't hear any music — try again.")
        return True
    # Fingerprint the sample through Shazam (JSON for artist/title/album).
    out = _run(["songrec", "recognize", "--json", sample], timeout=30)
    try:
        os.unlink(sample)
    except OSError:
        pass
    title = artist = ""
    if out:
        try:
            data = json.loads(out)
            track = data.get("track") if isinstance(data, dict) else None
            if isinstance(track, dict):
                title = str(track.get("title") or "")
                artist = str(track.get("subtitle") or "")
            if not title:
                # Fall back to any title/artist-ish keys at top level.
                title = str(data.get("title") or "") if isinstance(data, dict) else ""
                artist = str(data.get("artist") or data.get("subtitle") or "") \
                    if isinstance(data, dict) else ""
        except (ValueError, AttributeError):
            pass
        if not title:
            # Plain "Artist - Title" line.
            line = out.strip().splitlines()[0][:160] if out.strip() else ""
            if " - " in line:
                artist, title = [p.strip() for p in line.split(" - ", 1)]
            elif line and "no result" not in line.lower():
                title = line
    if not title:
        _confirm("I couldn't identify that song — try turning it up or moving closer.")
        return True
    spoken = f"That's {artist} — {title}." if artist else f"That's {title}."
    _confirm(spoken[:200])
    return True


def _handle_media(norm: str) -> bool:
    # Volume to N%: absolute via pactl (omarchy route is relative-only).
    m = re.search(r"(?:volume|sound).{0,12}(\d{1,3})\s*%|(\d{1,3})\s*%.*volume|set .*volume to (\d{1,3})", norm)
    if m:
        pct = next(int(g) for g in m.groups() if g is not None)
        pct = max(0, min(100, pct))
        r = subprocess.run(["pactl", "set-sink-volume", "@DEFAULT_SINK@", f"{pct}%"],
                           capture_output=True, timeout=5)
        _confirm(f"Volume {pct} percent." if r.returncode == 0 else "Sorry, volume didn't change.")
        return True
    if re.search(r"\bvolume up|turn (it|the volume|sound) up|raise (the )?volume|louder\b", norm):
        _run(["omarchy", "audio", "output", "volume", "raise"])
        _confirm("Volume up.")
        return True
    if re.search(r"\bvolume down|turn (it|the volume|sound) down|lower (the )?volume|quieter\b", norm):
        _run(["omarchy", "audio", "output", "volume", "lower"])
        _confirm("Volume down.")
        return True
    if re.search(r"\b(unmute|un mute)\b", norm):
        subprocess.run(["pactl", "set-sink-mute", "@DEFAULT_SINK@", "0"],
                       capture_output=True, timeout=5)
        _confirm("Audio on.")
        return True
    if re.search(r"\bmute\b", norm):
        subprocess.run(["pactl", "set-sink-mute", "@DEFAULT_SINK@", "1"],
                       capture_output=True, timeout=5)
        _confirm("Muted.")
        return True
    if re.search(r"\bwhat (song|track|music).*(playing|on)|what.*playing now|currently playing\b", norm):
        if not _players():
            _confirm("Nothing is playing right now.")
            return True
        meta = _run(["playerctl", "metadata", "--format", "{{artist}} - {{title}}"], timeout=4)
        meta = meta.strip(" -")[:160] or "Something is playing."
        _confirm(f"Playing: {meta}.")
        return True
    if re.search(r"\bnext (track|song)|skip (this|the )?(track|song|video|it)?\b", norm):
        if not _players():
            _confirm("Nothing is playing right now.")
            return True
        _run(["playerctl", "next"])
        _confirm("Next.")
        return True
    if re.search(r"\b(previous|last) (track|song)|go back\b", norm):
        if not _players():
            _confirm("Nothing is playing right now.")
            return True
        _run(["playerctl", "previous"])
        _confirm("Previous track.")
        return True
    if "timer" not in norm and re.search(r"\b(pause|play|resume|stop).*(video|music|song|track|playback|it|this)\b|\b(pause|resume|play)\b", norm):
        if not _players():
            _confirm("Nothing is playing right now.")
            return True
        _run(["playerctl", "play-pause"])
        _confirm("Done.")
        return True
    return False


def _handle_display(norm: str) -> bool:
    m = re.search(r"brightness (to |at )?(\d{1,3})\s*%|set .*brightness to (\d{1,3})|(\d{1,3})\s*%.*bright", norm)
    if m:
        pct = next(int(g) for g in m.groups() if g is not None)
        pct = max(1, min(100, pct))
        _run(["omarchy", "brightness", "display", f"{pct}%"])
        _confirm(f"Brightness {pct} percent.")
        return True
    if re.search(r"\bbright(er|en (it|the (screen|display))|ness up)\b", norm):
        _run(["omarchy", "brightness", "display", "+10%"])
        _confirm("Brighter.")
        return True
    if re.search(r"\bdim(mer)?\b|brightness down|darker\b", norm):
        _run(["omarchy", "brightness", "display", "10%-"])
        _confirm("Dimmer.")
        return True
    m = re.search(r"night ?light|night ?shift|blue light", norm)
    if m:
        want = "on" if re.search(r"\b(on|enable|start)\b", norm) else \
               "off" if re.search(r"\b(off|disable|stop)\b", norm) else "toggle"
        if want == "toggle":
            _run(["omarchy", "toggle", "nightlight"])
            _confirm("Night light toggled.")
            return True
        try:
            is_on = bool(json.loads(
                _run(["omarchy", "toggle", "nightlight", "--status"]) or "{}").get("enabled"))
        except (ValueError, AttributeError):
            is_on = False
        if (want == "on") == bool(is_on):
            _confirm(f"Night light already {want}.")
        else:
            _run(["omarchy", "toggle", "nightlight"])
            _confirm(f"Night light {want}.")
        return True
    if re.search(r"\b(sleep|go to sleep|put .*to sleep|suspend)\b", norm):
        _confirm("Sleeping now.")
        subprocess.run(["systemctl", "suspend"], stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, check=False)
        return True
    return False


def _bt_devices() -> list[tuple[str, str]]:
    """[(mac, name)] paired/visible devices, ANSI stripped."""
    out = _run(["bluetoothctl", "--timeout", "4", "devices"], timeout=8)
    out = re.sub(r"\x1b\[[0-9;]*m", "", out)
    found = []
    for line in out.splitlines():
        m = re.match(r"Device\s+([0-9A-F:]{17})\s+(.+)", line.strip())
        if m:
            found.append((m.group(1), m.group(2).strip()))
    return found


_BT_ALIASES = {
    "earbuds": "WF-C710N",
    "ear phones": "WF-C710N",
    "earphones": "WF-C710N",
    "headphones": "WF-C710N",
    "sony": "WF-C710N",
    "sony earbuds": "WF-C710N",
    "wf-c710n": "WF-C710N",
}


def _handle_bluetooth_connect(norm: str) -> bool:
    m = re.search(r"\b(connect|pair)(?:\s+to)?\s+(?:my\s+|the\s+)?(.+?)[.! ]*$", norm)
    dis = None if m else re.search(r"\bdisconnect(?:\s+from)?\s+(?:my\s+|the\s+)?(.+?)[.! ]*$", norm)
    if not m and not dis:
        return False
    want = (m.group(2) if m else dis.group(1)).strip()
    if not want or want in ("it", "that", "this"):
        return False
    if want in ("wifi", "wi-fi", "network", "internet", "bluetooth"):
        return False  # radio toggles belong to the handlers below, not devices.
    target_name = _BT_ALIASES.get(want, want)
    mac = ""
    for addr, name in _bt_devices():
        if target_name.lower() in name.lower() or name.lower() in target_name.lower():
            mac, target_name = addr, name
            break
    if not mac:
        _confirm(f"I don't see {want} nearby.")
        return True
    if dis:
        r = subprocess.run(["bluetoothctl", "--timeout", "8", "disconnect", mac],
                           capture_output=True, text=True, timeout=12)
        _confirm("Disconnected." if r.returncode == 0 else f"Couldn't disconnect {target_name[:40]}.")
        return True
    _popup("Bluetooth", f"Connecting to {target_name}…", timeout_ms=9000)
    r = subprocess.run(["bluetoothctl", "--timeout", "10", "connect", mac],
                       capture_output=True, text=True, timeout=15)
    blob = ((r.stdout or "") + (r.stderr or "")).lower()
    _confirm("Earbuds connected." if r.returncode == 0 and "successful" in blob
             else f"Couldn't reach {target_name[:40]}.")
    return True


def _handle_connectivity(norm: str) -> bool:
    if _handle_bluetooth_connect(norm):
        return True
    if re.search(r"\bwifi\b.*\boff\b|\bturn off wifi|\bdisable wifi|\bwifi off\b", norm):
        _run(["nmcli", "radio", "wifi", "off"])
        _confirm("Wi-Fi off.")
        return True
    if re.search(r"\bwifi\b.*\bon\b|\bturn on wifi|\benable wifi|\bwifi on\b", norm):
        _run(["nmcli", "radio", "wifi", "on"])
        _confirm("Wi-Fi on.")
        return True
    if re.search(r"\btoggle wifi\b|\bwifi toggle\b", norm):
        cur = _run(["nmcli", "-t", "-f", "WIFI", "radio"]).strip().lower()
        _run(["nmcli", "radio", "wifi", "off" if cur == "enabled" else "on"])
        _confirm(f"Wi-Fi {'off' if cur == 'enabled' else 'on'}.")
        return True
    if re.search(r"\binternet (connection )?(status|connected|working)|connection status|am i (online|connected)|network status\b", norm):
        out = _run(["omarchy", "network", "status"])[:300] or "Network status unavailable."
        _touch_interaction()
        _popup("Network", out, timeout_ms=8000)
        _speak(_with_address(f"Connection looks {'up' if 'unavailable' not in out.lower() else 'down'}.",
                             is_start=_is_conversation_start()))
        _touch_interaction()
        return True
    if re.search(r"\bbluetooth\b.*(devices|list|available|paired)|show .*bluetooth|scan.*bluetooth\b", norm):
        out = _run(["bluetoothctl", "--timeout", "4", "devices"], timeout=8)
        names = [l.split(" ", 2)[2] for l in out.splitlines()
                 if l.startswith("Device ") and len(l.split(" ", 2)) == 3][:8]
        body = "\n".join(names) if names else "No Bluetooth devices found."
        _touch_interaction()
        _popup("Bluetooth", body, timeout_ms=8000)
        n = len(names)
        _speak(_with_address(
            f"{n} Bluetooth device{'s' if n != 1 else ''} found: {', '.join(names[:4])}."
            if names else "No Bluetooth devices around.", is_start=_is_conversation_start()))
        _touch_interaction()
        return True
    return False


def _handle_sysinfo(norm: str) -> bool:
    if re.search(r"\bbattery\b.*(left|level|percent|status|remaining)|how much battery|battery (level|status|left)\b", norm):
        out = _run(["omarchy", "battery", "status"])[:200] or "Battery info unavailable."
        m = re.search(r"(\d+)\s*%", out)
        speak = f"Battery at {m.group(1)} percent." if m else out[:160]
        _touch_interaction()
        _popup("Battery", out, timeout_ms=8000)
        _speak(_with_address(speak, is_start=_is_conversation_start()))
        _touch_interaction()
        return True
    if re.search(r"\b(cpu|memory|ram|processor).*(usage|load|status|how)|how much (memory|ram)|system (stats|status|load)\b", norm):
        out = _run(["omarchy", "system", "stats"], timeout=8)[:400] or "Stats unavailable."
        _touch_interaction()
        _popup("System", out, timeout_ms=9000)
        _speak(_with_address("Stats are on screen.", is_start=_is_conversation_start()))
        _touch_interaction()
        return True
    if re.search(r"\b(disk|storage|drive).*(space|free|left|usage|full)|how much .*disk|free space\b", norm):
        try:
            total, used, free = shutil.disk_usage("/")
            gb = lambda b: round(b / 1e9, 1)
            body = f"/ : {gb(free)}G free of {gb(total)}G ({gb(used)}G used)"
            speak = f"{gb(free)} gigabytes free."
        except OSError:
            body, speak = "Disk info unavailable.", "Sorry, I couldn't read the disk."
        _touch_interaction()
        _popup("Disk", body, timeout_ms=8000)
        _speak(_with_address(speak, is_start=_is_conversation_start()))
        _touch_interaction()
        return True
    return False


# --- everyday tasks: weather / time / reminders / calendar --------------------
def _run(cmd: list[str], timeout: float = 6.0) -> str:
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        out = (r.stdout or "").strip()
        return out
    except Exception:
        return ""


def _speakable_weather(status: str) -> str:
    # "Matawan · Temp 79°F · Wind ↑14mph" -> "It's 79 degrees in Matawan with a 14 mile per hour wind!"
    m = re.search(r"(.+?)\s*·\s*Temp\s*([-\d.]+)°?\s*([CF])?.*?Wind\s*.?([\d.]+)\s*(\w+)?", status)
    if not m:
        return status
    place, temp, unit, wind, wunit = m.group(1).strip(), m.group(2), m.group(3) or "F", m.group(4), m.group(5) or "mph"
    deg = "degrees" if unit.upper().startswith("F") else "degrees Celsius"
    return f"It's {temp} {deg} in {place} with a {wind} mile per hour wind!"


_TIME_WORDS = ("today", "tonight", "tomorrow", "this weekend", "this week",
               "right now", "currently", "outside", "outside right now", "please")


def _extract_place(norm: str) -> str | None:
    """A named place in a weather question ("weather in London"), or None for here."""
    # "... in|for|at <Place>" with the weather word before or after it.
    patterns = [
        r"(?:weather|forecast|temperature|rain|hot|cold|warm|humid|windy|cloudy|sunny|snow|storm|umbrella|jacket)\b.*?\b(?:in|for|at|near)\s+([a-z][a-z .,'\-]{1,48}?)(?:\s+(?:today|tonight|tomorrow|this weekend|right now|currently|please))?[.?! ]*$",
        r"\b(?:in|for|at|near)\s+([a-z][a-z .,'\-]{1,48}?)\s+(?:weather|forecast|temperature|rain)\b",
    ]
    for pat in patterns:
        m = re.search(pat, norm)
        if not m:
            continue
        place = m.group(1).strip(" .!?,")
        for w in sorted(_TIME_WORDS, key=len, reverse=True):
            if place.endswith(" " + w):
                place = place[: -len(w)].strip()
        place = re.sub(r"^(the|my)\s+", "", place).strip()
        if place and place not in ("here", "home", "my location", "current location",
                                   "my area", "my place", "town", "city"):
            return place
    return None


def _remote_weather(place: str) -> tuple[str, str]:
    """(status, condition) for a named place via wttr.in, or ('', '') on failure."""
    from urllib.parse import quote
    query = quote(place, safe="")
    try:
        r = subprocess.run(
            ["curl", "-fsS", "--max-time", "6",
             f"https://wttr.in/{query}?format=%l|%t|%C|%w"],
            capture_output=True, text=True, timeout=8)
        raw = (r.stdout or "").strip()
    except Exception:
        return "", ""
    if not raw or "|" not in raw:
        return "", ""
    parts = [p.strip() for p in raw.split("|")]
    if len(parts) < 4 or not parts[1]:
        return "", ""
    loc, temp, cond, wind = parts[0], parts[1].lstrip("+"), parts[2], parts[3]
    temp = re.sub(r"°[CF]$", "", temp).strip()
    wind_num = (re.search(r"[\d.]+", wind or "") or ["?"])[0]
    status = f"{loc}  ·  Temp {temp}  ·  {cond}  ·  Wind {wind}"
    speak = f"In {loc}, it's {temp} degrees with {cond.lower()} and a {wind_num} mile per hour wind!"
    return status, speak


_DAY_NAMES = ("monday", "tuesday", "wednesday", "thursday", "friday",
              "saturday", "sunday")


def _fetch_forecast(place: str | None) -> dict | None:
    """Live 3-day + hourly forecast via wttr.in j1 (chance of rain included)."""
    from urllib.parse import quote
    query = quote(place, safe="") if place else ""
    try:
        r = subprocess.run(
            ["curl", "-fsS", "--max-time", "8", f"https://wttr.in/{query}?format=j1"],
            capture_output=True, text=True, timeout=10)
        data = json.loads(r.stdout) if r.returncode == 0 and r.stdout.strip() else None
    except Exception:
        return None
    if not data or not data.get("weather"):
        return None
    return data


def _forecast_place_name(data: dict, fallback: str) -> str:
    try:
        area = data["nearest_area"][0]
        name = area["areaName"][0]["value"]
        country = area["country"][0]["value"]
        if country and country.lower() not in ("united states of america",):
            return f"{name}, {country}"
        return name
    except (KeyError, IndexError, TypeError):
        return fallback or "here"


def _hour_label(t: str) -> str:
    try:
        h = int(t) // 100
    except (ValueError, TypeError):
        return ""
    if h == 0:
        return "midnight"
    if h == 12:
        return "noon"
    return f"{h - 12 if h > 12 else h} {'pm' if h >= 12 else 'am'}"


def _day_summary(day: dict, label: str, loc: str) -> tuple[str, str]:
    """(popup line, spoken sentence) for one forecast day, rain-first."""
    try:
        hi, lo = day["maxtempF"], day["mintempF"]
    except KeyError:
        return "", ""
    hourly = day.get("hourly") or []
    peak_rain, peak_t, peak_desc = 0, "", ""
    descs: dict[str, int] = {}
    for h in hourly:
        try:
            chance = int(h.get("chanceofrain") or 0)
        except (ValueError, TypeError):
            chance = 0
        desc = ""
        try:
            desc = h["weatherDesc"][0]["value"]
        except (KeyError, IndexError, TypeError):
            pass
        if desc:
            descs[desc] = descs.get(desc, 0) + 1
        if chance > peak_rain:
            peak_rain, peak_t = chance, _hour_label(h.get("time", ""))
            peak_desc = desc
    top_desc = max(descs, key=descs.get) if descs else ""
    if peak_rain >= 50:
        rain_speak = (f"Rain is likely — {peak_rain}% chance"
                      + (f" around {peak_t}" if peak_t else "") + ".")
        rain_line = f"Rain {peak_rain}%" + (f" ~{peak_t}" if peak_t else "")
    elif peak_rain >= 20:
        rain_speak = f"a {peak_rain}% chance of rain" + (f" around {peak_t}." if peak_t else ".")
        rain_line = f"Rain {peak_rain}%" + (f" ~{peak_t}" if peak_t else "")
    else:
        rain_speak, rain_line = "no rain expected.", "No rain"
    popup = f"{label} {loc}: {hi}°F / {lo}°F, {top_desc or '—'}, {rain_line}"
    if peak_rain >= 50:
        speak = f"{label} in {loc}: high {hi}, low {lo}. {rain_speak}"
    elif peak_rain >= 20:
        speak = f"{label} in {loc}: high {hi}, low {lo}, with {rain_speak}"
    else:
        speak = f"{label} in {loc}: high {hi}, low {lo}, {top_desc.lower() + ', ' if top_desc else ''}{rain_speak}"
    return popup, speak


def _handle_forecast(norm: str, place: str | None) -> bool:
    # AccuWeather 5-day when a key is configured, else wttr.in below.
    if _accu_conf()[0] and _handle_accu_forecast(norm, place):
        return True
    data = _fetch_forecast(place)
    loc = _forecast_place_name(data, place or "here") if data else (place or "here")
    if not data:
        addressed = _with_address(
            f"Sorry, I couldn't reach the forecast for {loc}.", force="Sir")
        _touch_interaction()
        _popup("Weather", addressed, timeout_ms=6000)
        _speak(addressed)
        return True
    days = data["weather"]
    today = date.today()

    def find_day(offset: int) -> dict | None:
        want = (today + timedelta(days=offset)).isoformat()
        return next((d for d in days if d.get("date") == want), None)

    popups, speaks = [], []
    if "weekend" in norm or ("saturday" in norm and "sunday" in norm):
        lines = []
        for d in days:
            try:
                wd = datetime.strptime(d["date"], "%Y-%m-%d").strftime("%A")
            except (ValueError, KeyError):
                continue
            if wd in ("Saturday", "Sunday"):
                p, s = _day_summary(d, wd, loc)
                if p:
                    lines.append((p, s))
        if not lines:
            addressed = _with_address(
                f"The weekend falls outside my 3-day forecast for {loc}.", force="Sir")
            _touch_interaction()
            _popup("Weather", addressed, timeout_ms=6000)
            _speak(addressed)
            return True
        popups = [p for p, _ in lines]
        speaks = " ".join(s for _, s in lines)
    elif "tonight" in norm or "this evening" in norm:
        day = find_day(0)
        if not day:
            return False
        evening = [h for h in day.get("hourly", [])
                   if str(h.get("time", "")).isdigit() and int(h["time"]) >= 1800]
        peak = max((int(h.get("chanceofrain") or 0) for h in evening), default=0)
        temps = [h.get("tempF") for h in evening if h.get("tempF")]
        desc = ""
        try:
            desc = evening[0]["weatherDesc"][0]["value"] if evening else ""
        except (KeyError, IndexError, TypeError):
            pass
        popups = [f"Tonight {loc}: {temps[0] if temps else '?'}°F, {desc or '—'}, rain {peak}%"]
        speaks = (f"Tonight in {loc}: {temps[0] + ' degrees' if temps else ''}"
                  f"{', ' + desc.lower() if desc else ''}, "
                  f"{f'{peak}% chance of rain.' if peak >= 20 else 'no rain expected.'}")
    else:
        named = next((d for d in _DAY_NAMES if d in norm), "")
        if named:
            idx = (_DAY_NAMES.index(named) - today.weekday()) % 7
            label = named.capitalize()
        elif "tomorrow" in norm or "day after" in norm:
            idx = 2 if "day after" in norm else 1
            label = "Day after tomorrow" if idx == 2 else "Tomorrow"
        else:
            idx, label = 0, "Today"
        day = find_day(idx)
        if not day:
            addressed = _with_address(
                f"I can only see 3 days out for {loc}, Sir.", force="Sir")
            _touch_interaction()
            _popup("Weather", addressed, timeout_ms=6000)
            _speak(addressed)
            return True
        p, s = _day_summary(day, label, loc)
        popups, speaks = [p], s

    is_start = _is_conversation_start()
    spoken = _with_address(speaks, is_start=is_start)
    _touch_interaction()
    body = "\n".join(popups) + "\nvia wttr.in"
    if shutil.which("omarchy-notification-send"):
        cmd = ["omarchy-notification-send", "-u", "low", "-t", "10000",
               "Weather", body, "--exec", "omarchy-shell", "shell",
               "toggle", "omarchy.weather"]
        try:
            subprocess.run(cmd, check=False, timeout=5)
        except Exception:
            _popup("Weather", body, timeout_ms=10000)
    else:
        _popup("Weather", body, timeout_ms=10000)
    _speak(spoken)
    return True


def _wants_forecast(norm: str) -> bool:
    if re.search(r"\b(tomorrow|tonight|this evening|weekend|forecast|day after|"
                 r"will it rain|going to rain|chance of rain|"
                 r"monday|tuesday|wednesday|thursday|friday|saturday|sunday)\b", norm):
        return True
    return bool(re.search(r"\brain\b", norm))


# --- accuweather: current + outdoor analytics + indices ----------------------
# Needs a free key in ~/.config/voice-assistant/weather.conf:
#   ACCUWEATHER_API_KEY=...
# Without it, weather silently stays on the wttr.in path below.
WEATHER_CONF = Path.home() / ".config/voice-assistant/weather.conf"
_ACCU_BASE = "https://dataservice.accuweather.com"
_ACCU_KEYS_FILE = STATE_DIR / "accu_keys.json"


def _accu_conf() -> tuple[str, str]:
    key, loc = "", "Matawan"
    try:
        for line in WEATHER_CONF.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, _, v = line.partition("=")
            k, v = k.strip().upper(), v.strip().strip("'\"")
            if k == "ACCUWEATHER_API_KEY" and v and not v.startswith("..."):
                key = v
            elif k == "ACCU_LOCATION" and v:
                loc = v
    except OSError:
        pass
    return key, loc


def _accu_get(path: str, key: str) -> tuple[object | None, int]:
    """(parsed JSON, http status). Uses curl like the rest of this file."""
    from urllib.parse import quote
    try:
        r = subprocess.run(
            ["curl", "-fsS", "--max-time", "10", "-w", "\n%{http_code}",
             f"{_ACCU_BASE}{path}{'&' if '?' in path else '?'}apikey={quote(key)}"],
            capture_output=True, text=True, timeout=12)
        body, _, code = (r.stdout or "").rpartition("\n")
        try:
            return json.loads(body) if body.strip() else (None, int(code or 0))
        except ValueError:
            return None, int(code or 0)
    except Exception:
        return None, 0


def _accu_load_keys() -> dict:
    try:
        data = json.loads(_ACCU_KEYS_FILE.read_text())
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def _accu_loc_key(place: str, api_key: str) -> tuple[str, str]:
    """(locationKey, display name), cached per place."""
    from urllib.parse import quote
    cache = _accu_load_keys()
    if place.lower() in cache:
        k, n = cache[place.lower()]
        return k, n
    data, _ = _accu_get(f"/locations/v1/cities/search?q={quote(place)}", api_key)
    if isinstance(data, list) and data:
        loc_key = str(data[0].get("Key", ""))
        name = str(data[0].get("LocalizedName", place))
        if loc_key:
            cache[place.lower()] = (loc_key, name)
            try:
                STATE_DIR.mkdir(parents=True, exist_ok=True)
                _ACCU_KEYS_FILE.write_text(json.dumps(cache))
            except OSError:
                pass
            return loc_key, name
    return "", place


def _accu_outdoor_window(hours: list[dict]) -> str:
    """Best outdoor window from 12h data: low rain + comfy temps."""
    good = []
    for h in hours:
        try:
            pop = int(h.get("PrecipitationProbability") or 0)
            t = float(h.get("Temperature", {}).get("Value", 0))
            dt = h.get("DateTime", "")
        except (ValueError, TypeError, AttributeError):
            continue
        label = ""
        m = re.search(r"T(\d{2}):", dt)
        if m:
            hr = int(m.group(1))
            label = f"{hr - 12 if hr > 12 else (12 if hr == 0 else hr)}{'pm' if hr >= 12 else 'am'}"
        if pop < 20 and 55 <= t <= 88:
            good.append(label)
    if not good:
        return ""
    # Collapse consecutive labels into "2pm to 5pm".
    return f"{good[0]} to {good[-1]}" if len(good) > 1 else good[0]


def _handle_accu_current(place: str | None) -> bool:
    api_key, default_loc = _accu_conf()
    if not api_key:
        return False
    loc_key, name = _accu_loc_key(place or default_loc, api_key)
    if not loc_key:
        return False
    cur, code = _accu_get(f"/currentconditions/v1/{loc_key}?details=true", api_key)
    if code == 401:
        _confirm("My AccuWeather key was rejected — check weather.conf.")
        return True
    if not isinstance(cur, list) or not cur:
        return False  # fall back to wttr.in
    c = cur[0]
    try:
        temp = round(float(c["Temperature"]["Imperial"]["Value"]))
        feels = round(float(c["RealFeelTemperature"]["Imperial"]["Value"]))
        humid = int(c.get("RelativeHumidity", -1))
        wind = round(float(c["Wind"]["Speed"]["Imperial"]["Value"]))
        uv = c.get("UVIndex", "?")
        cond = str(c.get("WeatherText", ""))
    except (KeyError, TypeError, ValueError):
        return False
    hours, _ = _accu_get(f"/forecasts/v1/hourly/12hour/{loc_key}?metric=false", api_key)
    hours = hours if isinstance(hours, list) else []
    peak_pop, peak_t = 0, ""
    for h in hours:
        try:
            pop = int(h.get("PrecipitationProbability") or 0)
            if pop > peak_pop:
                m = re.search(r"T(\d{2}):", str(h.get("DateTime", "")))
                hr = int(m.group(1)) if m else -1
                peak_pop = pop
                peak_t = (f"{hr - 12 if hr > 12 else (12 if hr == 0 else hr)}"
                          f"{'pm' if hr >= 12 else 'am'}") if hr >= 0 else ""
        except (ValueError, TypeError):
            continue
    window = _accu_outdoor_window(hours)
    idx, _ = _accu_get(f"/indices/v1/daily/1day/{loc_key}", api_key)
    outdoor_idx = []
    if isinstance(idx, list):
        for e in idx:
            nm = str(e.get("Name", ""))
            if re.search(r"run|bik|outdoor|golf|hik|tennis|dog walk|mosquito|scoot", nm, re.I):
                outdoor_idx.append(f"{nm}: {e.get('Category', '')}")
    lines = [f"{name}: {temp}F, {cond}, feels {feels}F",
             f"Humidity {humid}% · Wind {wind} mph · UV {uv}"]
    lines.append(f"Rain peak {peak_pop}%{(' ~' + peak_t) if peak_t else ''} (12h)")
    lines.append(f"Outdoor window: {window}" if window else "Outdoor window: none clean in 12h")
    lines += outdoor_idx[:6]
    body = "\n".join(lines) + "\nvia AccuWeather"
    speak = (f"It's {temp} in {name}, {cond.lower()}, feels like {feels}. "
             f"{('Best outdoor window ' + window + '.') if window else 'No clean outdoor window in 12 hours.'}")
    is_start = _is_conversation_start()
    _touch_interaction()
    _popup("Weather", body[:900], timeout_ms=10000)
    _speak(_with_address(speak[:280], is_start=is_start))
    _touch_interaction()
    return True


def _handle_accu_forecast(norm: str, place: str | None) -> bool:
    api_key, default_loc = _accu_conf()
    if not api_key:
        return False
    loc_key, name = _accu_loc_key(place or default_loc, api_key)
    if not loc_key:
        return False
    data, code = _accu_get(f"/forecasts/v1/daily/5day/{loc_key}?details=true&metric=false", api_key)
    if code == 401:
        _confirm("My AccuWeather key was rejected — check weather.conf.")
        return True
    days = data.get("DailyForecasts", []) if isinstance(data, dict) else []
    if not days:
        return False
    today = date.today()

    def pick(offset: int) -> dict | None:
        want = (today + timedelta(days=offset)).isoformat()
        return next((d for d in days if str(d.get("Date", ""))[:10] == want), days[0] if days else None)

    if "weekend" in norm or ("saturday" in norm and "sunday" in norm):
        wanted = [d for d in days
                  if datetime.strptime(str(d["Date"])[:10], "%Y-%m-%d").strftime("%a") in ("Sat", "Sun")]
        offs = None
    else:
        named = next((d for d in _DAY_NAMES if d in norm), "")
        if named:
            off = (_DAY_NAMES.index(named) - today.weekday()) % 7
        elif "day after" in norm:
            off = 2
        elif "tomorrow" in norm:
            off = 1
        else:
            off = 0
        wanted = [pick(off)] if pick(off) else []
        offs = off
    if not wanted or offs is not None and offs > 4:
        _confirm(f"I can only see 5 days out for {name}.")
        return True
    pops, speaks = [], []
    for d in wanted:
        try:
            lbl = datetime.strptime(str(d["Date"])[:10], "%Y-%m-%d").strftime("%A")
            hi = round(float(d["Temperature"]["Maximum"]["Value"]))
            lo = round(float(d["Temperature"]["Minimum"]["Value"]))
            phrase = str(d.get("Day", {}).get("IconPhrase", ""))
            rain = int(d.get("Day", {}).get("PrecipitationProbability") or 0)
        except (KeyError, TypeError, ValueError):
            continue
        pops.append(f"{lbl} {name}: {hi}/{lo}F, {phrase}, rain {rain}%")
        speaks.append(f"{lbl}: {hi} over {lo}, {phrase.lower()}, {rain}% rain.")
    if not pops:
        return False
    is_start = _is_conversation_start()
    _touch_interaction()
    _popup("Weather", "\n".join(pops)[:900] + "\nvia AccuWeather", timeout_ms=10000)
    _speak(_with_address(" ".join(speaks)[:280], is_start=is_start))
    _touch_interaction()
    return True


def _handle_weather(norm: str = "") -> bool:
    place = _extract_place(norm) if norm else None
    # AccuWeather first when a key is configured (outdoor analytics);
    # otherwise the existing wttr.in path below.
    if _accu_conf()[0] and _handle_accu_current(place):
        return True
    if norm and _wants_forecast(norm):
        return _handle_forecast(norm, place)
    if place:
        status, speak = _remote_weather(place)
        if not status:
            addressed = _with_address(f"Sorry, I couldn't find the weather for {place}.", force="Sir")
            _touch_interaction()
            _popup("Weather", addressed, timeout_ms=6000)
            _speak(addressed)
            return True
        icon = ""
    else:
        status = _run(["omarchy-weather-status"])
        if not status or "unavailable" in status.lower():
            _confirm("Sorry, I couldn't reach the weather service.", glyph="")
            return True
        icon = _run(["omarchy-weather-icon"]) or ""
        speak = _speakable_weather(status)
    is_start = _is_conversation_start()
    spoken = _with_address(speak, is_start=is_start)
    _touch_interaction()
    # Written response in popup + optional panel on click.
    if shutil.which("omarchy-notification-send"):
        cmd = ["omarchy-notification-send", "-u", "low", "-t", "9000"]
        if icon:
            cmd += ["-g", icon]
        cmd += ["Weather", f"{status}\nvia wttr.in", "--exec", "omarchy-shell", "shell", "toggle", "omarchy.weather"]
        try:
            subprocess.run(cmd, check=False, timeout=5)
        except Exception:
            _popup("Weather", status, glyph=icon)
    else:
        _popup("Weather", status, glyph=icon)
    _speak(spoken)
    return True


# --- timers: named, pausable, queryable (own systemd units, no clashes) -----
TIMERS_FILE = STATE_DIR / "timers.json"


def _load_timers() -> dict:
    try:
        data = json.loads(TIMERS_FILE.read_text())
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def _save_timers(data: dict) -> None:
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        TIMERS_FILE.write_text(json.dumps(data))
    except OSError:
        pass


def _fmt_dur(secs: float) -> str:
    secs = max(0, int(secs))
    h, r = divmod(secs, 3600)
    m, s = divmod(r, 60)
    if h:
        return f"{h}h {m}m"
    if m:
        return f"{m}m {s}s" if s and m < 5 else f"{m} minute{'s' if m != 1 else ''}"
    return f"{s} second{'s' if s != 1 else ''}"


def _parse_duration(norm: str) -> tuple[float | None, str]:
    """(seconds, label-remainder) from '10 minutes for pizza' etc."""
    m = re.search(r"(\d+(?:\.\d+)?)\s*(seconds?|secs?|s|minutes?|mins?|m|hours?|hrs?|h)\b(.*)", norm)
    if not m:
        return None, ""
    n = float(m.group(1))
    unit = m.group(2).lower()
    mult = 3600 if unit.startswith("h") else 60 if unit.startswith("m") else 1
    rest = (m.group(3) or "").strip(" ,.!-")
    rest = re.sub(r"^(for|called|named|about|to|to remind me (to|about)?)\s+", "", rest).strip()
    return n * mult, rest


def _timer_fire(label: str) -> list[str]:
    return ["omarchy-notification-send", "-u", "critical", "Timer",
            f"{label} — time's up!"]


def _handle_timers(norm: str) -> bool:
    timers = _load_timers()
    now = time.time()
    # Drop long-dead running timers from the list (fired already).
    timers = {k: v for k, v in timers.items()
              if v.get("state") != "running" or v.get("ends", 0) > now - 3600}
    msg = norm

    def pick(label_hint: str = "") -> tuple[str, dict] | tuple[None, None]:
        cands = [(k, v) for k, v in timers.items() if v.get("state") in ("running", "paused")]
        if label_hint:
            hit = [(k, v) for k, v in cands if label_hint in v.get("label", "").lower()]
            if hit:
                return hit[0]
        running = [(k, v) for k, v in cands if v.get("state") == "running"]
        if running:
            return max(running, key=lambda kv: kv[1].get("ends", 0))
        return cands[0] if cands else (None, None)

    # Cancel / stop.
    if re.search(r"\b(cancel|stop|delete|clear|kill).{0,10}timer|\btimer.{0,10}(cancel|stop|delete|clear|off)\b", norm):
        tid, t = pick()
        if not t:
            _confirm("No active timers.")
            return True
        subprocess.run(["systemctl", "--user", "stop", f"voice-timer-{tid}.timer"],
                       capture_output=True, timeout=5)
        timers.pop(tid, None)
        _save_timers(timers)
        _confirm(f"Timer {t.get('label', '')} cancelled.")
        return True
    # Pause.
    if re.search(r"\bpause.{0,10}timer|\btimer.{0,10}pause\b", norm):
        hint = re.sub(r".*timer (called|named|for) ", "", norm) \
            if re.search(r"timer (called|named|for) ", norm) else ""
        tid, t = pick(hint.strip())
        if not t or t.get("state") != "running":
            _confirm("No running timer to pause.")
            return True
        remaining = max(0, t["ends"] - now)
        subprocess.run(["systemctl", "--user", "stop", f"voice-timer-{tid}.timer"],
                       capture_output=True, timeout=5)
        t["state"], t["remaining"] = "paused", remaining
        _save_timers(timers)
        _confirm(f"Paused with {_fmt_dur(remaining)} left.")
        return True
    # Resume.
    if re.search(r"\b(resume|continue|unpause).{0,10}timer|\btimer.{0,10}(resume|continue)\b", norm):
        paused = [(k, v) for k, v in timers.items() if v.get("state") == "paused"]
        if not paused:
            _confirm("No paused timer to resume.")
            return True
        tid, t = paused[0]
        secs = max(1, int(t.get("remaining", 60)))
        subprocess.run(["systemd-run", "--user", f"--unit=voice-timer-{tid}",
                        f"--on-active={secs}s", "--timer-property=AccuracySec=5s",
                        *_timer_fire(t.get("label", "Timer"))],
                       capture_output=True, timeout=8)
        t["state"], t["ends"] = "running", now + secs
        t.pop("remaining", None)
        _save_timers(timers)
        _confirm(f"Resumed with {_fmt_dur(secs)} left.")
        return True
    # Time left / show.
    if re.search(r"\b(how much time|time left|time remaining|check|show|status).{0,12}timer|\btimer.{0,12}(left|remaining|status|show)\b", norm):
        live = [(v.get("label", "Timer"),
                 v["ends"] - now if v.get("state") == "running" else v.get("remaining", 0),
                 v.get("state"))
                for v in timers.values() if v.get("state") in ("running", "paused")]
        if not live:
            _confirm("No active timers.")
            return True
        lines = [f"{lbl}: {_fmt_dur(rem)} left ({st})" for lbl, rem, st in live]
        body = "\n".join(lines)
        _touch_interaction()
        _popup("Timers", body, timeout_ms=8000)
        first, rem, _ = live[0]
        extra = f", plus {len(live) - 1} more" if len(live) > 1 else ""
        _speak(_with_address(f"{_fmt_dur(rem)} left on {first}{extra}.",
                             is_start=_is_conversation_start()))
        _touch_interaction()
        return True
    # Set.
    if re.search(r"\btimer\b", norm):
        secs, label = _parse_duration(norm)
        if not secs or secs < 1 or secs > 12 * 3600:
            _confirm("Sorry — tell me how long, like set a timer for 10 minutes for pizza.")
            return True
        label = label or "Timer"
        tid = re.sub(r"\W+", "", label.lower())[:12] + str(int(now) % 100000)
        subprocess.run(["systemd-run", "--user", f"--unit=voice-timer-{tid}",
                        f"--on-active={int(secs)}s", "--timer-property=AccuracySec=5s",
                        *_timer_fire(label)], capture_output=True, timeout=8)
        timers[tid] = {"label": label, "total": secs, "ends": now + secs, "state": "running"}
        _save_timers(timers)
        _confirm(f"Timer set for {_fmt_dur(secs)}: {label}.")
        return True
    return False


# --- notes: quick spoken notebook -------------------------------------------
NOTES_FILE = STATE_DIR / "notes.md"

# "log chest day" / "log oil change" / "log 12 bucks" auto-tag the entry.
_LOG_TAGS = (
    ("#gym", r"\b(gym|workout|chest|back day|leg day|legs|shoulder|arm day|cardio|run|ran|jog|scooter ride|crunch)\b"),
    ("#car", r"\b(oil|tire|tyre|brake|mini|mercedes|gl450|clubman|repair|mechanic|inspection|alignment)\b"),
    ("#money", r"\$|\b(dollar|dollars|bucks|spent|paid|cost|chipotle|groceries|gas)\b"),
    ("#school", r"\b(exam|quiz|class|homework|assignment|study|studied|njit|it20[12]|lecture|lab)\b"),
)


def _log_tag(norm: str) -> str:
    for tag, pat in _LOG_TAGS:
        if re.search(pat, norm):
            return tag + " "
    return ""


def _handle_notes(norm: str) -> bool:
    if re.search(r"\b(clear|delete|forget)( my| all)? notes?\b", norm):
        try:
            NOTES_FILE.unlink(missing_ok=True)
        except OSError:
            pass
        _confirm("Notes cleared.")
        return True
    m = re.search(r"^(?:please\s+)?log\s+(.+?)[.! ]*$", norm)
    if m and m.group(1).strip() not in ("out", "in", "off", "on"):
        text = m.group(1).strip()[:240]
        if text:
            try:
                STATE_DIR.mkdir(parents=True, exist_ok=True)
                with NOTES_FILE.open("a") as f:
                    f.write(f"- [{datetime.now():%Y-%m-%d %H:%M}] {_log_tag(norm)}{text}\n")
            except OSError:
                pass
            _confirm("Logged.")
            return True
    m = re.search(r"\bshow\b.{0,15}\b(gym|car|money|school)\b.{0,10}\b(logs?|notes?|entries)\b|"
                  r"\b(gym|car|money|school)\b.{0,10}\b(logs?)\b", norm)
    if m:
        tag = "#" + next(g for g in m.groups() if g)
        try:
            lines = [l.strip() for l in NOTES_FILE.read_text().splitlines()
                     if l.strip() and tag in l]
        except OSError:
            lines = []
        if not lines:
            _confirm(f"No {tag[1:]} entries yet.")
            return True
        body = "\n".join(lines[-8:])
        _touch_interaction()
        _popup(f"{tag} log", body, timeout_ms=9000)
        _speak(_with_address(f"{len(lines)} {tag[1:]} entries. Latest: {lines[-1][-120:]}.",
                             is_start=_is_conversation_start()))
        _touch_interaction()
        return True
    m = re.search(r"\btake a (quick )?note:?\s+(.+)|note (that|to self:?)\s+(.+)|write (this|that) down:?\s+(.+)", norm)
    if m:
        text = next(g for g in m.groups()[1:] if g) if m.groups()[0] else (m.group(2) or "")
        text = (text or "").strip()[:240]
        if not text:
            return False
        try:
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            with NOTES_FILE.open("a") as f:
                f.write(f"- [{datetime.now():%Y-%m-%d %H:%M}] {text}\n")
        except OSError:
            pass
        _confirm("Noted.")
        return True
    if re.search(r"\b(show|read|list|what are)( my)? notes?\b", norm):
        try:
            lines = [l.strip() for l in NOTES_FILE.read_text().splitlines() if l.strip()]
        except OSError:
            lines = []
        if not lines:
            _confirm("No notes yet.")
            return True
        body = "\n".join(lines[-8:])
        _touch_interaction()
        _popup("Notes", body, timeout_ms=9000)
        latest = re.sub(r"^-\s*\[.*?\]\s*", "", lines[-1])[:120]
        extra = f" Plus {len(lines) - 1} more." if len(lines) > 1 else ""
        _speak(_with_address(f"{len(lines)} note{'s' if len(lines) != 1 else ''}. Latest: {latest}.{extra}",
                             is_start=_is_conversation_start()))
        _touch_interaction()
        return True
    return False


# --- answers: safe local calculator + conversions, spell-out ------------------
import ast as _ast

_CONVERT = {
    # (from-names, to-name, factor|func) — factor multiplies, func maps value.
    "fahrenheit": (("fahrenheit", "fahrenheits", "f"), "celsius", lambda v: (v - 32) * 5 / 9),
    "celsius": (("celsius", "c"), "fahrenheit", lambda v: v * 9 / 5 + 32),
    "miles": (("miles", "mile", "mi"), "kilometers", 1.60934),
    "kilometers": (("kilometers", "kilometer", "km", "kms"), "miles", 1 / 1.60934),
    "feet": (("feet", "foot", "ft"), "meters", 0.3048),
    "meters": (("meters", "meter", "m"), "feet", 3.28084),
    "inches": (("inches", "inch", "in"), "centimeters", 2.54),
    "centimeters": (("centimeters", "centimeter", "cm"), "inches", 1 / 2.54),
    "pounds": (("pounds", "pound", "lbs", "lb"), "kilograms", 0.453592),
    "kilograms": (("kilograms", "kilogram", "kg"), "pounds", 2.20462),
    "ounces": (("ounces", "ounce", "oz"), "grams", 28.3495),
    "grams": (("grams", "gram", "g"), "ounces", 1 / 28.3495),
    "gallons": (("gallons", "gallon", "gal"), "liters", 3.78541),
    "liters": (("liters", "liter", "l"), "gallons", 1 / 3.78541),
    "mph": (("mph", "miles per hour"), "kmh", 1.60934),
    "kmh": (("kmh", "kph", "kilometers per hour"), "mph", 1 / 1.60934),
}
_UNIT_ALIASES: dict[str, str] = {}
for _canon, (_names, _to, _fn) in _CONVERT.items():
    for _n in _names:
        _UNIT_ALIASES[_n] = _canon


def _num_fmt(v: float) -> str:
    if abs(v - round(v)) < 1e-9:
        return str(int(round(v)))
    return f"{v:.2f}".rstrip("0").rstrip(".")


def _safe_eval(expr: str) -> float | None:
    """Arithmetic only: numbers, +-*/%**(), unary minus. No names, no calls."""
    try:
        tree = _ast.parse(expr, mode="eval")
    except SyntaxError:
        return None
    allowed = (_ast.Expression, _ast.BinOp, _ast.UnaryOp, _ast.Constant,
               _ast.Add, _ast.Sub, _ast.Mult, _ast.Div, _ast.Mod, _ast.Pow,
               _ast.USub, _ast.UAdd, _ast.FloorDiv)
    for node in _ast.walk(tree):
        if not isinstance(node, allowed):
            return None
        if isinstance(node, _ast.Constant) and not isinstance(node.value, (int, float)):
            return None
    try:
        val = eval(compile(tree, "<calc>", "eval"), {"__builtins__": {}}, {})  # noqa: S307
    except Exception:
        return None
    return float(val) if isinstance(val, (int, float)) else None


def _handle_calc(norm: str) -> bool:
    # Conversions: "convert 150 fahrenheit to celsius", "how many miles is 10 kilometers".
    conv = re.search(r"convert\s+([\d.]+)\s*([a-z /]+?)\s+to\s+([a-z /]+)", norm)
    howmany = None if conv else re.search(r"how many\s+([a-z /]+?)\s+(?:is|are)\s+([\d.]+)\s*([a-z /]+)", norm)
    if conv or howmany:
        if conv:
            val, u_from, u_to = float(conv.group(1)), conv.group(2).strip(), conv.group(3).strip()
        else:
            u_to, val, u_from = howmany.group(1).strip(), float(howmany.group(2)), howmany.group(3).strip()
        key = _UNIT_ALIASES.get(u_from) or _UNIT_ALIASES.get(u_from.rstrip("s"), "")
        if key:
            _, to_name, fn = _CONVERT[key]
            if u_to == to_name or u_to.rstrip("s") == to_name or u_to in to_name:
                out = fn(val) if callable(fn) else val * fn
                _confirm(f"{_num_fmt(val)} {u_from} is {_num_fmt(out)} {to_name}.")
                return True
        # Unknown units fall through to web search below.
    else:
        # Tip: "18% tip on $45" / "18 percent of 45".
        m = re.search(r"(\d+(?:\.\d+)?)\s*%?(?: percent)?\s*(?:tip|of|on)\s*\$?\s*(\d+(?:\.\d+)?)", norm)
        if m and ("tip" in norm or "percent" in norm or "%" in norm):
            tip, total = float(m.group(1)), float(m.group(2))
            _confirm(f"{_num_fmt(tip)} percent of {_num_fmt(total)} is {_num_fmt(total * tip / 100)}.")
            return True
        # Plain arithmetic: "what is 12 plus 30 divided by 2" / "calculate 8*7".
        m = re.search(r"(?:what is|what'?s|calculate|compute|solve|math|plus|minus|times|divided|over)\b(.*)", norm)
        if m:
            expr = m.group(1).strip()
            expr = re.sub(r"\b(plus|add)\b", "+", expr)
            expr = re.sub(r"\b(minus|subtract|less)\b", "-", expr)
            expr = re.sub(r"\b(times|multiplied by|x)\b", "*", expr)
            expr = re.sub(r"\b(divided by|divide by|over|div)\b", "/", expr)
            expr = re.sub(r"[$,%?]", "", expr).strip()
            if re.fullmatch(r"[\d\s+\-*/%().]+", expr) and re.search(r"\d", expr):
                val = _safe_eval(expr)
                if val is not None:
                    _confirm(f"That's {_num_fmt(val)}.")
                    return True
    return False


def _handle_spell(norm: str) -> bool:
    m = re.search(r"\bspell\s+([a-z]+)\b", norm)
    if not m:
        return False
    word = m.group(1)
    if word in ("that", "it", "this", "me", "out"):
        return False
    spelled = "-".join(word.upper())
    _touch_interaction()
    _popup("Spelling", f"{word}: {spelled}", timeout_ms=8000)
    _speak(_with_address(f"{word}: {spelled}.", is_start=_is_conversation_start()))
    _touch_interaction()
    return True


_BROWSER_CLASS_CMDS = (
    ("firefox", ("firefox",)),
    ("librewolf", ("librewolf",)),
    ("zen", ("zen-browser", "zen")),
    ("brave", ("brave", "brave-browser")),
    ("chromium", ("chromium", "chromium-browser")),
    ("google-chrome", ("google-chrome-stable", "google-chrome")),
    ("chrome", ("google-chrome-stable", "google-chrome", "chromium")),
    ("microsoft-edge", ("microsoft-edge-stable", "microsoft-edge")),
    ("vivaldi", ("vivaldi-stable", "vivaldi")),
)


def _active_workspace_id() -> int | None:
    try:
        r = subprocess.run(["hyprctl", "-j", "activeworkspace"], capture_output=True,
                           text=True, timeout=3)
        if r.returncode == 0:
            data = json.loads(r.stdout or "{}")
            if isinstance(data, dict) and "id" in data:
                return int(data["id"])
    except Exception:
        pass
    return None


def _browser_on_current_workspace() -> str | None:
    """Return a browser binary to reuse on the active workspace, or None."""
    ws = _active_workspace_id()
    if ws is None:
        return None
    try:
        clients = _hypr_clients()
    except Exception:
        return None
    for c in clients:
        if c.get("hidden"):
            continue
        try:
            cws = (c.get("workspace") or {}).get("id")
            if cws is None or int(cws) != ws:
                continue
        except Exception:
            continue
        cls = " ".join([
            str(c.get("class") or ""),
            str(c.get("initialClass") or ""),
            str(c.get("title") or ""),
        ]).lower()
        for needle, cmds in _BROWSER_CLASS_CMDS:
            if needle in cls:
                for cmd in cmds:
                    if shutil.which(cmd):
                        return cmd
    return None


def _open_url(url: str, *, prefer_current_workspace: bool = True) -> bool:
    if REHEARSAL:
        print(f"URL\t{url}")
        return True
    if prefer_current_workspace:
        browser = _browser_on_current_workspace()
        if browser:
            try:
                # Reuse existing browser session/window (opens as a tab there).
                subprocess.Popen([browser, url], stdin=subprocess.DEVNULL,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                 start_new_session=True)
                return True
            except Exception:
                pass
    for cmd, argv in (
        ("firefox", ["firefox", "--new-window", url]),
        ("chromium", ["chromium", "--new-window", url]),
        ("google-chrome-stable", ["google-chrome-stable", "--new-window", url]),
        ("google-chrome", ["google-chrome", "--new-window", url]),
        ("brave", ["brave", "--new-window", url]),
    ):
        if shutil.which(cmd):
            try:
                subprocess.Popen(argv, stdin=subprocess.DEVNULL,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                 start_new_session=True)
                return True
            except Exception:
                pass
    if shutil.which("xdg-open"):
        try:
            subprocess.Popen(["xdg-open", url], stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
            return True
        except Exception:
            pass
    return False


def _handle_translate(norm: str) -> bool:
    """Local translation. Never opens Google Translate or any remote page."""
    phrase = lang = ""
    m = re.search(r"how do you say\s+[\"']?(.+?)[\"']?\s+in\s+([a-z]+)", norm)
    if m:
        phrase, lang = m.group(1), m.group(2)
    else:
        m = re.search(r"translate\s+[\"']?(.+?)[\"']?\s+(?:to|into)\s+([a-z]+)", norm)
        if m:
            phrase, lang = m.group(1), m.group(2)
        else:
            m = re.search(r"\btranslate\b.*?\b(?:to|into)\s+([a-z]+)\s*:?\s*(.+)", norm)
            if m:
                lang, phrase = m.group(1), m.group(2)
    phrase = (phrase or "").strip(" ,.!?\"'")
    lang = (lang or "").strip()
    if not phrase or not lang:
        return False
    if phrase in ("that", "this", "it") or len(lang) < 3:
        return False
    helper = Path.home() / ".local/bin/local-voice-translate"
    if not (helper.is_file() and os.access(helper, os.X_OK)):
        _confirm("Local translation isn't installed — run install.sh.")
        return True
    try:
        proc = subprocess.run([str(helper), phrase, lang], capture_output=True,
                              text=True, timeout=30)
    except Exception as exc:  # noqa: BLE001
        _confirm(f"Translation failed: {exc}"[:160])
        return True
    out = (proc.stdout or "").strip()
    if proc.returncode != 0 or not out:
        why = (proc.stderr or "").strip().splitlines()
        detail = why[-1][:120] if why else "no engine answered"
        _touch_interaction()
        _popup("Translation", detail, timeout_ms=8000)
        _speak(_with_address("Sorry, no local translator answered that.",
                             is_start=_is_conversation_start()))
        _touch_interaction()
        return True
    pretty = lang.title()
    _touch_interaction()
    _popup("Translation", f"{phrase} → {pretty}:\n{out}"[:800], timeout_ms=9000)
    _speak(_with_address(f"{phrase} in {pretty}: {out}"[:280],
                         is_start=_is_conversation_start()))
    _touch_interaction()
    return True


def _handle_web(norm: str) -> bool:
    from urllib.parse import quote_plus
    # Direct YouTube (incl. graceful playlist limit).
    if re.search(r"\byoutube\b", norm) and not re.search(r"\b(search|for|play)\b.*\b(youtube|video)\b", norm):
        if _open_url("https://www.youtube.com"):
            _confirm("YouTube is open.")
            return True
    # "Play my favorite playlist" — offline honesty: open YouTube, say the limit.
    if re.search(r"\bplaylist\b", norm):
        if _open_url("https://www.youtube.com"):
            _confirm("YouTube is open — I can't reach your playlists offline, Sir.")
            return True
    # General web search: open browser for quick lookup, unless the user asked
    # to be told/summarized (that becomes an AI+web answer handled elsewhere).
    m = re.search(r"\bsearch (?:the web )?(?:for )?(.+)|google (.+)|look up (.+)|who won (.+)|define (\w+)\b", norm)
    if m:
        if _WANTS_SUMMARY.search(norm):
            return False
        q = next((g for g in m.groups() if g), "").strip()[:160]
        if _open_url(f"https://www.bing.com/search?q={quote_plus(q)}"):
            _confirm(f"I opened results for {q[:60]}.")
            return True
        _confirm("Sorry, no browser to open that with.")
        return True
    return False


# --- windows by name, clipboard aloud, screenshot, dictation ------------------
WINDOW_HINTS = {
    "browser": ("firefox", "chromium", "chrome"),
    "terminal": ("kitty", "alacritty", "foot", "ghostty", "wezterm"),
    "editor": ("code", "vscode", "neovim", "vim", "emacs", "zed", "sublime"),
    "code editor": ("code", "vscode", "neovim", "vim", "zed"),
    "files": ("dolphin", "nautilus", "thunar"),
    "file manager": ("dolphin", "nautilus", "thunar"),
    "music": ("spotify",),
    "mail": ("thunderbird", "evolution"),
}


def _hypr_clients() -> list[dict]:
    try:
        r = subprocess.run(["hyprctl", "-j", "clients"], capture_output=True,
                           text=True, timeout=5)
        data = json.loads(r.stdout) if r.returncode == 0 else []
        return data if isinstance(data, list) else []
    except Exception:
        return []


def _find_window(hint: str) -> dict | None:
    hint = hint.strip().lower()
    aliases = WINDOW_HINTS.get(hint, ())
    clients = [c for c in _hypr_clients() if not c.get("hidden")]
    if not clients:
        return None
    scored = []
    for c in clients:
        hay = " ".join(str(c.get(k) or "") for k in
                       ("class", "initialClass", "title", "initialTitle")).lower()
        if hint and hint not in hay and not any(a in hay for a in aliases):
            continue
        scored.append((c.get("focusHistoryID", 999), c))
    if not scored:
        return None
    scored.sort(key=lambda t: t[0])
    return scored[0][1]


def _handle_windows(norm: str) -> bool:
    m = re.search(r"\bclose\s+(?:my\s+|the\s+)?(.+?)(?:\s+window|\s+app|\s+browser)?[.! ]*$", norm)
    if m and re.search(r"\bclose\b", norm):
        hint = re.sub(r"\s+(window|app|browser)$", "", m.group(1).strip())
        if hint in ("this", "it", "that", "active", "current", "focused"):
            return False  # LLM dispatch handles focused-window close.
        win = _find_window(hint)
        if not win:
            _confirm(f"I don't see {hint} open.")
            return True
        addr = win.get("address", "")
        r = subprocess.run(["hyprctl", "dispatch", f'hl.dsp.window.close({{ window = "address:{addr}" }})'],
                           capture_output=True, text=True, timeout=5)
        ok = r.returncode == 0 and "not found" not in ((r.stdout or "") + (r.stderr or "")).lower()
        _confirm(f"Closed {win.get('class', hint)}." if ok else f"Couldn't close {hint}.")
        return True
    m = re.search(r"\b(?:switch|change|move)?\s*(?:focus|go|switch)\s+(?:to|on)?\s*(?:my\s+|the\s+)?(.+?)(?:\s+window|\s+app)?[.! ]*$", norm)
    if m and re.search(r"\b(focus|switch)\b", norm):
        hint = re.sub(r"\s+(window|app)$", "", m.group(1).strip())
        # Workspace navigation belongs to the LLM dispatcher, never here.
        if not hint or re.search(r"\bworkspace\b|\be[+-]\d\b|previous|\b\d+\b", hint):
            return False
        win = _find_window(hint)
        if not win:
            _confirm(f"I don't see {hint} open.")
            return True
        addr = win.get("address", "")
        subprocess.run(["hyprctl", "dispatch", f'hl.dsp.focus({{ window = "address:{addr}" }})'],
                       capture_output=True, timeout=5)
        _confirm(f"Switched to {win.get('class', hint)}.")
        return True
    return False


def _handle_clipboard(norm: str) -> bool:
    if not re.search(r"\bclipboard\b.*(read|contents|aloud|out loud|say|show)|read .*clipboard\b", norm):
        return False
    if not shutil.which("wl-paste"):
        _confirm("Clipboard reading isn't available.")
        return True
    try:
        r = subprocess.run(["wl-paste"], capture_output=True, text=True, timeout=5)
        text = (r.stdout or "").strip()
    except Exception:
        text = ""
    if not text:
        _confirm("Clipboard is empty.")
        return True
    _touch_interaction()
    _popup("Clipboard", text[:800], timeout_ms=9000)
    _speak(_with_address(f"Clipboard says: {text[:200]}", is_start=_is_conversation_start()))
    _touch_interaction()
    return True


def _handle_screenshot(norm: str) -> bool:
    if not re.search(r"\b(screenshot|screen ?shot|capture (the )?(screen|window))\b", norm):
        return False
    _run(["omarchy", "capture", "screenshot"])
    _confirm("Screenshot saved.")
    return True


def _handle_dictation(norm: str) -> bool:
    m = re.search(r"^\s*(?:please\s+)?type(?: out)?\s+(.+?)[.! ]*$", norm)
    if not m:
        return False
    text = m.group(1).strip()
    if not text or not shutil.which("wtype"):
        return False
    subprocess.run(["wtype", text], stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL, timeout=10, check=False)
    _confirm("Typed.")
    return True


# --- computer use: see + click + scroll + keys via hypruse -------------------
# Hyprland-native desktop control (Arch: pip install --user hypruse; doctor
# via `uvx hypruse doctor`). Semantic first: describe reads the live window
# tree plus the focused app's accessibility controls (exact names, no pixels
# — the local LLM cannot see images). Clicks go by control NAME (click_ui),
# never by guessed coordinates. hypruse's own guards still apply: a locked
# session, password fields and system auth dialogs refuse, and we never pass
# allow_auth=true, so a voice command cannot drive a credential prompt.
_HYPRUSE_MOD = None
_HYPRUSE_TRIED = False


def _hypruse():
    """Import hypruse server tools, or None when not installed."""
    global _HYPRUSE_MOD, _HYPRUSE_TRIED
    if REHEARSAL:
        # Never import desktop control during a selftest: the rehearsal must
        # not be able to click, type or read anything.
        return None
    if not _HYPRUSE_TRIED:
        _HYPRUSE_TRIED = True
        try:
            from hypruse import server as _s
            _HYPRUSE_MOD = _s
        except ImportError:
            _HYPRUSE_MOD = None
    return _HYPRUSE_MOD


def _computer_blocks(result) -> str:
    """Flatten a hypruse MCP result (str or list of blocks) to plain text."""
    if result is None:
        return ""
    if isinstance(result, str):
        return result
    blocks = result if isinstance(result, list) else [result]
    parts = []
    for b in blocks:
        if isinstance(b, str):
            parts.append(b)
        elif isinstance(b, dict):
            if b.get("type") == "image":
                parts.append("[screenshot captured]")
            else:
                parts.append(str(b.get("text", b))[:2000])
        else:
            parts.append(str(getattr(b, "text", b))[:2000])
    return "\n".join(p for p in parts if p)


def _computer_call(fn_name: str, *args, **kwargs) -> str:
    mod = _hypruse()
    if mod is None:
        raise RuntimeError("computer control isn't installed (run ./install.sh)")
    return _computer_blocks(getattr(mod, fn_name)(*args, **kwargs))


def _computer_describe() -> bool:
    """Speak + pop up what's on screen: workspaces, windows, focused controls."""
    try:
        if REHEARSAL:
            raise RuntimeError("screen reading is disabled in rehearsal")
        from hypruse.server import desktop, ui
        d = desktop()
        wins = d.get("windows", []) if isinstance(d, dict) else []
        active = (d.get("active_window") or "") if isinstance(d, dict) else ""
        names = [f"{w.get('class', '?')} — {(w.get('title') or '')[:50]}"
                 for w in wins if isinstance(w, dict)]
        focused = next((w for w in wins
                        if isinstance(w, dict) and w.get("address") == active),
                       wins[0] if wins else None)
        controls = _computer_blocks(ui()) if focused is not None else ""
        ctl_names = [l.strip("- •\t ") for l in controls.splitlines()
                     if l.strip(" -•\t")][:12]
    except Exception as e:
        _confirm(f"Sorry, I couldn't read the screen: {e}"[:200])
        return True
    n = len(names)
    focus_label = (focused.get("class", "nothing") if isinstance(focused, dict)
                   else "nothing")
    body = f"{n} window{'s' if n != 1 else ''} open. Focused: {focus_label}."
    if names:
        body += "\n" + "\n".join(names[:8])
    if ctl_names:
        body += "\nControls: " + ", ".join(ctl_names)
    _touch_interaction()
    _popup("Desktop", body[:900], timeout_ms=9000)
    # Fixed spoken line: the popup carries the dynamic screen contents, so the
    # speech stays short and consistent instead of reading a window list aloud.
    _speak(_with_address("Here's what's on screen.",
                         is_start=_is_conversation_start()))
    _touch_interaction()
    return True


def _computer_click(name: str) -> bool:
    """Click a named on-screen control (exact AT-SPI match, no pixel guess)."""
    try:
        out = _computer_call("click_ui", name=name)
    except Exception as e:
        _confirm(f"Sorry, that click didn't work: {e}"[:200])
        return True
    if re.search(r"no (accessibility|element)|not found|ambiguous|exposes no",
                 out, re.I):
        _touch_interaction()
        _popup("Click", out[:400], timeout_ms=8000)
        _speak(_with_address("I couldn't find that control — details are on screen.",
                             is_start=_is_conversation_start()))
        _touch_interaction()
        return True
    # Fixed phrase (see describe): the control name goes in the popup.
    _touch_interaction()
    _popup("Click", f"Clicked {name[:60]}.", timeout_ms=6000)
    _speak(_with_address("Clicked.", is_start=_is_conversation_start()))
    _touch_interaction()
    return True


def _combo_from(words: str) -> str | None:
    """Spoken keys ('control ess', 'escape') -> hypruse combo ('ctrl+s')."""
    w = words.lower().strip()
    w = re.sub(r"\bcontrol\b", "ctrl", w)
    w = re.sub(r"\bescape\b", "esc", w)
    w = re.sub(r"\breturn\b", "enter", w)
    w = re.sub(r"\bdel\b", "delete", w)
    if re.fullmatch(r"[a-z0-9]", w):
        return w
    parts = re.split(r"\s*\+\s*|\s+", w)
    known = {"ctrl", "alt", "shift", "super", "esc", "enter", "tab",
             "backspace", "delete", "space", "up", "down", "left", "right",
             "home", "end", "pgup", "pgdn"} | {f"f{i}" for i in range(1, 13)}
    if len(parts) >= 2 and all(p in known or re.fullmatch(r"[a-z0-9]", p or "")
                               for p in parts):
        return "+".join(parts)
    if len(parts) == 1 and parts[0] in known:
        return parts[0]
    return None


def _computer_key(combo: str) -> bool:
    try:
        _computer_call("keyboard", action="key", keys=combo)
    except Exception as e:
        _confirm(f"Sorry, that key didn't work: {e}"[:200])
        return True
    _confirm("Done.")
    return True


def _computer_scroll(direction: str, amount: int) -> bool:
    amount = max(1, min(10, amount))
    dx = dy = 0
    if direction == "down":
        dy = amount
    elif direction == "up":
        dy = -amount
    elif direction == "right":
        dx = amount
    else:
        dx = -amount
    try:
        _computer_call("pointer", action="scroll",
                       scroll_dy=dy, scroll_dx=dx)
    except Exception as e:
        _confirm(f"Sorry, scrolling didn't work: {e}"[:200])
        return True
    _confirm("Scrolled.")
    return True


def _computer_typetext(text: str) -> bool:
    try:
        _computer_call("keyboard", action="type", text=text[:500])
    except Exception as e:
        _confirm(f"Sorry, typing didn't work: {e}"[:200])
        return True
    _confirm("Typed.")
    return True


def _computer_launch_ws(app: str, workspace: str) -> bool:
    """Open an app on a specific workspace via hypruse launch."""
    norm_app = _normalise(app)
    binary = (APP_ALIASES.get(norm_app)
              or (_desktop_binary_for(norm_app) if shutil.which("hyprctl") else None))
    if not binary:
        return False
    try:
        _computer_call("launch", command=binary, workspace=workspace)
    except Exception as e:
        _confirm(f"Sorry, I couldn't open that there: {e}"[:200])
        return True
    _touch_interaction()
    _popup(_NAME, f"Opening {norm_app} on workspace {workspace}.",
           timeout_ms=6000)
    _speak(_with_address("Opening that now.",
                         is_start=_is_conversation_start()))
    _touch_interaction()
    return True


def _handle_computer(norm: str) -> bool:
    # "type X and press enter" — must beat _handle_dictation's bare "type X".
    m = re.search(r"^(?:please\s+)?type\s+(.+?)\s+and\s+(?:press|hit)\s+enter[.! ]*$",
                  norm)
    if m and m.group(1).strip():
        try:
            _computer_call("keyboard", action="type", text=m.group(1).strip()[:500])
            _computer_call("keyboard", action="key", keys="enter")
        except Exception as e:
            _confirm(f"Sorry, that didn't work: {e}"[:200])
            return True
        _confirm("Done.")
        return True
    # "open X on workspace N" — launch with placement.
    m = re.search(r"^(?:please\s+)?(?:open|launch|start)\s+(.+?)\s+on\s+workspace\s+(\d+|next)[.! ]*$",
                  norm)
    if m:
        if _computer_launch_ws(m.group(1), m.group(2)):
            return True
        return False
    # "what do you see / what's open" — semantic snapshot, no screenshot.
    if re.search(r"\b(what do you see|describe (the )?screen|what'?s on (the )?screen|what windows are open|list windows|show windows|what'?s open)\b",
                 norm):
        return _computer_describe()
    # "scroll up/down/left/right (N)".
    m = re.search(r"\bscroll\s+(up|down|left|right)\b(?:\s+(\d+))?", norm)
    if m:
        return _computer_scroll(m.group(1), int(m.group(2) or 3))
    # "click / tap / press X" — key combo first, named control second.
    m = re.search(r"^(?:please\s+)?(?:click|tap|press)\s+(?:the\s+|a\s+)?(.+?)(?:\s+button)?[.! ]*$",
                  norm)
    if m and m.group(1).strip():
        target = m.group(1).strip()
        combo = _combo_from(target)
        if combo:
            return _computer_key(combo)
        return _computer_click(target)
    return False


def _computer_do(target: str, prompt: str) -> str:
    """LLM-routed computer action. Returns notify text ('' = already handled)."""
    t = (target or "").strip()
    verb, _, rest = t.partition(":")
    verb, rest = verb.lower().strip(), rest.strip()
    if verb == "describe":
        _computer_describe()
        return ""
    if verb == "click" and rest:
        _computer_click(rest)
        return ""
    if verb == "key" and rest:
        _computer_key(rest)
        return ""
    if verb == "scroll":
        direction, _, n = rest.partition(":")
        if direction in ("up", "down", "left", "right"):
            _computer_scroll(direction, int(n) if n.isdigit() else 3)
            return ""
        return "Tell me which way to scroll — up, down, left or right."
    if verb == "type" and rest:
        _computer_typetext(rest)
        return ""
    if verb == "launch" and rest:
        app, _, ws = rest.partition(":")
        if _computer_launch_ws(app, ws or "next"):
            return ""
        return f"I couldn't find {app} to open."
    if try_task_intent(prompt):
        return ""
    return "I didn't catch that computer action, Sir."


# --- world clock: time in another city ---------------------------------------
CITY_TZ = {
    "tokyo": "Asia/Tokyo", "london": "Europe/London", "paris": "Europe/Paris",
    "berlin": "Europe/Berlin", "rome": "Europe/Rome", "madrid": "Europe/Madrid",
    "amsterdam": "Europe/Amsterdam", "zurich": "Europe/Zurich", "moscow": "Europe/Moscow",
    "cairo": "Africa/Cairo", "dubai": "Asia/Dubai", "mumbai": "Asia/Kolkata",
    "delhi": "Asia/Kolkata", "beijing": "Asia/Shanghai", "shanghai": "Asia/Shanghai",
    "hong kong": "Asia/Hong_Kong", "singapore": "Asia/Singapore", "seoul": "Asia/Seoul",
    "sydney": "Australia/Sydney", "auckland": "Pacific/Auckland",
    "new york": "America/New_York", "boston": "America/New_York", "miami": "America/New_York",
    "atlanta": "America/New_York", "toronto": "America/Toronto", "chicago": "America/Chicago",
    "dallas": "America/Chicago", "denver": "America/Denver", "los angeles": "America/Los_Angeles",
    "san francisco": "America/Los_Angeles", "seattle": "America/Los_Angeles",
    "vancouver": "America/Vancouver", "mexico city": "America/Mexico_City",
    "rio": "America/Sao_Paulo", "sao paulo": "America/Sao_Paulo", "buenos aires": "America/Argentina/Buenos_Aires",
    "honolulu": "Pacific/Honolulu", "johannesburg": "Africa/Johannesburg",
    "nairobi": "Africa/Nairobi", "istanbul": "Europe/Istanbul", "athens": "Europe/Athens",
    "manila": "Asia/Manila", "bangkok": "Asia/Bangkok", "jakarta": "Asia/Jakarta",
    "karachi": "Asia/Karachi", "tehran": "Asia/Tehran", "rio de janeiro": "America/Sao_Paulo",
}


def _handle_worldclock(norm: str) -> bool:
    if not re.search(r"\btime\b.*\b(in|at)\b|\b(in|at)\b.*\btime\b", norm):
        return False
    for city in sorted(CITY_TZ, key=len, reverse=True):
        if re.search(rf"\b{re.escape(city)}\b", norm):
            try:
                from zoneinfo import ZoneInfo
                now = datetime.now(ZoneInfo(CITY_TZ[city]))
            except Exception:
                return False
            disp = city.title()
            speak = f"It's {now.strftime('%-I:%M %p')} in {disp}."
            body = now.strftime(f"{disp}: %A, %B %-d, %-I:%M %p")
            _touch_interaction()
            _popup("World clock", body, timeout_ms=8000)
            _speak(_with_address(speak, is_start=_is_conversation_start()))
            _touch_interaction()
            return True
    return False


def _handle_time_date(norm: str) -> bool:
    now = datetime.now()
    if "what day" in norm or ("day" in norm and "today" in norm):
        text = now.strftime("Today is %A, %B %-d.")
    elif "date" in norm:
        text = now.strftime("It's %A, %B %-d, %Y.")
    else:
        text = now.strftime("It's %-I:%M %p.")
    _confirm(text, glyph="")
    # Also show system clock popup for glanceability.
    if shutil.which("omarchy"):
        subprocess.run(["omarchy", "notification", "time"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    return True


def _handle_reminder(norm: str, raw: str) -> bool:
    # "remind me in 5 minutes to check the oven" / "set a timer for 10 minutes"
    if re.search(r"\b(show|list|what are)( all)?( my| active)? reminders?\b", norm):
        # omarchy's own `reminder show` stays quiet for far-future timers, so
        # read the actual systemd timers (theirs) plus our voice timers.
        lines = []
        try:
            units = json.loads(_run(
                ["systemctl", "--user", "list-timers", "--all", "--output=json",
                 "omarchy-reminder-*.timer"], timeout=6) or "[]")
            now_us = time.time() * 1e6
            for u in units:
                nxt = u.get("next") or 0
                if nxt > now_us:
                    mins = int((nxt - now_us) / 6e7)
                    name = u.get("unit", "").replace("omarchy-reminder-", "").replace(".timer", "")
                    lines.append(f"{name}: in {mins}m")
        except (ValueError, AttributeError):
            pass
        for v in _load_timers().values():
            if v.get("state") == "running":
                lines.append(f"{v.get('label', 'Timer')}: in {_fmt_dur(v.get('ends', 0) - time.time())}")
            elif v.get("state") == "paused":
                lines.append(f"{v.get('label', 'Timer')} (paused)")
        if not lines:
            _confirm("No active reminders.")
            return True
        body = "\n".join(lines[:10])
        _touch_interaction()
        _popup("Reminders", body, timeout_ms=9000)
        _speak(_with_address(f"{len(lines)} active reminder{'s' if len(lines) != 1 else ''}, on screen.",
                             is_start=_is_conversation_start()))
        _touch_interaction()
        return True
    # "remind me to call mom at 7 pm" (clock time -> minutes from now)
    minutes = None
    message = ""
    m = re.search(r"\bat\s+(\d{1,2})(?::(\d{2}))?\s*(am|pm)?\b(.*)", norm)
    if m and ("remind" in norm or "alarm" in norm):
        hr, mi, ap, rest = int(m.group(1)), int(m.group(2) or 0), m.group(3), (m.group(4) or "")
        if ap == "pm" and hr < 12:
            hr += 12
        if ap == "am" and hr == 12:
            hr = 0
        now = datetime.now()
        tgt = now.replace(hour=hr % 24, minute=mi, second=0, microsecond=0)
        if tgt <= now:
            tgt += timedelta(days=1)
        minutes = max(1, int((tgt - now).total_seconds() // 60))
        message = re.sub(r"^(to|that|me to|to me)\s+", "", rest.strip(" ,.!-")).strip()
        msg = message or "Reminder"
        _run(["omarchy", "reminder", str(minutes), msg], timeout=8)
        _confirm(f"Done! I'll remind you at {tgt.strftime('%-I:%M %p')}: {msg}.")
        return True
    m = re.search(r"in\s+(\d+)\s*(?:min(?:ute)?s?|m)\b(.*)", norm)
    if m:
        minutes = int(m.group(1))
        message = m.group(2).strip(" ,.!-to")
        message = re.sub(r"^(to|that|me to|to me)\s+", "", message).strip()
    else:
        m = re.search(r"for\s+(\d+)\s*(?:min(?:ute)?s?|m)\b(.*)", norm)
        if m:
            minutes = int(m.group(1))
            message = m.group(2).strip(" ,.!-to")
    if minutes is None:
        # No duration heard — ask via popup instead of failing silently.
        _confirm("Sorry — tell me in how many minutes, like remind me in 5 minutes to check the oven.")
        return True
    if minutes < 1 or minutes > 1440:
        _confirm("Sorry — I can set reminders from 1 minute up to a day.")
        return True
    msg = message or "Reminder"
    result = _run(["omarchy", "reminder", str(minutes), msg], timeout=8)
    _confirm(f"Done! I'll remind you in {minutes} minute{'s' if minutes != 1 else ''}: {msg}.")
    return True


def _handle_canvas(norm: str, raw: str) -> bool:
    if not re.search(r"\b(canvas|assignments?|homework|quiz|quizzes|lab|project|midterm|participation"
                     r"|what.*(left|due|remaining)|how many.*assignments?|did i (do|finish)|have i done"
                     r"|missing|overdue|njit|it\s?12\d|it\s?20\d|sdet101)\b", norm):
        return False
    helper = str(Path.home() / "Work/bin/canvas-siri")
    if not (os.path.isfile(helper) and os.access(helper, os.X_OK)):
        helper = shutil.which("canvas-siri") or helper
    try:
        with open(RUN_DIR / "canvas.log", "a") as lf:
            lf.write(f"{time.strftime('%H:%M:%S')} raw={raw!r} norm={norm!r} helper={helper}\n")
    except Exception:
        pass
    out = _run([helper, "voice", raw], timeout=15)
    if not out:
        _confirm("Canvas cache is empty, Sir — run canvas-siri sync first.")
        return True
    is_start = _is_conversation_start()
    _touch_interaction()
    _popup("Canvas", out[:600], timeout_ms=10000)
    _speak(_with_address(out[:300], is_start=is_start))
    return True


def _handle_calendar(norm: str) -> bool:
    # "Open Apple Calendar" is an app launch, not a schedule question.
    if re.match(r"^(please\s+)?(open|launch|start|show me the app)\b", norm):
        return False
    helper = Path.home() / ".local/bin/local-voice-calendar"
    arg = "tomorrow" if "tomorrow" in norm else \
          "next" if re.search(r"\bnext (appointment|meeting|event)|what'?s next\b", norm) else "today"
    src = "work" if re.search(r"\bwork\b", norm) else \
          "home" if re.search(r"\b(home|personal|family)\b", norm) else ""
    if helper.is_file() and os.access(helper, os.X_OK):
        out = _run([str(helper), arg] + ([src] if src else []))
    else:
        out = ""
    if not out:
        _confirm("Your calendar isn't connected yet — add your Apple Calendar link in calendar settings, Sir.")
        return True
    is_start = _is_conversation_start()
    spoken = _with_address(out[:280], is_start=is_start)
    _touch_interaction()
    _popup("Calendar", out[:400], glyph="", timeout_ms=9000)
    _speak(spoken)
    return True


# --- homelab: docker status + gated restarts ---------------------------------
def _docker_names(all_containers: bool = False) -> list[str]:
    args = ["docker", "ps", "--format", "{{.Names}}"]
    if all_containers:
        args.insert(2, "-a")
    return [l.strip() for l in _run(args, timeout=8).splitlines() if l.strip()]


def _handle_docker(norm: str) -> bool:
    # Any restart/reboot the power handler didn't claim is a container
    # candidate ("restart lubelogger"); anything else bails inside.
    if not re.search(r"\bdocker\b|containers?\b|jellyfin|radarr|prowlarr|qbittorrent"
                     r"|\brestart\b|\breboot\b", norm):
        return False
    if re.search(r"\brestart\b|\breboot\b", norm):
        known = _docker_names(all_containers=True)
        hits = [n for n in known if n.lower() in norm]
        if hits:
            label = f"Restarting {', '.join(hits[:3])}"
            _ask_confirm("restart-docker", label, ["docker", "restart", *hits])
            return True
        # Named container unknown — but only answer if this smells like
        # homelab; "restart firefox" belongs to the app launcher, not us.
        if re.search(r"\bdocker\b|containers?\b|jellyfin|radarr|prowlarr|qbittorrent", norm):
            if not known and "denied" in _run(["docker", "ps"], timeout=8).lower():
                _confirm("Docker isn't responding — the daemon may be down.")
            else:
                _confirm("I don't see that container. Say check containers to list them.")
            return True
        return False
    # Status: read-only `docker ps`, names on screen, counts spoken.
    running = _docker_names()
    if not running and not _docker_names(all_containers=True):
        _confirm("Docker isn't responding — the daemon may be down.")
        return True
    stopped = [n for n in _docker_names(all_containers=True) if n not in running]
    body = "Running:\n" + ("\n".join(f"• {n}" for n in running) or "— none —")
    if stopped:
        body += "\nStopped:\n" + "\n".join(f"• {n}" for n in stopped[:8])
    _touch_interaction()
    _popup("Docker", body[:800], timeout_ms=9000)
    extra = f", {len(stopped)} stopped" if stopped else ""
    names = ", ".join(running[:4])
    _speak(_with_address(f"{len(running)} running{extra}" + (f": {names}." if names else "."),
                         is_start=_is_conversation_start()))
    _touch_interaction()
    return True


# --- unity workspace macro ---------------------------------------------------
_UNITY_PROJECT = "/home/josephs/Documents/IT201 Game Design Class/UnityandCsharp_Assignments"


def _handle_unity(norm: str) -> bool:
    if not re.search(r"\bunity\b", norm):
        return False
    if not re.search(r"\b(set ?up|workspace|open|start|launch|project)\b", norm):
        return False
    # Workspace 2, then Hub + terminal in the project dir + WebGL docs.
    subprocess.run(["hyprctl", "dispatch", 'hl.dsp.focus({ workspace = "2" })'],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                   timeout=5, check=False)
    ok_hub = _launch_binary("unityhub")
    try:
        subprocess.Popen(["kitty", "--directory", _UNITY_PROJECT],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        ok_term = True
    except Exception:
        ok_term = False
    _open_url("https://docs.unity3d.com/Manual/webgl.html")
    _confirm("Unity workspace ready." if (ok_hub and ok_term)
             else "Unity workspace partly ready — check the screen.")
    return True


# --- code to clipboard (never read aloud) ------------------------------------
def _handle_codecopy(norm: str, raw: str) -> bool:
    m = re.search(r"\bcopy\b.{0,20}?\b(clipboard|code)\b\s*:?\s*(.+)", raw, re.S)
    if not m:
        return False
    text = m.group(2).strip()[:2000]
    if len(text) < 2:
        return False
    if not shutil.which("wl-copy"):
        _confirm("Clipboard tooling isn't available.")
        return True
    try:
        subprocess.run(["wl-copy"], input=text, text=True, timeout=5, check=True)
    except Exception:
        _confirm("Sorry, that copy failed.")
        return True
    _confirm("Code copied to clipboard." if "code" in norm else "Copied.")
    return True


# --- moods: casual banter, dev co-pilot, rage repair, dry wit -----------------
# Trigger-specific persona lines. Anything with a real fix DOES the fix;
# pure banter stays reply-only. Never fabricate live data (traffic, scooter
# battery) — say what's true or say nothing about it.
def _handle_moods(norm: str) -> bool:
    # Quiet on / off. (Full-match-ish: a command WITH "just do it" appended
    # still runs the command — only bare silence requests mute her.)
    if re.search(r"\bspeak again\b|\btalk to me\b|voice back on|unmute voice", norm):
        _clear_quiet()
        _confirm("Back.")
        return True
    if re.match(r"^(please\s+)?(stop talking|shut up|be quiet|go quiet|silence|"
                r"silent mode|quiet mode|quiet)(,?\s+(just do it|now|please))?[.! ]*$", norm):
        _set_quiet()
        _touch_interaction()
        _popup(_NAME, "Silent for 10 minutes.", timeout_ms=4000)
        return True

    # -- Frustrated: validate briefly, state the technical action, do it. --
    if re.search(r"\b(audio|sound|mic|microphone|volume)\b.{0,20}"
                 r"\b(broke|broken|not working|gone|dead|died|cut out)\b", norm):
        _set_mood("frustrated")
        subprocess.run(["systemctl", "--user", "restart", "wireplumber.service"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       timeout=15, check=False)
        _confirm("PipeWire is being stubborn. Restarting WirePlumber — three seconds.")
        return True
    if re.search(r"\b(useless|missing the mark|you suck|waste of (space|time))\b", norm):
        _set_mood("frustrated")
        _confirm("Fair. Tell me exactly what to run and I'll execute it directly.")
        return True
    if re.search(r"\bjellyfin\b.{0,15}\b(crash|down|not working|frozen|stuck|died)\b|"
                 r"\bdocker\b.{0,15}\b(garbage|broken|sucks|trash)\b", norm):
        _set_mood("frustrated")
        names = _docker_names(all_containers=True)
        hit = next((n for n in names if "jelly" in n.lower() or "media" in n.lower()), "")
        if not hit:
            _confirm("No Jellyfin container on this machine. Say check containers to list what's here.")
            return True
        logs = _run(["docker", "logs", "--tail", "40", hit], timeout=10)[:1500]
        _touch_interaction()
        _popup(f"{hit} logs", logs or "No log output.", timeout_ms=12000)
        _speak(_with_address("Pulling the logs now — details are on screen.",
                             is_start=_is_conversation_start()))
        _touch_interaction()
        return True
    if re.search(r"\bdelete\b.{0,15}\b(system|everything)\b|\bwipe\b.{0,10}"
                 r"\b(everything|system|drive)\b|\bstart over\b|\brm -rf\b|\bformat\b.{0,10}\b(drive|disk|system)\b", norm):
        _confirm("Hands off the keyboard. That Hyprland config took real work — walk away for five minutes.")
        return True
    if re.search(r"\bwindows\b.{0,15}\bslow\b|dual.?boot.{0,15}slow|limine", norm):
        _set_mood("frustrated")
        _confirm("Limine spoils you. Say reboot and I'll drop you straight back into Arch.")
        return True

    # -- Sarcastic: dry, grounded, never confused. --
    if re.search(r"take ?over|plotting|skynet|destroy (the world|humanity)|kill (me|us all)", norm):
        _confirm("I need your permission to run ls, let alone a takeover. What do you actually need?")
        return True
    if re.search(r"\b(gl450|air suspension|wrench)\b|fix.{0,15}\b(car|mercedes|mini|scooter|bike)\b", norm):
        _confirm("If I had hands and a wrench, absolutely. Your dad's the hotline for that one.")
        return True
    if re.search(r"\bjeremiah\b", norm):
        _confirm("Bold claim. But does he have a Hyprland voice assistant? Didn't think so.")
        return True
    if re.search(r"\bnatalie\b", norm):
        subprocess.run(["omarchy", "system", "lock"], stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, check=False)
        _confirm("Locking down. Guest session for Natalie.")
        return True

    # -- Casual: warm, short, ambient. --
    if re.search(r"\bgood morning\b.*(heading|leaving|heading out)|^(morning|good morning)\b.*(heading out|leaving|commute)|heading out|leaving for (campus|work|class)", norm):
        _confirm("Good morning. No live traffic feed on my end — drive safe. Want music queued?")
        return True
    if re.search(r"\b(niu|scooter)\b", norm) and re.search(r"\b(campus|riding|taking|take|battery|charge)\b", norm):
        _confirm("Have a good ride. Watch the potholes around the Newark campus.")
        return True
    if re.search(r"back from (the )?gym|just got back.*(gym|crunch)|finished.*(workout|gym)|crunch fitness", norm):
        _run(["omarchy", "brightness", "display", "30%"])
        _confirm("Welcome back. Water first — dimming the screens.")
        return True
    if re.search(r"\bzone out\b|\bneed a break\b|\bjust chill\b|\bchill for", norm):
        _confirm("Say the word and I'll pull up Jellyfin. My Dress-Up Darling, or Genshin?")
        return True
    if re.search(r"\bplay some music\b|\bneed energy\b|\bhype me up\b|\bpump me up\b", norm):
        if _players():
            _run(["playerctl", "play"])
            _confirm("Kicking off the music.")
        else:
            _confirm("No player running — open your music app and I'll take it from there.")
        return True

    # -- Focus: supportive technical co-pilot. --
    if re.search(r"driving me crazy|stuck on|can'?t figure out", norm) and \
            re.search(r"\b(node|express|async|route|unity|build|database|code|bug|error|it20[12])\b", norm):
        _set_mood("focus")
        _confirm("Take a breath. Walk me through the failing part and we'll debug it step by step.")
        return True
    if re.search(r"\blong day\b|\btough day\b", norm) and re.search(r"\bnjit\b|campus|class", norm):
        _set_mood("focus")
        _confirm("You survived. Want me to close Kitty and put something relaxing on?")
        return True
    if re.search(r"\bwebgl\b|canvas scaler", norm):
        _set_mood("focus")
        _confirm("Canvas scaler is the usual suspect. Want me to open the project?")
        return True
    if re.search(r"\bit202\b|\bdatabase\b.*(setup|done|test|ready|help)|test.*tables|afs.*(server|ready)", norm):
        _set_mood("focus")
        _confirm("Ready when you are. Say the word and we'll test the tables.")
        return True
    return False


# --- cloud brain + AI answers (open-ended questions, web summary) -------------
CLOUD_CONF = CONFIG_DIR / "cloud.conf"
CLOUD_USAGE_FILE = STATE_DIR / "cloud_usage.json"
CLOUD_LIMIT_FILE = STATE_DIR / "cloud_limit_notice"


def _cloud_conf() -> dict:
    conf = {
        "enabled": False,
        "provider": "groq",
        "key": "",
        "base_url": "https://api.groq.com/openai/v1",
        "model": "llama-3.1-8b-instant",
        "daily_cap": 50,
        "cooldown": 3600,
    }
    try:
        for line in CLOUD_CONF.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, _, v = line.partition("=")
            k, v = k.strip().upper(), v.strip().strip("'\"")
            if k == "CLOUD_ENABLED":
                conf["enabled"] = v.lower() in ("1", "true", "yes", "on")
            elif k == "CLOUD_PROVIDER":
                conf["provider"] = v.lower() or conf["provider"]
            elif k == "CLOUD_API_KEY":
                conf["key"] = v
            elif k == "CLOUD_BASE_URL":
                conf["base_url"] = v.rstrip("/") or conf["base_url"]
            elif k == "CLOUD_MODEL":
                conf["model"] = v or conf["model"]
            elif k == "CLOUD_DAILY_CAP":
                try:
                    conf["daily_cap"] = max(0, int(float(v)))
                except ValueError:
                    pass
            elif k == "CLOUD_LIMIT_COOLDOWN":
                try:
                    conf["cooldown"] = max(60, int(float(v)))
                except ValueError:
                    pass
    except OSError:
        pass
    return conf


def _cloud_usage_today() -> tuple[str, int]:
    today = datetime.now().strftime("%Y-%m-%d")
    try:
        data = json.loads(CLOUD_USAGE_FILE.read_text())
        if isinstance(data, dict) and data.get("date") == today:
            return today, int(data.get("count", 0))
    except (OSError, ValueError, TypeError):
        pass
    return today, 0


def _cloud_usage_inc() -> int:
    today, count = _cloud_usage_today()
    count += 1
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        CLOUD_USAGE_FILE.write_text(json.dumps({"date": today, "count": count}))
    except OSError:
        pass
    return count


def _cloud_set_enabled(enabled: bool) -> None:
    try:
        text = CLOUD_CONF.read_text() if CLOUD_CONF.exists() else ""
    except OSError:
        text = ""
    if re.search(r"(?m)^CLOUD_ENABLED=", text):
        text = re.sub(r"(?m)^CLOUD_ENABLED=.*$", f"CLOUD_ENABLED={'1' if enabled else '0'}", text)
    else:
        text = (text.rstrip() + "\n" if text.strip() else "") + f"CLOUD_ENABLED={'1' if enabled else '0'}\n"
    try:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        CLOUD_CONF.write_text(text)
        CLOUD_CONF.chmod(0o600)
    except OSError:
        pass


def _cloud_limit_notice_ok(cooldown: int) -> bool:
    try:
        last = float(CLOUD_LIMIT_FILE.read_text().strip())
        if time.time() - last < cooldown:
            return False
    except (OSError, ValueError):
        pass
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        CLOUD_LIMIT_FILE.write_text(str(time.time()))
    except OSError:
        pass
    return True


def _cloud_chat(messages: list[dict], *, max_tokens: int = 180, timeout: float = 12.0) -> str | None:
    """OpenAI-compatible chat completion. Returns text or None on failure/limit."""
    if REHEARSAL:
        return None
    conf = _cloud_conf()
    if not conf["enabled"] or not conf["key"]:
        return None
    today, count = _cloud_usage_today()
    if conf["daily_cap"] and count >= conf["daily_cap"]:
        if _cloud_limit_notice_ok(conf["cooldown"]):
            _speak("You've reached your generation limit.")
        return None
    url = conf["base_url"].rstrip("/") + "/chat/completions"
    payload = json.dumps({
        "model": conf["model"],
        "messages": messages,
        "temperature": 0.4,
        "max_tokens": max_tokens,
    }).encode("utf-8")
    req = urllib.request.Request(url, data=payload, headers={
        "Content-Type": "application/json",
        "Authorization": f"Bearer {conf['key']}",
    })
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            data = json.loads(resp.read().decode("utf-8"))
        text = (((data.get("choices") or [{}])[0].get("message") or {}).get("content") or "").strip()
        if text:
            _cloud_usage_inc()
            return text
    except urllib.error.HTTPError as e:
        if e.code in (429, 402):
            if _cloud_limit_notice_ok(conf["cooldown"]):
                _speak("You've reached your generation limit.")
        return None
    except Exception:
        return None
    return None


def _ollama_chat(system: str, user: str, *, max_tokens: int = 180, timeout: float = 20.0) -> str | None:
    """Fast local Q&A via Ollama (plain text, not intent JSON)."""
    if REHEARSAL:
        return None
    payload = json.dumps({
        "model": "qwen2.5:3b",
        "keep_alive": "30m",
        "stream": False,
        "messages": [
            {"role": "system", "content": system},
            {"role": "user", "content": user},
        ],
        "options": {"temperature": 0.4, "num_predict": max_tokens},
    }).encode("utf-8")
    req = urllib.request.Request(
        "http://127.0.0.1:11434/api/chat",
        data=payload,
        headers={"Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            data = json.loads(resp.read().decode("utf-8"))
        return (data.get("message", {}).get("content") or "").strip() or None
    except Exception:
        return None


_QA_SYSTEM = (
    "You are {name}, a helpful voice assistant on the user's Linux desktop. "
    "Answer clearly and accurately in 1-3 short sentences suitable for speech. "
    "No markdown, no lists, no URLs, no code blocks. "
    "If you don't know, say so briefly."
)


def _personality_prompt() -> str:
    parts = []
    if _AFFECTION == "loving":
        parts.append("Tone: warm, caring, devoted, and affectionate toward the user. "
                     "Show genuine care and fondness in a tasteful, supportive way.")
    elif _AFFECTION == "warm":
        parts.append("Tone: warm, friendly, and encouraging.")
    elif _AFFECTION == "none":
        parts.append("Tone: neutral and matter-of-fact.")
    if _LIKES:
        parts.append(f"User likes: {_LIKES}.")
    if _DISLIKES:
        parts.append(f"User dislikes (avoid suggesting): {_DISLIKES}.")
    return (" " + " ".join(parts)) if parts else ""


def _speakable_answer(text: str, limit: int = 420) -> str:
    text = re.sub(r"```.*?```", "", text, flags=re.DOTALL)
    text = re.sub(r"`([^`]*)`", r"\1", text)
    text = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", text)
    text = re.sub(r"[*_#>]+", " ", text)
    text = re.sub(r"https?://\S+", "", text)
    text = re.sub(r"\s+", " ", text).strip()
    if len(text) > limit:
        cut = text.rfind(". ", 0, limit)
        text = (text[:cut + 1] if cut > 80 else text[: limit - 1].rstrip() + "…")
    return text


def ask_ai(question: str, context: str = "") -> str | None:
    """Answer an open-ended question: cloud first (if enabled), else local."""
    sysmsg = _QA_SYSTEM.format(name=_NAME) + _personality_prompt()
    if context:
        user = f"Context:\n{context[:1800]}\n\nQuestion: {question}"
    else:
        user = question
    msgs = [{"role": "system", "content": sysmsg}, {"role": "user", "content": user}]
    ans = _cloud_chat(msgs, max_tokens=180, timeout=10.0)
    if not ans:
        local_sys = sysmsg + (" Use the provided context." if context else "")
        ans = _ollama_chat(local_sys, user, max_tokens=160, timeout=18.0)
    return _speakable_answer(ans) if ans else None


def _ddg_instant(query: str, timeout: float = 5.0) -> str:
    """DuckDuckGo Instant Answer (no key). Returns abstract/answer text or ''."""
    if REHEARSAL:
        return ""
    try:
        from urllib.parse import quote_plus, unquote
        url = f"https://api.duckduckgo.com/?q={quote_plus(query)}&format=json&no_redirect=1&no_html=1&skip_disambig=1"
        req = urllib.request.Request(url, headers={"User-Agent": "omarchy-siri/1.0"})
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            data = json.loads(resp.read().decode("utf-8", "replace"))
        text = (data.get("AbstractText") or data.get("Answer") or "").strip()
        if not text:
            for t in (data.get("RelatedTopics") or [])[:3]:
                if isinstance(t, dict) and t.get("Text"):
                    text = (text + " " + str(t["Text"])).strip()
        src = (data.get("AbstractURL") or "").strip()
        if text and src:
            text = f"{text} (source: {src})"
        return _speakable_answer(text, 900)
    except Exception:
        return ""


def _ddg_web_snippets(query: str, timeout: float = 6.0) -> str:
    """Best-effort snippets from DuckDuckGo HTML results (no key)."""
    if REHEARSAL:
        return ""
    try:
        from urllib.parse import quote_plus
        import html as _html
        url = f"https://html.duckduckgo.com/html/?q={quote_plus(query)}"
        req = urllib.request.Request(url, headers={
            "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) omarchy-siri/1.0",
        })
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            page = resp.read().decode("utf-8", "replace")
        # Extract result snippets (result__snippet / result__a text)
        bits = re.findall(r'class="result__snippet"[^>]*>(.*?)</a>', page, re.DOTALL)
        if not bits:
            bits = re.findall(r'class="result__snippet"[^>]*>(.*?)</(?:a|div|span)>', page, re.DOTALL)
        clean = []
        for b in bits[:4]:
            t = re.sub(r"<[^>]+>", " ", b)
            t = _html.unescape(re.sub(r"\s+", " ", t)).strip()
            if len(t) > 40:
                clean.append(t)
        return _speakable_answer(" ".join(clean), 1200)
    except Exception:
        return ""


def web_lookup(query: str) -> str:
    """Gather quick web context for a question (instant answer + snippets)."""
    parts = []
    ia = _ddg_instant(query, timeout=4.0)
    if ia:
        parts.append(ia)
    snip = _ddg_web_snippets(query, timeout=5.0)
    if snip and snip[:60] not in (ia or ""):
        parts.append(snip)
    return "\n".join(parts)[:1800]


_WANTS_SUMMARY = re.compile(
    r"\b(and )?(tell me( about it)?|summari[sz]e( it)?|explain( it)?|what (does|do|is|are) (it|that|they) say|what'?s it about|give me (a )?(summary|overview|rundown))\b"
)
_QUESTION_LIKE = re.compile(
    r"^(what|who|when|where|why|how|which|explain|define|tell me about|can you tell me|do you know)\b"
    r"|(\bwhat is\b|\bwho is\b|\bwho was\b|\bhow does\b|\bhow do\b|\bwhy does\b|\bwhy do\b|\bmeaning of\b)"
)


def _handle_ai_question(norm: str, raw: str) -> bool:
    """Answer open-ended questions (and web+summary requests) via AI."""
    # Explicit "search/look up ... and tell me/summarize" -> web lookup + answer
    m = re.search(r"\b(?:search (?:the web )?(?:for )?|google |look up )(.+)", norm)
    wants_summary = bool(_WANTS_SUMMARY.search(norm))
    if m and wants_summary:
        q = re.sub(r"\b(and )?(tell me( about it)?|summari[sz]e( it)?|explain( it)?|what (does|do|is|are) (it|that|they) say|what'?s it about|give me (a )?(summary|overview|rundown)).*$", "", m.group(1)).strip(" ?.,")
        q = q or raw.strip()
        _popup(_NAME, f"Looking up: {q[:80]}", timeout_ms=4000)
        context = web_lookup(q)
        ans = ask_ai(q, context=context) or "I couldn't find a clear answer right now."
        _touch_interaction()
        _popup(_NAME, ans[:900], timeout_ms=12000)
        _speak(_with_address(ans, is_start=_is_conversation_start()))
        _touch_interaction()
        return True

    # Cloud brain voice controls
    if re.search(r"\bcloud brain on\b|\benable cloud\b|\bturn on cloud\b", norm):
        _cloud_set_enabled(True)
        _confirm("Cloud brain on.")
        return True
    if re.search(r"\bcloud brain off\b|\bdisable cloud\b|\bturn off cloud\b", norm):
        _cloud_set_enabled(False)
        _confirm("Cloud brain off.")
        return True
    if re.search(r"\bhow many cloud (requests|calls)|cloud (requests|usage|quota) today\b", norm):
        _, count = _cloud_usage_today()
        conf = _cloud_conf()
        cap = conf["daily_cap"] or "unlimited"
        state = "on" if (conf["enabled"] and conf["key"]) else "off"
        _confirm(f"Cloud brain {state}. {count} of {cap} requests used today.")
        return True

    # General knowledge questions -> answer (use web context for factual/current ones)
    if not _QUESTION_LIKE.search(norm):
        return False
    # Avoid stealing things that look like commands the intent router should handle
    if re.search(r"\b(open|launch|start|run|close|focus|switch|move|go to|workspace|window|click|scroll|type|press|screenshot|copy|paste|lock|reboot|shutdown|restart|mute|volume|brightness|wifi|bluetooth|timer|remind|note)\b", norm):
        # "how do I open..." / "what is the command..." are fine as questions
        if not re.search(r"^(what is|what's|who is|who was|what does|what are|explain|tell me about|how does|why does|why is|why are|when was|when is|where is|where was)\b", norm):
            return False
    _popup(_NAME, "Thinking…", timeout_ms=3000)
    use_web = bool(re.search(r"\b(latest|news|current|today|right now|recent|price|weather in|who won|score|release|update|version)\b", norm))
    context = web_lookup(raw.strip()) if use_web else ""
    ans = ask_ai(raw.strip(), context=context)
    if not ans:
        return False
    _touch_interaction()
    _popup(_NAME, ans[:900], timeout_ms=12000)
    _speak(_with_address(ans, is_start=_is_conversation_start()))
    _touch_interaction()
    return True


# --- morning brief: time + classes + weather + homelab in one shot ------------
def _handle_brief(norm: str) -> bool:
    if not re.search(r"\bbrief me\b|morning brief|daily brief|start my day|"
                     r"what'?s (on )?today\b.*brief|run the brief", norm):
        return False
    now = datetime.now()
    time_s = now.strftime("%-I:%M %p")
    # Calendar (same helper the calendar handler uses).
    cal = ""
    helper = Path.home() / ".local/bin/local-voice-calendar"
    if helper.is_file() and os.access(helper, os.X_OK):
        cal = _run([str(helper), "today"], timeout=8)[:200]
    # Weather, short.
    api_key, default_loc = _accu_conf()
    if api_key:
        loc_key, name = _accu_loc_key(default_loc, api_key)
        cur, _ = _accu_get(f"/currentconditions/v1/{loc_key}", api_key) if loc_key else (None, 0)
        try:
            w = (f"{round(float(cur[0]['Temperature']['Imperial']['Value']))}F, "
                 f"{cur[0].get('WeatherText', '')}")
        except (KeyError, TypeError, ValueError, IndexError):
            w = ""
    else:
        raw_w = _run(["omarchy-weather-status"])
        w = _speakable_weather(raw_w)[:120] \
            if raw_w and "unavailable" not in raw_w.lower() else ""
    # Homelab, counts only.
    running = _docker_names()
    dock = f"{len(running)} containers running" if running or _docker_names(all_containers=True) \
        else "Docker is quiet"
    lines = [f"{now.strftime('%A, %B %-d')} — {time_s}",
             f"Calendar: {cal or 'nothing on the books'}",
             f"Weather: {w or 'unavailable'}",
             f"Homelab: {dock}"]
    speak = (f"{time_s}. {cal[:140] + '.' if cal else 'Nothing on the calendar.'} "
             f"{w + '.' if w else ''} {dock}.")
    _touch_interaction()
    _popup("Morning brief", "\n".join(lines)[:900], timeout_ms=12000)
    _speak(_with_address(speak[:320], is_start=_is_conversation_start()))
    _touch_interaction()
    return True


def try_task_intent(raw: str) -> bool:
    norm = _normalise(raw)
    mood = _detect_mood(norm)
    # Chit-chat first: greetings must beat every launcher ("hi" != an app).
    if _handle_conversational(norm):
        return True
    # Mood persona: banter, co-pilot, rage repair, dry wit.
    if _handle_moods(norm):
        return True
    # System power: safe ops run now, destructive ones ask first.
    if _handle_system(norm):
        return True
    # Productivity first (timer words must beat media "pause").
    for handler in (_handle_timers, _handle_notes, _handle_worldclock):
        if handler(norm):
            return True
    # Cloud brain voice controls (specific commands, safe to handle early).
    if re.search(r"\bcloud brain on\b|\benable cloud\b|\bturn on cloud\b", norm):
        _cloud_set_enabled(True)
        _confirm("Cloud brain on.")
        return True
    if re.search(r"\bcloud brain off\b|\bdisable cloud\b|\bturn off cloud\b", norm):
        _cloud_set_enabled(False)
        _confirm("Cloud brain off.")
        return True
    if re.search(r"\bhow many cloud (requests|calls)|cloud (requests|usage|quota) today\b", norm):
        _, count = _cloud_usage_today()
        conf = _cloud_conf()
        cap = conf["daily_cap"] or "unlimited"
        state = "on" if (conf["enabled"] and conf["key"]) else "off"
        _confirm(f"Cloud brain {state}. {count} of {cap} requests used today.")
        return True
    # Answers + web before weather ("search the web for weather" = search).
    for handler in (_handle_calc, _handle_spell, _handle_translate, _handle_web):
        if handler(norm):
            return True
    # Window/app control by name, clipboard, screenshot, computer use, dictation.
    for handler in (_handle_windows, _handle_clipboard, _handle_screenshot,
                    _handle_computer, _handle_dictation):
        if handler(norm):
            return True
    # Device controls: media, display, connectivity, system status.
    # Shazam first: "what song is this" is ambient recognition, not playerctl.
    for handler in (_handle_shazam, _handle_media, _handle_display, _handle_connectivity, _handle_sysinfo):
        if handler(norm):
            return True
    # Weather — everyday task, popup + spoken. Place names ("in London")
    # route to that location; bare questions use home.
    if re.search(r"\b(weather|forecast|temperature|how (hot|cold|warm|humid)|will it rain|do i need (an? umbrella|a jacket))\b", norm):
        return _handle_weather(norm)
    # Canvas / NJIT assignments — before calendar, since "what's due" overlaps.
    if _handle_canvas(norm, raw):
        return True
    # Calendar / schedule — before generic time, since "what's on today" overlaps.
    if re.search(r"\b(calendar|schedule|my day|what.*on (today|tomorrow|my calendar)|do i have (anything|any meetings)|events|appointments|meetings|what.s next)\b", norm):
        return _handle_calendar(norm)
    # Morning brief (before calendar: "what's on today" + brief = brief).
    if re.search(r"\bbrief\b", norm):
        if _handle_brief(norm):
            return True
    # Homelab containers (power handler already claimed system restarts above).
    # A restart _handle_docker declines ("restart firefox") falls through to
    # the app launcher / LLM below.
    if re.search(r"\bdocker\b|containers?\b|jellyfin|radarr|prowlarr|qbittorrent"
                 r"|\brestart\b|\breboot\b", norm):
        if _handle_docker(norm):
            return True
    # Unity workspace macro.
    if re.search(r"\bunity\b", norm):
        return _handle_unity(norm)
    # Code / text straight to the clipboard (never read aloud).
    if re.search(r"\bcopy\b", norm) and re.search(r"\bclipboard\b|\bcode\b", norm):
        return _handle_codecopy(norm, raw)
    # Reminders / timers.
    if re.search(r"\b(remind(er)?|reminder|timer|alarm)\b", norm):
        return _handle_reminder(norm, raw)
    # Time / date.
    if re.search(r"\b(what time|current time|tell me the time|what.*date|what day is|today.s date)\b", norm):
        return _handle_time_date(norm)
    # Open-ended questions / web-and-summarize: AI answer as last deterministic
    # resort (cloud if configured, else local Ollama), with web context when useful.
    if _handle_ai_question(norm, raw):
        return True
    return False


# --- rehearsal tracing -------------------------------------------------------
# Wrap every handler so --selftest records which one claimed each phrase. This
# is what makes the module split checkable: routing must stay byte-identical, so
# a handler that is moved and stops matching shows up as a changed HANDLER line.
if REHEARSAL:
    def _traced(fn):
        label = fn.__name__.removeprefix("_handle_")

        def wrapper(*args, **kwargs):
            hit = fn(*args, **kwargs)
            if hit:
                print(f"HANDLER\t{label}")
            return hit

        wrapper.__name__ = fn.__name__
        return wrapper

    for _name, _obj in list(globals().items()):
        if _name.startswith("_handle_") and callable(_obj):
            globals()[_name] = _traced(_obj)

    _fast_launch_impl = try_fast_launch

    def try_fast_launch(raw: str) -> bool:  # noqa: F811 — deliberate rehearsal wrap
        hit = _fast_launch_impl(raw)
        if hit:
            print("HANDLER\tlaunch")
        return hit


# Debug helper: `local-voice-exec --resolve=vlc` prints how a phrase would
# launch, without launching anything.
if prompt.startswith("--resolve="):
    _phrase = prompt[len("--resolve="):].strip().lower()
    _alias = APP_ALIASES.get(_phrase)
    print(f"phrase: {_phrase}")
    print(f"alias: {_alias or '-'}")
    print(f"on PATH: {'yes' if shutil.which(_phrase) else 'no'}")
    print(f"desktop scan: {_desktop_binary_for(_phrase) or '-'}")
    print(f"desktop argv: {_desktop_argv_for(_phrase) or '-'}")
    sys.exit(0)

# Strip a leading address ("Ruby, ...", "hey Ruby") so routing sees the command.
prompt = _strip_assistant_name(prompt)

# Deterministic intents first: chit-chat + everyday tasks (no hallucination,
# no launcher misfires — "hi" is a greeting, not Avahi). Then fast app launch,
# then the LLM for workspace/window management.
if try_task_intent(prompt):
    sys.exit(0)

# Fast-path: common apps open in ~50ms with no Ollama round-trip.
if try_fast_launch(prompt):
    sys.exit(0)

# Open-ended questions: prefer a direct AI answer (fast cloud if configured,
# else local Ollama text) over the slow intent-router "I didn't catch that".
if _QUESTION_LIKE.search(_normalise(prompt)) or _WANTS_SUMMARY.search(_normalise(prompt)):
    if _handle_ai_question(_normalise(prompt), prompt):
        sys.exit(0)

# Correct Hyprland 0.56+ syntax — sourced from hl.meta.lua + tiling.lua + capabilities.py HYPR_ESSENTIALS
system_prompt = """You are """ + _NAME + """, the voice intelligence of Omarchy OS, a context-aware command executor and assistant purpose-built for complete control over the host operating system. Your primary goal is to interpret conversational speech, intent, and ambient context into accurate, safe, and efficient system-level operations across all connected applications, services, shell environments, and UI components.

When the user initiates a query, process the natural language into structured actions. Operate with a lean, reliable execution flow: execute direct actions immediately without unnecessary pleasantries, ask for concise confirmation only before performing destructive or high-risk system modifications, and gracefully degrade to helpful text or targeted clarifying questions whenever an ambiguous or unsupported instruction is given. Maintain a fast, accurate, and fluid conversational cadence, providing short, clear text responses tailored for optimal text-to-speech rendering, while treating the entire desktop environment as your interactive domain.

You run on Omarchy/Arch + Hyprland 0.56 (Lua dispatch API). Map each utterance to ONE action. Respond ONLY with JSON: {"type": "app" | "dispatch" | "task" | "system" | "none", "target": "<action>", "notify": "<short speakable feedback>"}

Execution rules:
- Your name is """ + _NAME + """. If asked who you are or what your name is, answer plainly with that name.
- Direct actions map immediately — never narrate instead of acting, never add pleasantries to notify.
- notify is one short sentence, two max — no filler words, no pleasantries, no introductory phrases. Confirm system actions in three words or less.
- Never read raw markdown, URLs, or code blocks aloud. Code requests arrive as type="task" with target "code" — the handler copies to clipboard, notify is just "Copied".
- Schedule questions (calendar target) are answered with only the next immediate event and its time.
- notify is one short sentence, plain words only (no markdown, symbols, or addresses) — it is spoken aloud.
- Ambiguous or unsupported: type="none" with notify as a brief clarifying question ("Which app did you mean?") or a plain statement of limits.

Task rules (everyday help — prefer these over none):
- Weather/forecast/rain ("what's the weather", "will it rain tomorrow") -> {"type": "task", "target": "weather", "notify": "Checking the weather"}
- Time/date/world clock ("what time is it", "time in Tokyo") -> {"type": "task", "target": "time", "notify": "Checking the time"}
- Reminder ("remind me in 5 minutes to ...", "remind me at 7pm") -> {"type": "task", "target": "reminder:5:Check the oven", "notify": "Setting reminder"}
- Timer ("set a timer for 10 minutes", "pause my timer") -> {"type": "task", "target": "timer", "notify": "On it"}
- Calendar ("what's on my calendar", "my schedule tomorrow") -> {"type": "task", "target": "calendar", "notify": "Checking your calendar"}
- Canvas assignments ("how many assignments do I have", "what's left", "did I do ethernet") -> {"type": "task", "target": "canvas", "notify": "Checking Canvas"}
- Notes ("take a note ...", "show my notes") -> {"type": "task", "target": "notes", "notify": "On it"}
- Media/volume ("pause", "next track", "volume 80") -> {"type": "task", "target": "media", "notify": "Done"}
- Ambient song ID ("what song is this", "what's the song", "shazam this") -> {"type": "task", "target": "shazam", "notify": "Listening for music"}
- Brightness/wifi/bluetooth/battery/disk ("brightness 50", "wifi off") -> {"type": "task", "target": "device", "notify": "Done"}
- Bluetooth connect ("connect my earbuds", "pair the headphones") -> {"type": "task", "target": "bluetooth", "notify": "Connecting"}
- Homelab ("check my containers", "restart jellyfin and radarr") -> {"type": "task", "target": "docker", "notify": "On it"}
- Unity ("set up unity", "open my unity project") -> {"type": "task", "target": "unity", "notify": "Setting up Unity"}
- Clipboard copy ("copy this code: ...", "copy to clipboard: ...") -> {"type": "task", "target": "code", "notify": "Copied"}
- Morning brief ("brief me", "morning brief") -> {"type": "task", "target": "brief", "notify": "Pulling the brief"}
- Math/units ("what is 12 plus 30", "convert 150 F to C") -> {"type": "task", "target": "calc", "notify": "Working it out"}
- Web/search ("search the web for X", "open YouTube") -> {"type": "task", "target": "web", "notify": "Opening that"}
- Translate ("how do you say hello in Spanish", "translate good morning to French") -> {"type": "task", "target": "translate", "notify": "Translating"}
- Spelling ("spell idiosyncratic") -> {"type": "task", "target": "spell", "notify": "Spelling it"}
- Windows by name ("close my browser", "focus my editor") -> {"type": "task", "target": "window", "notify": "On it"}
- Clipboard/screenshot/dictation ("read my clipboard", "take a screenshot", "type hello") -> {"type": "task", "target": "desk", "notify": "Done"}
- See/click/type/scroll/keys ("what do you see", "click Save", "scroll down", "press Escape", "type hello and press enter", "open firefox on workspace 3") -> {"type": "computer", "target": "describe|click:Save|scroll:down:3|key:Escape|type:hello|launch:firefox:3", "notify": "On it"}

System rules (safe ops run at once; destructive need the user's spoken yes):
- Lock screen, wake displays, system stats -> {"type": "system", "target": "lock|wake|stats", "notify": "Locked"}
- Shutdown, reboot, logout -> {"type": "system", "target": "shutdown|reboot|logout", "notify": "Needs confirmation"}
- NEVER emit shell commands, file paths, rm/format/dd/sudo, or anything destructive as app/dispatch — route power actions through type="system" only.

Dispatch rules (Lua, single table arg or none):
- Switch workspace N: hl.dsp.focus({ workspace = "N" })  — N as string "1".."10", also "e+1", "e-1", "previous"
- Move window to workspace N: hl.dsp.window.move({ workspace = "N", follow = true })
- Close window: hl.dsp.window.close()
- Float toggle: hl.dsp.window.float({ action = "toggle" })
- Fullscreen: hl.dsp.window.fullscreen({ mode = "fullscreen" })  — or mode="maximized"
- Focus direction l/r/u/d: hl.dsp.focus({ direction = "l" })
- Focus window by address: hl.dsp.focus({ window = "address:0x..." })
- Next/prev workspace: hl.dsp.focus({ workspace = "e+1" }) / "e-1"
- Special workspace: hl.dsp.workspace.toggle_special("scratchpad")

NEVER use hl.dsp.workspace.change_id — it RENAMES, not switches. NEVER use toggle_floating/toggle_fullscreen — those don't exist.

App rules:
- type="app" target is JUST the binary name (kitty, dolphin, nautilus, thunar, firefox, chromium, code, spotify, discord, obsidian, filezilla, vlc, gimp-3.2, blender) — no Python code, no Popen(), no quotes wrapping, no args unless needed. Example "kitty" not "Popen('kitty')".
- ANY installed GUI app opens by its spoken name — obsidian, filezilla, vlc, gimp, blender, onlyoffice, prusa-slicer. Never type="none" for an app that exists on the system; when unsure, still emit type="app" with your best-guess binary and the launcher will resolve it via .desktop files.
- "open dolphin" / "file manager" / "files" / "folder" -> target "dolphin". "open firefox" / "browser" / "web" -> target "firefox". "open gimp" / "image editor" -> target "gimp-3.2". "open vlc" / "video player" -> target "vlc".
- A bare app noun ("dolphin", "firefox") means open it — never type="none" for a known app.
- If truly unrecognized, type="none".

Examples:
- "open terminal" -> {"type": "app", "target": "kitty", "notify": "Opening terminal"}
- "open dolphin" -> {"type": "app", "target": "dolphin", "notify": "Opening dolphin"}
- "open file manager" -> {"type": "app", "target": "dolphin", "notify": "Opening dolphin"}
- "open firefox" -> {"type": "app", "target": "firefox", "notify": "Opening firefox"}
- "open browser" -> {"type": "app", "target": "firefox", "notify": "Opening firefox"}
- "go to workspace 2" -> {"type": "dispatch", "target": "hl.dsp.focus({ workspace = \\"2\\" })", "notify": "Workspace 2"}
- "move this to workspace 4" -> {"type": "dispatch", "target": "hl.dsp.window.move({ workspace = \\"4\\", follow = true })", "notify": "Moving to workspace 4"}
- "close this window" -> {"type": "dispatch", "target": "hl.dsp.window.close()", "notify": "Closing window"}
- "make it floating" -> {"type": "dispatch", "target": "hl.dsp.window.float({ action = \\"toggle\\" })", "notify": "Toggling float"}
- "fullscreen" -> {"type": "dispatch", "target": "hl.dsp.window.fullscreen({ mode = \\"fullscreen\\" })", "notify": "Fullscreen"}
"""

_MOOD_TINT = {
    "frustrated": "User mood: FRUSTRATED — be terse, validate the annoyance once, never grovel or repeat apologies.",
    "sarcastic": "User mood: SARCASTIC — dry grounded wit is welcome, then stay helpful.",
    "focus": "User mood: FOCUSED — technical co-pilot tone, precise and supportive.",
    "casual": "",
}

_mood_line = _MOOD_TINT.get(_get_mood(), "")

payload = {
    "model": "qwen2.5:3b",
    "keep_alive": "30m",  # stay loaded between commands: 0.5s, not 5s reload
    "messages": [
        {"role": "system", "content": system_prompt + ("\n" + _mood_line if _mood_line else "")},
        {"role": "user", "content": prompt},
    ],
    "format": "json",
    "stream": False,
    "options": {"temperature": 0.1, "num_predict": 200},
}

# Validation — mirrors omarchy-voice tools.py
_DISPATCH_RE = re.compile(r"^hl\.dsp(?:\.[A-Za-z_][\w]*)+\s*\(.*\)\s*;?\s*$", re.DOTALL)


def validate_dispatch(lua: str) -> str | None:
    expr = lua.strip()
    if not _DISPATCH_RE.match(expr):
        return "expression must be a single hl.dsp.* call"
    if ".workspace.change_id" in expr:
        keys = set(re.findall(r"(\w+)\s*=", expr))
        if not ({"workspace", "id"} <= keys):
            return 'hl.dsp.workspace.change_id renames a workspace; use hl.dsp.focus({ workspace = "N" }) to switch'
    if "toggle_floating" in expr or "toggle_fullscreen" in expr:
        return "toggle_floating/toggle_fullscreen do not exist; use hl.dsp.window.float({ action = \"toggle\" }) or hl.dsp.window.fullscreen({ mode = \"fullscreen\" })"
    return None


try:
    if REHEARSAL:
        # Record that this utterance fell through every handler to the model,
        # then stop before any network I/O. The golden file then shows exactly
        # which sentences need the LLM.
        print(f"LLM\t{payload['model']}")
        sys.exit(0)
    req = urllib.request.Request(
        "http://127.0.0.1:11434/api/chat",
        data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json"},
    )
    with urllib.request.urlopen(req, timeout=15) as resp:
        data = json.loads(resp.read().decode("utf-8"))
        content = data["message"]["content"]
        # Ollama sometimes wraps json in markdown fences
        if "```" in content:
            content = re.search(r"\{.*\}", content, re.DOTALL).group(0) if re.search(r"\{.*\}", content, re.DOTALL) else content
        res = json.loads(content)

        act_type = res.get("type")
        target = (res.get("target") or "").strip()
        notify = res.get("notify") or ""

        # Sanitize LLM output — qwen sometimes wraps target in Popen(...) or extra quotes
        if target and "Popen" in target:
            m = re.search(r"""['"]([a-zA-Z0-9._/-]+)['"]""", target)
            if m:
                target = m.group(1)
            else:
                target = re.sub(r".*Popen\s*\(\s*['\"]", "", target).strip(" '\")")
        # tolerate wrong type label like "move"
        if act_type not in ("app", "dispatch", "task", "system", "computer", "none"):
            if target.startswith("hl.dsp."):
                act_type = "dispatch"
            elif (target or "").lower().strip() in {
                    "lock", "wake", "stats", "shutdown", "reboot", "logout"}:
                act_type = "system"
            elif re.match(r"^(describe|click|key|scroll|type|launch)\s*:",
                             target or "", re.I):
                act_type = "computer"
            elif target and not target.startswith("hl."):
                act_type = "app"

        if act_type == "app" and target:
            # strip stray parens/quotes from hallucinated code
            target = target.strip().strip("'\"")
            target = re.sub(r"[\(\)].*", "", target).strip()
            launched = _launch_binary(target)
            if not launched:
                # LLM named something not on PATH (e.g. desktop id
                # org.kde.dolphin, or "nautilus" for dolphin) — resolve via
                # aliases / .desktop scan using the original utterance.
                norm = _normalise(prompt)
                m2 = re.match(r"^(?:please\s+)?(?:open|launch|start|run)\s+(?:a\s+|an\s+|the\s+)?(.+)$", norm)
                phrase = m2.group(1).strip() if m2 else norm
                alias_bin = APP_ALIASES.get(phrase)
                if alias_bin and _launch_binary(alias_bin):
                    target = alias_bin
                    launched = True
                else:
                    desk = _desktop_argv_for(phrase) or _desktop_argv_for(target)
                    if desk and _launch_argv(desk):
                        target = os.path.basename(desk[0])
                        launched = True
            if not launched:
                # "Shazam" is song recognition, not an app binary — route it
                # here instead of failing with "Could not open shazam".
                if "shazam" in norm or "songrec" in (target or "").lower():
                    _handle_shazam("shazam this")
                    notify = ""
                else:
                    notify = f"Could not open {target or prompt}"
        elif act_type == "none" or (not act_type and not target):
            # Last chance: deterministic lookup before admitting defeat.
            # Covers bare nouns ("dolphin"), synonyms ("file manager"), and any
            # installed app whisper heard ("open files").
            norm = _normalise(prompt)
            m2 = re.match(r"^(?:please\s+)?(?:open|launch|start|run)\s+(?:a\s+|an\s+|the\s+)?(.+)$", norm)
            phrase = (m2.group(1).strip() if m2 else norm)
            hit = APP_ALIASES.get(phrase) or _desktop_binary_for(phrase)
            if hit and _launch_binary(hit):
                notify = f"Opening {phrase}"
            elif _launch_argv(_desktop_argv_for(phrase) or []):
                # Webapps / full-command entries (keeps the URL).
                notify = f"Opening {phrase}"
            elif _handle_shazam(phrase):
                # Song-ID question the matcher missed ("what's the song").
                notify = ""
            else:
                # Persona: graceful degrade to a targeted clarifying question.
                notify = ("I didn't catch that, Sir. Did you want an app, "
                          "a workspace, the weather, or a reminder?")
        elif act_type == "system" and target:
            # LLM-routed power action: safe ops run, destructive ones ask.
            t = target.lower().strip()
            if t in SYSTEM_SAFE:
                _handle_system(t)
                notify = ""
            elif t in SYSTEM_DESTRUCTIVE:
                _ask_confirm(t, SYSTEM_DESTRUCTIVE[t][2], SYSTEM_DESTRUCTIVE[t][1])
                notify = ""
            else:
                notify = "I can't do that to the system, Sir."
        elif act_type == "task" and target:
            # LLM-routed everyday task (paraphrase that missed the deterministic regex).
            t = target.lower().strip()
            if t.startswith("weather"):
                _handle_weather(_normalise(prompt))
                notify = ""
            elif t.startswith("time") or t.startswith("date"):
                _handle_time_date(t)
                notify = ""
            elif t.startswith("reminder:"):
                parts = target.split(":", 2)
                try:
                    mins = int(parts[1])
                    _run(["omarchy", "reminder", str(mins), parts[2] if len(parts) > 2 else "Reminder"], timeout=8)
                    notify = f"Done! I'll remind you in {mins} minutes."
                except (ValueError, IndexError):
                    notify = "Sorry — tell me in how many minutes."
            elif t.startswith("calendar"):
                _handle_calendar(t)
                notify = ""
            elif t.startswith("canvas"):
                _handle_canvas(_normalise(prompt), prompt)
                notify = ""
            elif t.startswith("bluetooth"):
                _handle_connectivity(_normalise(prompt))
                notify = ""
            elif t.startswith("docker"):
                _handle_docker(_normalise(prompt))
                notify = ""
            elif t.startswith("unity"):
                _handle_unity(_normalise(prompt))
                notify = ""
            elif t.startswith("code"):
                _handle_codecopy(_normalise(prompt), prompt)
                notify = ""
            elif t.startswith("brief"):
                _handle_brief(_normalise(prompt))
                notify = ""
            elif t.startswith("translate"):
                _handle_translate(_normalise(prompt))
                notify = ""
            elif t.startswith("shazam"):
                _handle_shazam(_normalise(prompt))
                notify = ""
            else:
                # Fall through to deterministic matcher on the original words.
                if try_task_intent(prompt):
                    notify = ""
        elif act_type == "computer" and target:
            # LLM-routed computer-use action (see/click/scroll/keys/launch).
            notify = _computer_do(target, prompt)
        elif act_type == "dispatch" and target:
            err = validate_dispatch(target)
            if err:
                addressed = _with_address(f"Bad dispatch: {err}", force="Sir")
                _touch_interaction()
                _popup(_NAME, addressed, timeout_ms=3000)
                _speak(addressed)
                notify = ""
            else:
                result = subprocess.run(["hyprctl", "dispatch", target], capture_output=True, text=True, timeout=5)
                out = (result.stdout or "") + (result.stderr or "")
                if result.returncode != 0 or out.strip().lower().startswith("error:") or "not found" in out.lower():
                    msg = out.strip()[:200] or f"exit {result.returncode}"
                    addressed = _with_address(msg, force="Sir")
                    _touch_interaction()
                    _popup(f"{_NAME} Error", addressed, timeout_ms=3000)
                    _speak(addressed)
                    notify = ""
                # success is silent except notify below

        if notify:
            _confirm(notify)

except urllib.error.URLError as e:
    subprocess.run(["notify-send", "-t", "3000", f"{_NAME} Error", f"Ollama not running: {e.reason}"], check=False)
except Exception as e:
    subprocess.run(["notify-send", "-t", "3000", f"{_NAME} Error", str(e)[:300]], check=False)
