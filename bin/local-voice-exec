#!/usr/bin/env python3
"""Offline voice router: text -> Hyprland 0.56+ Lua dispatch or app launch via Ollama qwen2.5:3b."""
import sys
import json
import os
import shutil
import time
import urllib.request
import urllib.error
import subprocess
import shlex
import re
from pathlib import Path
from datetime import datetime, date, timedelta

if len(sys.argv) < 2:
    sys.exit(0)

prompt = sys.argv[1].strip()
if not prompt:
    sys.exit(0)

# Runtime scratch in the private per-user tmpfs (dir 0700, files 0600 from the
# callers' umask), cleared at logout. Recordings, Shazam samples and debug logs
# must never sit in a shared /tmp.
RUN_DIR = Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp") / "voice-assistant"
try:
    RUN_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    RUN_DIR.chmod(0o700)
except OSError:
    pass

CONFIG_DIR = Path.home() / ".config/voice-assistant"
CONFIG_EXAMPLES = Path(__file__).resolve().parent.parent / "config"

# --- rehearsal: route for real, touch nothing ---------------------------------
# VOICE_REHEARSAL=1 makes the router decide exactly as it normally would while
# nothing is executed: no process is spawned, no URL is fetched, no audio is
# synthesized, hypruse is never imported. Used by --selftest and benchmarks.
REHEARSAL = os.environ.get("VOICE_REHEARSAL") == "1"


class _FakeProc:
    """Stand-in for a Popen in rehearsal mode."""

    def __init__(self, argv):
        self.argv = argv
        self.pid = 0
        self.returncode = 0
        self.stdin = _FakePipe()
        self.stdout = _FakePipe()
        self.stderr = _FakePipe()

    def wait(self, *a, **k):
        return 0

    def poll(self):
        return 0

    def communicate(self, *a, **k):
        return ("", "")

    def kill(self):
        pass

    def __enter__(self):
        return self

    def __exit__(self, *a):
        return False


class _FakePipe:
    def write(self, *a):
        return 0

    def flush(self):
        pass

    def close(self):
        pass

    def read(self, *a):
        return ""


def _install_rehearsal_stubs() -> None:
    def fake_run(argv, *a, **k):
        return subprocess.CompletedProcess(argv, 0, "", "")

    def fake_popen(argv, *a, **k):
        return _FakeProc(argv)

    def fake_urlopen(*a, **k):
        raise urllib.error.URLError("rehearsal")

    subprocess.run = fake_run
    subprocess.Popen = fake_popen
    urllib.request.urlopen = fake_urlopen


if REHEARSAL:
    _install_rehearsal_stubs()


def init_config() -> int:
    """Write any missing config file from the shipped example, mode 600.

    Idempotent and non-destructive: an existing file is never touched, so
    running install.sh (or this) after an update cannot clobber your links,
    persona or API key.
    """
    wrote, kept = [], []
    for name in ("persona.conf", "calendar.conf", "weather.conf", "translate.conf", "cloud.conf", "voice.conf"):
        dst = CONFIG_DIR / name
        if dst.exists():
            kept.append(name)
            continue
        example = CONFIG_EXAMPLES / (name + ".example")
        if not example.is_file():
            continue
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(example, dst)
        dst.chmod(0o600)
        wrote.append(name)
    print("wrote: " + (", ".join(wrote) or "nothing"))
    if kept:
        print("kept:  " + ", ".join(kept))
    return 0


if prompt == "--init-config":
    sys.exit(init_config())


