#!/usr/bin/env python3
"""Ruby bar state helper (no floating avatar overlay).

Writes listening/thinking/speaking/stopped state to
$XDG_RUNTIME_DIR/voice-assistant/ruby_state for the top-bar indicator.
Avatar is shown only in the Ruby Engine app.

Usage:
  ruby-visual listening|thinking|speaking|hide|stopped
  ruby-visual --daemon   (legacy no-op; kept for compatibility)
"""

import os
import sys
from pathlib import Path

RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp") / "voice-assistant"
STATE_FILE = RUNTIME / "ruby_state"


def main() -> int:
    if len(sys.argv) < 2:
        return 0
    cmd = sys.argv[1].strip().lower()
    if cmd == "--daemon":
        # Legacy: overlay daemon removed (avatar is only in Ruby Engine app).
        return 0
    if cmd == "hide":
        cmd = "stopped"
    if cmd not in ("listening", "thinking", "speaking", "stopped"):
        return 0
    try:
        RUNTIME.mkdir(parents=True, exist_ok=True)
        STATE_FILE.write_text(cmd)
    except OSError:
        pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
