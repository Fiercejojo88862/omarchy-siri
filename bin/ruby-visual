#!/usr/bin/env python3
"""Ruby bar state helper (no floating avatar overlay).

Writes shared state machine state to
$XDG_RUNTIME_DIR/voice-assistant/ruby_state for the top-bar indicator.
States: idle, wake, listening, thinking, speaking, barging.

Usage:
  ruby-visual idle|wake|listening|thinking|speaking|barging|hide|stopped
  ruby-visual --daemon   (legacy no-op; kept for compatibility)
"""

import os
import sys
from pathlib import Path

RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp") / "voice-assistant"
STATE_FILE = RUNTIME / "ruby_state"


def main() -> int:
    if len(sys.argv) < 2:
        return 0
    cmd = sys.argv[1].strip().lower()
    if cmd == "--daemon":
        # Legacy: overlay daemon removed (avatar is only in Ruby Engine app).
        return 0
    try:
        RUNTIME.mkdir(parents=True, exist_ok=True)
        if cmd == "hide-speaking":
            # Don't clobber a newer state from a delayed speech hide.
            try:
                current = STATE_FILE.read_text().strip()
            except OSError:
                current = ""
            if current in ("speaking", "barging"):
                STATE_FILE.write_text("idle")
            return 0
        if cmd == "hide":
            cmd = "idle"
        if cmd == "stopped":
            cmd = "idle"
        if cmd not in ("idle", "wake", "listening", "thinking", "speaking", "barging"):
            return 0
        STATE_FILE.write_text(cmd)
    except OSError:
        pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
