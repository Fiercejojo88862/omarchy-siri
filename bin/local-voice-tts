#!/usr/bin/env bash
# local-voice-tts — Siri voice: Piper en_GB-southern_english_female-low.
# Stock British female voice pitch-matched to your recording (median F0 and
# range overlap beat jenny/cori/alba on identical text). Single engine:
# offline, sub-second, no warm-up, no background jobs.
set -euo pipefail
TEXT="${*:-}"
[[ -z "$TEXT" ]] && exit 0
TEXT="$(echo "$TEXT" | cut -c1-280)"

VOICE_MODEL="$HOME/.local/share/piper/en_GB-southern_english_female-low.onnx"
# Delivery: speedy + bright + lively. Tune these three to taste.
RATE=0.85    # piper length-scale: lower = faster (1.0 is model default)
ENERGY=0.8   # piper noise-scale: higher = more expressive (default 0.667)
LIFT=1.07    # rubberband pitch lift: higher = brighter, tempo untouched
# Scratch audio in the private runtime dir (0600, gone at logout), not /tmp.
umask 077
RUN="${XDG_RUNTIME_DIR:-/tmp}/voice-assistant"
mkdir -p "$RUN"
chmod 700 "$RUN"
RAW_WAV="$RUN/tts_raw.wav"
HIRES="$RUN/tts_hires.wav"

command -v piper >/dev/null 2>&1 || { notify-send -t 2500 "Voice" "piper not installed" 2>/dev/null || true; exit 1; }
[[ -f "$VOICE_MODEL" ]] || { notify-send -t 2500 "Voice" "southern voice missing (re-run install.sh)" 2>/dev/null || true; exit 1; }

# Master to 48kHz 24-bit: pitch lift + resample + gentle warmth + loudness.
if command -v ffmpeg >/dev/null 2>&1; then
    if echo "$TEXT" | piper --model "$VOICE_MODEL" --length-scale "$RATE" --noise-scale "$ENERGY" --output_file "$RAW_WAV" >/dev/null 2>&1; then
        ffmpeg -v error -y -i "$RAW_WAV" -af \
"rubberband=pitch=$LIFT,aresample=48000:resampler=soxr:precision=28:cheby=1,highpass=f=70,equalizer=f=150:width_type=o:width=1:gain=1.5,loudnorm=I=-16:TP=-1.5:LRA=7" \
-ar 48000 -ac 2 -c:a pcm_s24le "$HIRES" 2>/dev/null && RAW_WAV="$HIRES"
    fi
else
    echo "$TEXT" | piper --model "$VOICE_MODEL" --length-scale "$RATE" --noise-scale "$ENERGY" --output_file "$RAW_WAV" >/dev/null 2>&1 || exit 1
fi

# Detached playback: a player inheriting a dispatch pipe keeps the caller
# waiting and risks SIGTTIN — detached fds play and vanish.
if command -v pw-play >/dev/null 2>&1; then
    pw-play "$RAW_WAV" </dev/null >/dev/null 2>&1 &
    disown 2>/dev/null || true
elif command -v paplay >/dev/null 2>&1; then
    paplay "$RAW_WAV" </dev/null >/dev/null 2>&1 &
    disown 2>/dev/null || true
fi
exit 0
