#!/usr/bin/env bash
# local-voice-tts — Siri voice: Piper en_GB-southern_english_female-low.
# Stock British female voice pitch-matched to your recording (median F0 and
# range overlap beat jenny/cori/alba on identical text). Single engine:
# offline, sub-second, no warm-up, no background jobs.
set -euo pipefail
TEXT="${*:-}"
[[ -z "$TEXT" ]] && exit 0
TEXT="$(echo "$TEXT" | cut -c1-280)"

VOICE_CONF="$HOME/.config/voice-assistant/voice.conf"
VOICE_MODEL="$HOME/.local/share/piper/en_GB-southern_english_female-low.onnx"
# Delivery: clear and measured. Tune these three to taste.
# voice.conf provides defaults; VOICE_* env vars override.
RATE="1.0"    # piper length-scale: lower = faster (1.0 is model default)
ENERGY="0.8"  # piper noise-scale: higher = more expressive (default 0.667)
LIFT="1.05"   # rubberband pitch lift: higher = brighter, tempo untouched
SPEAK_DELAY="0.15"
if [[ -f "$VOICE_CONF" ]]; then
    while IFS='=' read -r k v; do
        k="${k%%#*}"; k="${k//[[:space:]]/}"
        [[ -z "$k" || "$k" == \#* ]] && continue
        v="${v%%#*}"; v="${v#"${v%%[![:space:]]*}"}"; v="${v%"${v##*[![:space:]]}"}"
        case "$k" in
            VOICE_MODEL|MODEL) VOICE_MODEL="${v/#\~/$HOME}" ;;
            RATE|VOICE_RATE) RATE="$v" ;;
            ENERGY|VOICE_ENERGY|NOISE) ENERGY="$v" ;;
            LIFT|VOICE_LIFT|PITCH) LIFT="$v" ;;
            SPEAK_DELAY|VOICE_SPEAK_DELAY) SPEAK_DELAY="$v" ;;
        esac
    done < "$VOICE_CONF"
fi
RATE="${VOICE_RATE:-$RATE}"
ENERGY="${VOICE_ENERGY:-$ENERGY}"
LIFT="${VOICE_LIFT:-$LIFT}"
SPEAK_DELAY="${VOICE_SPEAK_DELAY:-$SPEAK_DELAY}"

# Scratch audio in the private runtime dir (0600, gone at logout), not /tmp.
umask 077
RUN="${XDG_RUNTIME_DIR:-/tmp}/voice-assistant"
mkdir -p "$RUN"
chmod 700 "$RUN"
RAW_WAV="$RUN/tts_raw.wav"
HIRES="$RUN/tts_hires.wav"

command -v piper >/dev/null 2>&1 || { notify-send -t 2500 "Voice" "piper not installed" 2>/dev/null || true; exit 1; }
[[ -f "$VOICE_MODEL" ]] || { notify-send -t 2500 "Voice" "southern voice missing (re-run install.sh)" 2>/dev/null || true; exit 1; }

# Master to 48kHz 24-bit: pitch lift + resample + gentle warmth + loudness.
if command -v ffmpeg >/dev/null 2>&1; then
    if echo "$TEXT" | piper --model "$VOICE_MODEL" --length-scale "$RATE" --noise-scale "$ENERGY" --output_file "$RAW_WAV" >/dev/null 2>&1; then
        ffmpeg -v error -y -i "$RAW_WAV" -af \
"rubberband=pitch=$LIFT,aresample=48000:resampler=soxr:precision=28:cheby=1,highpass=f=70,equalizer=f=150:width_type=o:width=1:gain=1.5,loudnorm=I=-16:TP=-1.5:LRA=7" \
-ar 48000 -ac 2 -c:a pcm_s24le "$HIRES" 2>/dev/null && RAW_WAV="$HIRES"
    fi
else
    echo "$TEXT" | piper --model "$VOICE_MODEL" --length-scale "$RATE" --noise-scale "$ENERGY" --output_file "$RAW_WAV" >/dev/null 2>&1 || exit 1
fi

# Stop any previous Ruby TTS playback so responses don't overlap/talk over each
# other (multiple quick commands could otherwise queue audio on top of itself).
PLAY_PIDFILE="$RUN/tts_play.pid"
if [[ -f "$PLAY_PIDFILE" ]]; then
    oldpid=$(cat "$PLAY_PIDFILE" 2>/dev/null || true)
    [[ -n "${oldpid:-}" ]] && kill "$oldpid" 2>/dev/null || true
    rm -f "$PLAY_PIDFILE"
fi

# Small pre-playback delay so speech doesn't start on top of notification
# sounds or feel clipped at the beginning. Configurable via voice.conf/env.
speak_delay="$SPEAK_DELAY"

# Detached playback: a player inheriting a dispatch pipe keeps the caller
# waiting and risks SIGTTIN — detached fds play and vanish.
if command -v pw-play >/dev/null 2>&1; then
    ( sleep "$speak_delay" 2>/dev/null || true; exec pw-play "$RAW_WAV" ) </dev/null >/dev/null 2>&1 &
    echo $! > "$PLAY_PIDFILE"
    disown 2>/dev/null || true
elif command -v paplay >/dev/null 2>&1; then
    ( sleep "$speak_delay" 2>/dev/null || true; exec paplay "$RAW_WAV" ) </dev/null >/dev/null 2>&1 &
    echo $! > "$PLAY_PIDFILE"
    disown 2>/dev/null || true
fi

# Optional barge-in monitor (interrupts playback if user speaks).
if [[ -f "$PLAY_PIDFILE" ]]; then
    BARGE_MON=""
    for c in "$HOME/.local/bin/ruby-bargein-monitor" "$HOME/omarchy-siri/bin/ruby-bargein-monitor"; do
        [[ -x "$c" ]] && BARGE_MON="$c" && break
    done
    if [[ -n "$BARGE_MON" ]]; then
        "$BARGE_MON" </dev/null >/dev/null 2>&1 &
        disown 2>/dev/null || true
    fi
fi
exit 0
