#!/usr/bin/env bash
# local-voice-say — speak in Siri's voice (Piper southern English female).
# Usage: local-voice-say "Opening dolphin!"
# Thin wrapper over local-voice-tts; synthesis is sub-second so no cache,
# no background generation, no fallback chain.
set -euo pipefail
TEXT="${*:-}"
[[ -z "$TEXT" ]] && exit 0
exec "$HOME/.local/bin/local-voice-tts" "$TEXT"
